(ns raylib-examples.strings-management
  "raylib [text] example - strings management, ported to jank.

  An interactive text-particle physics toy that showcases raylib's C
  string API. A phrase starts as one draggable, bouncing text box;
  grab/throw it with the left mouse, slice it in half with the right
  mouse, shatter it into single chars with Shift+right, glue two
  particles by dragging with Left-Ctrl, or (when only one remains) slice
  it on a typed char. Keys 1-6 reset the phrase through
  TextToUpper/Lower/Pascal/Snake/Camel. Middle mouse shakes them all.
  Based on raylib/examples/text/text_strings_management.c (3/4).

  jank-native notes:
  - raylib's TextX API is called directly, since demonstrating it is the
    point of the example: TextToUpper/Lower/Pascal/Snake/Camel,
    TextSubtext, TextSplit, TextLength and MeasureText all take a jank
    string (which converts to const char*) and their const char* returns
    fold back with str. TextSplit's const char** plus int* out-param
    reads back with (cpp/& n) and cpp/aget.
  - TextFormat is the exception: it is variadic, and jank has no va_list
    handling. Its two uses here are a one-char substring and a
    concatenation, so they are subs and str.
  - A particle is a plain jank map. The C's struct is a char[] plus a
    Rectangle, two Vector2s, floats, a Color and a bool - all of which
    are strings or numbers, so nothing needs boxing and the pool is an
    ordinary jank vector threaded through recur. The grabbed pointer
    becomes an index.
  - padding / borderWidth / friction / elasticity are per-particle
    fields in the C that it never varies, so they are constants here."
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)

(def ^:private MAX-PARTICLES 100)
(def ^:private FONT-SIZE 30)
(def ^:private PADDING 5.0)
(def ^:private BORDER 5.0)
(def ^:private FRICTION 0.99)
(def ^:private ELASTICITY 0.9)
(def ^:private PHRASE "raylib => fun videogames programming!")

(defn- random-color []
  [(int (cpp/GetRandomValue 0 255))
   (int (cpp/GetRandomValue 0 255))
   (int (cpp/GetRandomValue 0 255))])

(defn- make-particle
  "The C's jank_tsm_create. MeasureText sizes the box, so the default
  font must already be loaded (i.e. after InitWindow)."
  [text x y color]
  {:text text
   :x x :y y
   :w (+ (+ 0.0 (cpp/MeasureText text (cpp/int FONT-SIZE))) (* PADDING 2.0))
   :h (+ (+ 0.0 FONT-SIZE) (* PADDING 2.0))
   :vx (+ 0.0 (cpp/GetRandomValue -200 200))
   :vy (+ 0.0 (cpp/GetRandomValue -200 200))
   :px 0.0 :py 0.0
   :color color
   :grabbed? false})

(defn- prepare-first [text]
  [(make-particle text (/ WIDTH 2.0) (/ HEIGHT 2.0) [245 245 245])])

(defn- text-length [s] (int (cpp/TextLength s)))

;; Characters 32..126 in code order. jank has no char literals, so a code
;; indexes into this via subs to yield a one-char string (the ascii-rendering
;; and input-box pattern).
(def ^:private ASCII " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~")

(defn- char-str [code] (subs ASCII (- code 32) (- code 31)))

(defn- slice-parts
  "The C's jank_tsm_slice: cut the particle's text into sliceLength-wide
  chunks, each becoming its own particle. Returns the new particles, or
  nil when the C's guards decline."
  [p slice-len total]
  (let [text (:text p)
        length (text-length text)]
    (when (and (> length 1) (< (+ total length) MAX-PARTICLES))
      (loop [i 0 acc []]
        (if (< i length)
          (let [chunk (if (= slice-len 1)
                        (subs text i (inc i))
                        (str (cpp/TextSubtext text (cpp/int i) (cpp/int slice-len))))]
            (recur (+ i slice-len)
                   (conj acc (make-particle chunk
                                            (+ (:x p) (/ (* i (:w p)) length))
                                            (:y p)
                                            (random-color)))))
          acc)))))

(defn- slice-by-char-parts
  "The C's jank_tsm_slice_by_char: split on a typed character, emitting
  one particle per occurrence of the character and one per token."
  [p ch]
  (let [text (:text p)
        n (cpp/int 0)
        toks (cpp/TextSplit text (cpp/cast cpp/char (cpp/int ch)) (cpp/& n))
        token-count (int (+ 0.0 n))]
    (when (> token-count 1)
      (let [length (text-length text)
            seps (loop [i 0 acc []]
                   (if (< i length)
                     (recur (inc i)
                            (if (= (subs text i (inc i)) (char-str ch))
                              (conj acc (make-particle (subs text i (inc i))
                                                       (:x p) (:y p) (random-color)))
                              acc))
                     acc))]
        (loop [i 0 acc seps]
          (if (< i token-count)
            (let [tok (str (cpp/aget toks (cpp/int i)))
                  tl (text-length tok)]
              (recur (inc i)
                     (conj acc (make-particle tok
                                              (+ (:x p) (/ (* i (:w p)) (max 1 tl)))
                                              (:y p)
                                              (random-color)))))
            acc))))))

(defn- drop-at [v i]
  (vec (concat (subvec v 0 i) (subvec v (inc i)))))

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [text] example - strings management (jank)")

  (cpp/SetTargetFPS 60)

  ;; Thread [particles grabbed-index press-offset-x press-offset-y].
  (loop [ps (prepare-first PHRASE)
         grabbed nil
         off-x 0.0
         off-y 0.0]
    (when (cpp/! (cpp/WindowShouldClose))
      (let [delta (+ 0.0 (cpp/GetFrameTime))
            mouse (cpp/GetMousePosition)
            mx (+ 0.0 (.-x mouse))
            my (+ 0.0 (.-y mouse))
            hit-idx (fn [coll]
                      ;; topmost first, like the C's reverse scan
                      (loop [i (dec (count coll))]
                        (when (>= i 0)
                          (let [q (nth coll i)]
                            (if (cpp/CheckCollisionPointRec
                                 (cpp/Vector2 (cpp/float mx) (cpp/float my))
                                 (cpp/Rectangle (cpp/float (:x q)) (cpp/float (:y q))
                                                (cpp/float (:w q)) (cpp/float (:h q))))
                              i
                              (recur (dec i)))))))

            ;; grab
            [ps grabbed off-x off-y]
            (if (cpp/IsMouseButtonPressed cpp/MOUSE_BUTTON_LEFT)
              (if-let [i (hit-idx ps)]
                [(assoc ps i (assoc (nth ps i) :grabbed? true)) i
                 (- mx (:x (nth ps i))) (- my (:y (nth ps i)))]
                [ps grabbed off-x off-y])
              [ps grabbed off-x off-y])

            ;; release
            [ps grabbed]
            (if (and (cpp/IsMouseButtonReleased cpp/MOUSE_BUTTON_LEFT) grabbed)
              [(assoc ps grabbed (assoc (nth ps grabbed) :grabbed? false)) nil]
              [ps grabbed])

            ;; slice / shatter
            ps (if (cpp/IsMouseButtonPressed cpp/MOUSE_BUTTON_RIGHT)
                 (if-let [i (hit-idx ps)]
                   (let [p (nth ps i)
                         len (if (cpp/IsKeyDown cpp/KEY_LEFT_SHIFT)
                               1
                               (max 1 (int (quot (text-length (:text p)) 2))))]
                     (if-let [new-ps (slice-parts p len (count ps))]
                       (drop-at (vec (concat ps new-ps)) i)
                       ps))
                   ps)
                 ps)

            ;; shake all
            ps (if (cpp/IsMouseButtonPressed cpp/MOUSE_BUTTON_MIDDLE)
                 (mapv (fn [p]
                         (if (:grabbed? p)
                           p
                           (assoc p :vx (+ 0.0 (cpp/GetRandomValue -2000 2000))
                                    :vy (+ 0.0 (cpp/GetRandomValue -2000 2000)))))
                       ps)
                 ps)

            ;; 1-6 reset through the TextTo* family
            [ps grabbed]
            (cond
              (cpp/IsKeyPressed cpp/KEY_ONE)   [(prepare-first PHRASE) nil]
              (cpp/IsKeyPressed cpp/KEY_TWO)   [(prepare-first (str (cpp/TextToUpper PHRASE))) nil]
              (cpp/IsKeyPressed cpp/KEY_THREE) [(prepare-first (str (cpp/TextToLower PHRASE))) nil]
              (cpp/IsKeyPressed cpp/KEY_FOUR)
              [(prepare-first (str (cpp/TextToPascal "raylib_fun_videogames_programming"))) nil]
              (cpp/IsKeyPressed cpp/KEY_FIVE)
              [(prepare-first (str (cpp/TextToSnake "RaylibFunVideogamesProgramming"))) nil]
              (cpp/IsKeyPressed cpp/KEY_SIX)
              [(prepare-first (str (cpp/TextToCamel "raylib_fun_videogames_programming"))) nil]
              :else [ps grabbed])

            ;; slice on a typed char, only while one particle remains
            ch (int (cpp/GetCharPressed))
            [ps grabbed]
            (if (and (>= ch 65) (<= ch 122) (= (count ps) 1))
              (if-let [new-ps (slice-by-char-parts (nth ps 0) ch)]
                [(vec new-ps) nil]
                [ps grabbed])
              [ps grabbed])

            ;; physics
            ps (mapv (fn [p]
                       (if (:grabbed? p)
                         (let [nx (- mx off-x)
                               ny (- my off-y)]
                           (assoc p :x nx :y ny
                                    :vx (/ (- nx (:px p)) delta)
                                    :vy (/ (- ny (:py p)) delta)
                                    :px nx :py ny))
                         (let [nx (+ (:x p) (* (:vx p) delta))
                               ny (+ (:y p) (* (:vy p) delta))
                               [nx vx] (cond (>= (+ nx (:w p)) WIDTH)
                                             [(- WIDTH (:w p)) (* (- (:vx p)) ELASTICITY)]
                                             (<= nx 0.0) [0.0 (* (- (:vx p)) ELASTICITY)]
                                             :else [nx (:vx p)])
                               [ny vy] (cond (>= (+ ny (:h p)) HEIGHT)
                                             [(- HEIGHT (:h p)) (* (- (:vy p)) ELASTICITY)]
                                             (<= ny 0.0) [0.0 (* (- (:vy p)) ELASTICITY)]
                                             :else [ny (:vy p)])]
                           (assoc p :x nx :y ny
                                    :vx (* vx FRICTION) :vy (* vy FRICTION)))))
                     ps)

            ;; glue on drag + Left-Ctrl
            [ps grabbed]
            (if (and grabbed (cpp/IsKeyDown cpp/KEY_LEFT_CONTROL) (> (count ps) 1))
              (let [g (nth ps grabbed)
                    other (loop [j 0]
                            (when (< j (count ps))
                              (if (and (not= j grabbed)
                                       (cpp/CheckCollisionRecs
                                        (cpp/Rectangle (cpp/float (:x g)) (cpp/float (:y g))
                                                       (cpp/float (:w g)) (cpp/float (:h g)))
                                        (let [o (nth ps j)]
                                          (cpp/Rectangle (cpp/float (:x o)) (cpp/float (:y o))
                                                         (cpp/float (:w o)) (cpp/float (:h o))))))
                                j
                                (recur (inc j)))))]
                (if other
                  (let [t (nth ps other)
                        glued (assoc (make-particle (str (:text g) (:text t))
                                                    (:x g) (:y g) [245 245 245])
                                     :grabbed? true)
                        ;; drop the higher index first so the lower stays valid
                        [hi lo] (if (> grabbed other) [grabbed other] [other grabbed])
                        kept (drop-at (drop-at (vec (concat ps [glued])) hi) lo)]
                    [kept (dec (count kept))])
                  [ps grabbed]))
              [ps grabbed])]

        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/RAYWHITE)

        (loop [i 0]
          (when (< i (count ps))
            (let [p (nth ps i)
                  [r g b] (:color p)]
              (cpp/DrawRectangleRec
               (cpp/Rectangle (cpp/float (- (:x p) BORDER)) (cpp/float (- (:y p) BORDER))
                              (cpp/float (+ (:w p) (* BORDER 2.0)))
                              (cpp/float (+ (:h p) (* BORDER 2.0))))
               cpp/BLACK)
              (cpp/DrawRectangleRec
               (cpp/Rectangle (cpp/float (:x p)) (cpp/float (:y p))
                              (cpp/float (:w p)) (cpp/float (:h p)))
               (cpp/Color (cpp/cast cpp/uint8_t r) (cpp/cast cpp/uint8_t g)
                          (cpp/cast cpp/uint8_t b) (cpp/cast cpp/uint8_t 255)))
              (cpp/DrawText (:text p)
                            (int (+ (:x p) PADDING)) (int (+ (:y p) PADDING))
                            FONT-SIZE cpp/BLACK))
            (recur (inc i))))

        (cpp/DrawText "grab a text particle by pressing with the mouse and throw it by releasing" 10 10 10 cpp/DARKGRAY)
        (cpp/DrawText "slice a text particle by pressing it with the mouse right button" 10 30 10 cpp/DARKGRAY)
        (cpp/DrawText "shatter a text particle keeping left shift pressed and pressing it with the mouse right button" 10 50 10 cpp/DARKGRAY)
        (cpp/DrawText "glue text particles by grabbing than and keeping left control pressed" 10 70 10 cpp/DARKGRAY)
        (cpp/DrawText "1 to 6 to reset" 10 90 10 cpp/DARKGRAY)
        (cpp/DrawText "when you have only one text particle, you can slice it by pressing a char" 10 110 10 cpp/DARKGRAY)
        (cpp/DrawText (str "TEXT PARTICLE COUNT: " (count ps)) 10 (- HEIGHT 30) 20 cpp/BLACK)

        (cpp/EndDrawing)
        (recur ps grabbed off-x off-y))))

  (cpp/CloseWindow))
