(ns raylib-examples.camera-3d-fps
  "raylib [core] example - 3d camera fps, ported to jank.

  A physics-driven first-person controller: WASD to move, Space to jump,
  Left-Ctrl to crouch, mouse (or arrow keys) to look. The body carries
  velocity with gravity, ground friction / air drag, acceleration
  clamping (the classic strafe-accel trick) and a head-bob / lean that
  eases the camera. The level is a checkerboard floor, four towers and a
  red sun.
  Based on raylib/examples/core/core_3d_camera_fps.c (3/4 complexity).

  jank-native notes:
  - The whole controller is native math: a `Body` struct plus a fistful
    of Vector2/Vector3 globals threaded through UpdateBody and
    UpdateCameraFPS via pointers, every step a raymath call
    (Vector3RotateByAxisAngle / Vector3Lerp / Clamp / Lerp / ...) whose
    Vector3 result a jank fn may neither return nor carry through
    loop/recur. So the body physics, the FPS camera update, the level
    draw and the velocity-readout HUD live verbatim in one cpp/raw shim
    over static state; jank owns the window lifecycle, the frame loop
    and the frame boundaries, calling update / draw-3d / draw-hud each
    frame. The diagonal-input normalization (the C's NORMALIZE_INPUT,
    which is #defined so its #if is active) is kept inline."
  (:include "raylib.h" "raymath.h"))

;; The FPS body physics + camera + level, near-verbatim from the C.
(cpp/raw "
#define JANK_FPS_GRAVITY       32.0f
#define JANK_FPS_MAX_SPEED     20.0f
#define JANK_FPS_CROUCH_SPEED   5.0f
#define JANK_FPS_JUMP_FORCE    12.0f
#define JANK_FPS_MAX_ACCEL    150.0f
#define JANK_FPS_FRICTION       0.86f
#define JANK_FPS_AIR_DRAG       0.98f
#define JANK_FPS_CONTROL       15.0f
#define JANK_FPS_CROUCH_HEIGHT  0.0f
#define JANK_FPS_STAND_HEIGHT   1.0f
#define JANK_FPS_BOTTOM_HEIGHT  0.5f

typedef struct {
  Vector3 position;
  Vector3 velocity;
  Vector3 dir;
  bool isGrounded;
} JankFpsBody;

static Vector2 jank_fps_sensitivity = { 0.001f, 0.001f };
static JankFpsBody jank_fps_player = { 0 };
static Vector2 jank_fps_lookRotation = { 0 };
static float jank_fps_headTimer = 0.0f;
static float jank_fps_walkLerp = 0.0f;
static float jank_fps_headLerp = JANK_FPS_STAND_HEIGHT;
static Vector2 jank_fps_lean = { 0 };
static Camera jank_fps_camera = { 0 };

/* Update body considering current world state. */
static void jank_fps_update_body(JankFpsBody *body, float rot, char side, char forward, bool jumpPressed, bool crouchHold) {
  Vector2 input = (Vector2){ (float)side, (float)-forward };

  /* NORMALIZE_INPUT is #defined, so this diagonal slow-down is active */
  if ((side != 0) && (forward != 0)) input = Vector2Normalize(input);

  float delta = GetFrameTime();

  if (!body->isGrounded) body->velocity.y -= JANK_FPS_GRAVITY*delta;

  if (body->isGrounded && jumpPressed) {
    body->velocity.y = JANK_FPS_JUMP_FORCE;
    body->isGrounded = false;
  }

  Vector3 front = (Vector3){ sinf(rot), 0.f, cosf(rot) };
  Vector3 right = (Vector3){ cosf(-rot), 0.f, sinf(-rot) };

  Vector3 desiredDir = (Vector3){ input.x*right.x + input.y*front.x, 0.0f, input.x*right.z + input.y*front.z, };
  body->dir = Vector3Lerp(body->dir, desiredDir, JANK_FPS_CONTROL*delta);

  float decel = (body->isGrounded ? JANK_FPS_FRICTION : JANK_FPS_AIR_DRAG);
  Vector3 hvel = (Vector3){ body->velocity.x*decel, 0.0f, body->velocity.z*decel };

  float hvelLength = Vector3Length(hvel);
  if (hvelLength < (JANK_FPS_MAX_SPEED*0.01f)) hvel = (Vector3){ 0 };

  /* This is what creates strafing */
  float speed = Vector3DotProduct(hvel, body->dir);

  float maxSpeed = (crouchHold? JANK_FPS_CROUCH_SPEED : JANK_FPS_MAX_SPEED);
  float accel = Clamp(maxSpeed - speed, 0.f, JANK_FPS_MAX_ACCEL*delta);
  hvel.x += body->dir.x*accel;
  hvel.z += body->dir.z*accel;

  body->velocity.x = hvel.x;
  body->velocity.z = hvel.z;

  body->position.x += body->velocity.x*delta;
  body->position.y += body->velocity.y*delta;
  body->position.z += body->velocity.z*delta;

  /* Collision against the floor */
  if (body->position.y <= 0.0f) {
    body->position.y = 0.0f;
    body->velocity.y = 0.0f;
    body->isGrounded = true;
  }
}

/* Update camera for FPS behaviour (look clamp, head bob, lean). */
static void jank_fps_update_camera(Camera *camera) {
  const Vector3 up = (Vector3){ 0.0f, 1.0f, 0.0f };
  const Vector3 targetOffset = (Vector3){ 0.0f, 0.0f, -1.0f };

  Vector3 yaw = Vector3RotateByAxisAngle(targetOffset, up, jank_fps_lookRotation.x);

  float maxAngleUp = Vector3Angle(up, yaw);
  maxAngleUp -= 0.001f;
  if ( -(jank_fps_lookRotation.y) > maxAngleUp) { jank_fps_lookRotation.y = -maxAngleUp; }

  float maxAngleDown = Vector3Angle(Vector3Negate(up), yaw);
  maxAngleDown *= -1.0f;
  maxAngleDown += 0.001f;
  if ( -(jank_fps_lookRotation.y) < maxAngleDown) { jank_fps_lookRotation.y = -maxAngleDown; }

  Vector3 right = Vector3Normalize(Vector3CrossProduct(yaw, up));

  float pitchAngle = -jank_fps_lookRotation.y - jank_fps_lean.y;
  pitchAngle = Clamp(pitchAngle, -PI/2 + 0.0001f, PI/2 - 0.0001f);
  Vector3 pitch = Vector3RotateByAxisAngle(yaw, right, pitchAngle);

  float headSin = sinf(jank_fps_headTimer*PI);
  float headCos = cosf(jank_fps_headTimer*PI);
  const float stepRotation = 0.01f;
  camera->up = Vector3RotateByAxisAngle(up, pitch, headSin*stepRotation + jank_fps_lean.x);

  const float bobSide = 0.1f;
  const float bobUp = 0.15f;
  Vector3 bobbing = Vector3Scale(right, headSin*bobSide);
  bobbing.y = fabsf(headCos*bobUp);

  camera->position = Vector3Add(camera->position, Vector3Scale(bobbing, jank_fps_walkLerp));
  camera->target = Vector3Add(camera->position, pitch);
}

/* Draw the checkerboard floor, four towers and the red sun. */
static void jank_fps_draw_level(void) {
  const int floorExtent = 25;
  const float tileSize = 5.0f;
  const Color tileColor1 = (Color){ 150, 200, 200, 255 };

  for (int y = -floorExtent; y < floorExtent; y++) {
    for (int x = -floorExtent; x < floorExtent; x++) {
      if ((y & 1) && (x & 1)) {
        DrawPlane((Vector3){ x*tileSize, 0.0f, y*tileSize}, (Vector2){ tileSize, tileSize }, tileColor1);
      } else if (!(y & 1) && !(x & 1)) {
        DrawPlane((Vector3){ x*tileSize, 0.0f, y*tileSize}, (Vector2){ tileSize, tileSize }, LIGHTGRAY);
      }
    }
  }

  const Vector3 towerSize = (Vector3){ 16.0f, 32.0f, 16.0f };
  const Color towerColor = (Color){ 150, 200, 200, 255 };

  Vector3 towerPos = (Vector3){ 16.0f, 16.0f, 16.0f };
  DrawCubeV(towerPos, towerSize, towerColor);
  DrawCubeWiresV(towerPos, towerSize, DARKBLUE);

  towerPos.x *= -1;
  DrawCubeV(towerPos, towerSize, towerColor);
  DrawCubeWiresV(towerPos, towerSize, DARKBLUE);

  towerPos.z *= -1;
  DrawCubeV(towerPos, towerSize, towerColor);
  DrawCubeWiresV(towerPos, towerSize, DARKBLUE);

  towerPos.x *= -1;
  DrawCubeV(towerPos, towerSize, towerColor);
  DrawCubeWiresV(towerPos, towerSize, DARKBLUE);

  DrawSphere((Vector3){ 300.0f, 300.0f, 0.0f }, 100.0f, (Color){ 255, 0, 0, 255 });
}

/* ---- jank-callable entry points ---- */

static void jank_fps_init(void) {
  jank_fps_camera = (Camera){ 0 };
  jank_fps_camera.fovy = 60.0f;
  jank_fps_camera.projection = CAMERA_PERSPECTIVE;
  jank_fps_camera.position = (Vector3){
    jank_fps_player.position.x,
    jank_fps_player.position.y + (JANK_FPS_BOTTOM_HEIGHT + jank_fps_headLerp),
    jank_fps_player.position.z,
  };
  jank_fps_update_camera(&jank_fps_camera);

  DisableCursor();
  SetTargetFPS(60);
}

static void jank_fps_update(void) {
  Vector2 mouseDelta = GetMouseDelta();
  jank_fps_lookRotation.x -= mouseDelta.x*jank_fps_sensitivity.x;
  jank_fps_lookRotation.y += mouseDelta.y*jank_fps_sensitivity.y;

  char sideway = (IsKeyDown(KEY_D) - IsKeyDown(KEY_A));
  char forward = (IsKeyDown(KEY_W) - IsKeyDown(KEY_S));
  bool crouching = IsKeyDown(KEY_LEFT_CONTROL);
  jank_fps_update_body(&jank_fps_player, jank_fps_lookRotation.x, sideway, forward, IsKeyPressed(KEY_SPACE), crouching);

  float delta = GetFrameTime();
  jank_fps_headLerp = Lerp(jank_fps_headLerp, (crouching ? JANK_FPS_CROUCH_HEIGHT : JANK_FPS_STAND_HEIGHT), 20.0f*delta);
  jank_fps_camera.position = (Vector3){
    jank_fps_player.position.x,
    jank_fps_player.position.y + (JANK_FPS_BOTTOM_HEIGHT + jank_fps_headLerp),
    jank_fps_player.position.z,
  };

  if (jank_fps_player.isGrounded && ((forward != 0) || (sideway != 0))) {
    jank_fps_headTimer += delta*3.0f;
    jank_fps_walkLerp = Lerp(jank_fps_walkLerp, 1.0f, 10.0f*delta);
    jank_fps_camera.fovy = Lerp(jank_fps_camera.fovy, 55.0f, 5.0f*delta);
  } else {
    jank_fps_walkLerp = Lerp(jank_fps_walkLerp, 0.0f, 10.0f*delta);
    jank_fps_camera.fovy = Lerp(jank_fps_camera.fovy, 60.0f, 5.0f*delta);
  }

  jank_fps_lean.x = Lerp(jank_fps_lean.x, sideway*0.02f, 10.0f*delta);
  jank_fps_lean.y = Lerp(jank_fps_lean.y, forward*0.015f, 10.0f*delta);

  jank_fps_update_camera(&jank_fps_camera);
}

static void jank_fps_draw_3d(void) {
  BeginMode3D(jank_fps_camera);
    jank_fps_draw_level();
  EndMode3D();
}

static void jank_fps_draw_hud(void) {
  DrawRectangle(5, 5, 330, 75, Fade(SKYBLUE, 0.5f));
  DrawRectangleLines(5, 5, 330, 75, BLUE);

  DrawText(\"Camera controls:\", 15, 15, 10, BLACK);
  DrawText(\"- Move keys: W, A, S, D, Space, Left-Ctrl\", 15, 30, 10, BLACK);
  DrawText(\"- Look around: arrow keys or mouse\", 15, 45, 10, BLACK);
  DrawText(TextFormat(\"- Velocity Len: (%06.3f)\", Vector2Length((Vector2){ jank_fps_player.velocity.x, jank_fps_player.velocity.z })), 15, 60, 10, BLACK);
}")

(def WIDTH 800)
(def HEIGHT 450)

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [core] example - 3d camera fps (jank)")

  (cpp/jank_fps_init)

  (loop []
    (when (cpp/! (cpp/WindowShouldClose))
      (cpp/jank_fps_update)

      (cpp/BeginDrawing)
      (cpp/ClearBackground cpp/RAYWHITE)
      (cpp/jank_fps_draw_3d)
      (cpp/jank_fps_draw_hud)
      (cpp/EndDrawing)
      (recur)))

  (cpp/CloseWindow))
