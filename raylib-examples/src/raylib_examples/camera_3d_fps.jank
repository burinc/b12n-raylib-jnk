(ns raylib-examples.camera-3d-fps
  "raylib [core] example - 3d camera fps, ported to jank.

  A physics-driven first-person controller: WASD to move, Space to jump,
  Left-Ctrl to crouch, mouse (or arrow keys) to look. The body carries
  velocity with gravity, ground friction / air drag, acceleration
  clamping (the classic strafe-accel trick) and a head-bob / lean that
  eases the camera. The level is a checkerboard floor, four towers and a
  red sun.
  Based on raylib/examples/core/core_3d_camera_fps.c (3/4 complexity).

  jank-native notes:
  - The controller state is a plain jank map of numbers, not a native
    struct. A Vector3 may not be returned from a jank fn, but its three
    floats cross freely, so decomposing the body into :px/:py/:pz and
    friends sidesteps the native-value-lifetime rule entirely rather
    than working around it with boxes.
  - The two raymath calls worth keeping are Vector3RotateByAxisAngle and
    Vector3Angle. Both are wrapped to take and return [x y z] vectors of
    numbers, constructing the native Vector3 inline and reading the
    components straight back off the result. The rest (lerp, cross,
    scale, dot, length) is a line of jank arithmetic each.
  - Only the Camera3D is boxed: BeginMode3D needs the real struct, and
    one allocation outside the frame loop beats rebuilding it per frame.
  - The diagonal-input normalization (the C's NORMALIZE_INPUT, which is
    #defined so its #if is active) is kept."
  (:require [clojure.string :as string])
  (:include "raylib.h" "raymath.h"))

(def WIDTH 800)
(def HEIGHT 450)

(def ^:private GRAVITY 32.0)
(def ^:private MAX-SPEED 20.0)
(def ^:private CROUCH-SPEED 5.0)
(def ^:private JUMP-FORCE 12.0)
(def ^:private MAX-ACCEL 150.0)
(def ^:private FRICTION 0.86)
(def ^:private AIR-DRAG 0.98)
(def ^:private CONTROL 15.0)
(def ^:private CROUCH-HEIGHT 0.0)
(def ^:private STAND-HEIGHT 1.0)
(def ^:private BOTTOM-HEIGHT 0.5)
(def ^:private SENSITIVITY 0.001)
(def ^:private PI 3.141592653589793)

;; ---- small math, in jank ----

(defn- lerp [a b t] (+ a (* t (- b a))))

(defn- clamp [v lo hi] (if (< v lo) lo (if (> v hi) hi v)))

(defn- v3-rotate-axis
  "Vector3RotateByAxisAngle, taking and returning [x y z] of numbers.
  The native Vector3 exists only as an argument and as the let-local
  holding the result, so it never has to cross a fn boundary."
  [[x y z] [ax ay az] angle]
  (let [r (cpp/Vector3RotateByAxisAngle
           (cpp/Vector3 (cpp/float x) (cpp/float y) (cpp/float z))
           (cpp/Vector3 (cpp/float ax) (cpp/float ay) (cpp/float az))
           (cpp/float angle))]
    [(+ 0.0 (.-x r)) (+ 0.0 (.-y r)) (+ 0.0 (.-z r))]))

(defn- v3-angle
  "Vector3Angle. Kept as a raymath call because it is atan2 of the cross
  length against the dot, not something worth restating."
  [[ax ay az] [bx by bz]]
  (+ 0.0 (cpp/Vector3Angle (cpp/Vector3 (cpp/float ax) (cpp/float ay) (cpp/float az))
                           (cpp/Vector3 (cpp/float bx) (cpp/float by) (cpp/float bz)))))

(defn- v3-normalize
  [[x y z]]
  (let [l (cpp/sqrt (+ (* x x) (* y y) (* z z)))]
    (if (zero? l) [0.0 0.0 0.0] [(/ x l) (/ y l) (/ z l)])))

(defn- v3-cross
  [[ax ay az] [bx by bz]]
  [(- (* ay bz) (* az by)) (- (* az bx) (* ax bz)) (- (* ax by) (* ay bx))])

;; ---- body physics ----

(defn- update-body
  "One physics step. Mirrors the C's UpdateBody: gravity, jump, the
  desired-direction lerp, friction / air drag, then the acceleration
  clamp that produces strafe-accel, then integration and the floor."
  [{:keys [px py pz vx vy vz dx dy dz grounded?] :as st} rot side forward jump? crouch? delta]
  (let [ix (+ 0.0 side)
        iy (- 0.0 forward)
        ;; NORMALIZE_INPUT is #defined in the C, so diagonals slow down
        [ix iy] (if (and (not= side 0) (not= forward 0))
                  (let [l (cpp/sqrt (+ (* ix ix) (* iy iy)))]
                    (if (zero? l) [ix iy] [(/ ix l) (/ iy l)]))
                  [ix iy])

        vy (if grounded? vy (- vy (* GRAVITY delta)))
        [vy grounded?] (if (and grounded? jump?) [JUMP-FORCE false] [vy grounded?])

        front-x (cpp/sin rot)
        front-z (cpp/cos rot)
        right-x (cpp/cos (- 0.0 rot))
        right-z (cpp/sin (- 0.0 rot))

        want-x (+ (* ix right-x) (* iy front-x))
        want-z (+ (* ix right-z) (* iy front-z))
        t (* CONTROL delta)
        dx (lerp dx want-x t)
        dy (lerp dy 0.0 t)
        dz (lerp dz want-z t)

        decel (if grounded? FRICTION AIR-DRAG)
        hx (* vx decel)
        hz (* vz decel)
        hlen (cpp/sqrt (+ (* hx hx) (* hz hz)))
        [hx hz] (if (< hlen (* MAX-SPEED 0.01)) [0.0 0.0] [hx hz])

        ;; this is what creates strafing
        speed (+ (* hx dx) (* hz dz))
        max-speed (if crouch? CROUCH-SPEED MAX-SPEED)
        accel (clamp (- max-speed speed) 0.0 (* MAX-ACCEL delta))
        vx (+ hx (* dx accel))
        vz (+ hz (* dz accel))

        px (+ px (* vx delta))
        py (+ py (* vy delta))
        pz (+ pz (* vz delta))
        floor? (<= py 0.0)]
    (assoc st
           :px px :py (if floor? 0.0 py) :pz pz
           :vx vx :vy (if floor? 0.0 vy) :vz vz
           :dx dx :dy dy :dz dz
           :grounded? (if floor? true grounded?))))

(defn- camera-vectors
  "The C's UpdateCameraFPS: clamp the look so it cannot pass straight up
  or down, then derive up / position / target with head-bob and lean.
  Returns the three camera vectors as [x y z] triples."
  [{:keys [look-x look-y head-timer walk-lerp lean-x lean-y]} [cx cy cz]]
  (let [up [0.0 1.0 0.0]
        yaw (v3-rotate-axis [0.0 0.0 -1.0] up look-x)

        max-up (- (v3-angle up yaw) 0.001)
        look-y (if (> (- 0.0 look-y) max-up) (- 0.0 max-up) look-y)
        max-down (+ (* -1.0 (v3-angle [0.0 -1.0 0.0] yaw)) 0.001)
        look-y (if (< (- 0.0 look-y) max-down) (- 0.0 max-down) look-y)

        right (v3-normalize (v3-cross yaw up))
        pitch-angle (clamp (- (- 0.0 look-y) lean-y)
                           (+ (/ PI -2.0) 0.0001) (- (/ PI 2.0) 0.0001))
        pitch (v3-rotate-axis yaw right pitch-angle)

        head-sin (cpp/sin (* head-timer PI))
        head-cos (cpp/cos (* head-timer PI))
        step-rotation 0.01
        cam-up (v3-rotate-axis up pitch (+ (* head-sin step-rotation) lean-x))

        bob-side 0.1
        bob-up 0.15
        [rx _ rz] right
        bob-x (* rx head-sin bob-side)
        bob-y (cpp/fabs (* head-cos bob-up))
        bob-z (* rz head-sin bob-side)

        pos [(+ cx (* bob-x walk-lerp))
             (+ cy (* bob-y walk-lerp))
             (+ cz (* bob-z walk-lerp))]
        [pxx pyy pzz] pos
        [tx ty tz] pitch]
    {:look-y look-y
     :position pos
     :target [(+ pxx tx) (+ pyy ty) (+ pzz tz)]
     :up cam-up}))

(defn- write-camera!
  "Push the three vectors and the fov into the boxed Camera3D."
  [cam-box {:keys [position target up]} fovy]
  (let [c (cpp/* (cpp/unbox (:* cpp/Camera3D) cam-box))
        [px py pz] position
        [tx ty tz] target
        [ux uy uz] up]
    (cpp/= (.-x (.-position c)) (cpp/float px))
    (cpp/= (.-y (.-position c)) (cpp/float py))
    (cpp/= (.-z (.-position c)) (cpp/float pz))
    (cpp/= (.-x (.-target c)) (cpp/float tx))
    (cpp/= (.-y (.-target c)) (cpp/float ty))
    (cpp/= (.-z (.-target c)) (cpp/float tz))
    (cpp/= (.-x (.-up c)) (cpp/float ux))
    (cpp/= (.-y (.-up c)) (cpp/float uy))
    (cpp/= (.-z (.-up c)) (cpp/float uz))
    (cpp/= (.-fovy c) (cpp/float fovy)))
  nil)

(defn- draw-level!
  "Checkerboard floor, four towers and the red sun."
  []
  (let [floor-extent 25
        tile 5.0]
    (loop [y (- floor-extent)]
      (when (< y floor-extent)
        (loop [x (- floor-extent)]
          (when (< x floor-extent)
            (let [odd-y (odd? y)
                  odd-x (odd? x)]
              (when (or (and odd-y odd-x) (and (not odd-y) (not odd-x)))
                (cpp/DrawPlane (cpp/Vector3 (cpp/float (* x tile)) (cpp/float 0.0)
                                            (cpp/float (* y tile)))
                               (cpp/Vector2 (cpp/float tile) (cpp/float tile))
                               (if (and odd-y odd-x)
                                 (cpp/Color (cpp/cast cpp/uint8_t 150) (cpp/cast cpp/uint8_t 200)
                                            (cpp/cast cpp/uint8_t 200) (cpp/cast cpp/uint8_t 255))
                                 cpp/LIGHTGRAY))))
            (recur (inc x))))
        (recur (inc y)))))

  (let [tower-color (cpp/Color (cpp/cast cpp/uint8_t 150) (cpp/cast cpp/uint8_t 200)
                               (cpp/cast cpp/uint8_t 200) (cpp/cast cpp/uint8_t 255))]
    (doseq [[tx tz] [[16.0 16.0] [-16.0 16.0] [-16.0 -16.0] [16.0 -16.0]]]
      (cpp/DrawCubeV (cpp/Vector3 (cpp/float tx) (cpp/float 16.0) (cpp/float tz))
                     (cpp/Vector3 (cpp/float 16.0) (cpp/float 32.0) (cpp/float 16.0))
                     tower-color)
      (cpp/DrawCubeWiresV (cpp/Vector3 (cpp/float tx) (cpp/float 16.0) (cpp/float tz))
                          (cpp/Vector3 (cpp/float 16.0) (cpp/float 32.0) (cpp/float 16.0))
                          cpp/DARKBLUE)))

  (cpp/DrawSphere (cpp/Vector3 (cpp/float 300.0) (cpp/float 300.0) (cpp/float 0.0))
                  (cpp/float 100.0)
                  (cpp/Color (cpp/cast cpp/uint8_t 255) (cpp/cast cpp/uint8_t 0)
                             (cpp/cast cpp/uint8_t 0) (cpp/cast cpp/uint8_t 255)))
  nil)

(defn- fmt3
  "The C's %06.3f: three digits after the dot, zero-padded to width 6."
  [v]
  (let [s (str (/ (+ 0.0 (cpp/round (* v 1000.0))) 1000.0))
        s (if (string/index-of s ".") s (str s "."))
        dot (string/index-of s ".")
        frac (- (count s) dot 1)
        s (if (> frac 3) (subs s 0 (+ dot 4)) (str s (subs "000" 0 (- 3 frac))))]
    (str (subs "000000" 0 (max 0 (- 6 (count s)))) s)))

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [core] example - 3d camera fps (jank)")

  ;; the one native value that has to persist: BeginMode3D needs the struct
  (let [cam-box (cpp/box (cpp/new cpp/Camera3D))]
    (cpp/= (.-projection (cpp/* (cpp/unbox (:* cpp/Camera3D) cam-box)))
           (cpp/int cpp/CAMERA_PERSPECTIVE))

    (let [st0 {:px 0.0 :py 0.0 :pz 0.0 :vx 0.0 :vy 0.0 :vz 0.0
               :dx 0.0 :dy 0.0 :dz 0.0 :grounded? false
               :look-x 0.0 :look-y 0.0 :head-timer 0.0
               :walk-lerp 0.0 :head-lerp STAND-HEIGHT :lean-x 0.0 :lean-y 0.0}
          cam0 (camera-vectors st0 [0.0 (+ BOTTOM-HEIGHT STAND-HEIGHT) 0.0])]
      (write-camera! cam-box cam0 60.0)

      (cpp/DisableCursor)
      (cpp/SetTargetFPS 60)

      ;; Thread [state fovy].
      (loop [st (assoc st0 :look-y (:look-y cam0))
             fovy 60.0]
        (when (cpp/! (cpp/WindowShouldClose))
          (let [md (cpp/GetMouseDelta)
                delta (+ 0.0 (cpp/GetFrameTime))
                st (assoc st
                          :look-x (- (:look-x st) (* (+ 0.0 (.-x md)) SENSITIVITY))
                          :look-y (+ (:look-y st) (* (+ 0.0 (.-y md)) SENSITIVITY)))

                side (- (if (cpp/IsKeyDown cpp/KEY_D) 1 0) (if (cpp/IsKeyDown cpp/KEY_A) 1 0))
                forward (- (if (cpp/IsKeyDown cpp/KEY_W) 1 0) (if (cpp/IsKeyDown cpp/KEY_S) 1 0))
                crouch? (cpp/IsKeyDown cpp/KEY_LEFT_CONTROL)

                st (update-body st (:look-x st) side forward
                                (cpp/IsKeyPressed cpp/KEY_SPACE) crouch? delta)

                st (assoc st :head-lerp
                          (lerp (:head-lerp st)
                                (if crouch? CROUCH-HEIGHT STAND-HEIGHT)
                                (* 20.0 delta)))

                moving? (and (:grounded? st) (or (not= forward 0) (not= side 0)))
                st (assoc st
                          :head-timer (if moving?
                                        (+ (:head-timer st) (* delta 3.0))
                                        (:head-timer st))
                          :walk-lerp (lerp (:walk-lerp st) (if moving? 1.0 0.0) (* 10.0 delta))
                          :lean-x (lerp (:lean-x st) (* side 0.02) (* 10.0 delta))
                          :lean-y (lerp (:lean-y st) (* forward 0.015) (* 10.0 delta)))
                fovy (lerp fovy (if moving? 55.0 60.0) (* 5.0 delta))

                cam (camera-vectors st [(:px st)
                                        (+ (:py st) BOTTOM-HEIGHT (:head-lerp st))
                                        (:pz st)])
                st (assoc st :look-y (:look-y cam))]

            (write-camera! cam-box cam fovy)

            (cpp/BeginDrawing)
            (cpp/ClearBackground cpp/RAYWHITE)

            (cpp/BeginMode3D (cpp/* (cpp/unbox (:* cpp/Camera3D) cam-box)))
            (draw-level!)
            (cpp/EndMode3D)

            (cpp/DrawRectangle 5 5 330 75 (cpp/Fade cpp/SKYBLUE (cpp/float 0.5)))
            (cpp/DrawRectangleLines 5 5 330 75 cpp/BLUE)
            (cpp/DrawText "Camera controls:" 15 15 10 cpp/BLACK)
            (cpp/DrawText "- Move keys: W, A, S, D, Space, Left-Ctrl" 15 30 10 cpp/BLACK)
            (cpp/DrawText "- Look around: arrow keys or mouse" 15 45 10 cpp/BLACK)
            (cpp/DrawText (str "- Velocity Len: ("
                               (fmt3 (cpp/sqrt (+ (* (:vx st) (:vx st)) (* (:vz st) (:vz st)))))
                               ")")
                          15 60 10 cpp/BLACK)

            (cpp/EndDrawing)
            (recur st fovy))))))

  (cpp/CloseWindow))
