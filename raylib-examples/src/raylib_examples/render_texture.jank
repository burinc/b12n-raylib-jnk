(ns raylib-examples.render-texture
  "raylib [core] example - render texture, ported to jank.

  A ball bounces inside a 300x300 off-screen RenderTexture; each frame
  that texture is drawn to the main framebuffer with DrawTexturePro,
  rotated about its centre. The source rectangle uses a negative height
  to flip the texture vertically (render textures are y-flipped). ESC
  quits.
  Based on raylib/examples/core/core_render_texture.c

  jank-native notes: the RenderTexture2D is a native value, so it lives
  as a let-local OUTSIDE the loop (the loop closes over it) rather than
  in loop/recur state (rule 2). The render-texture size is a known
  constant, so its width/height are written as literals (300.0 / 150.0)
  the same way magnifying_glass does - reading target.texture.width and
  feeding it straight to cpp/float would be an all-native chain that
  fails codegen (rule 4)."
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RT-SIZE 300)                       ; render texture is RT-SIZE x RT-SIZE
(def RADIUS 20.0)

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [core] example - render texture (jank)")
  (let [target (cpp/LoadRenderTexture RT-SIZE RT-SIZE)]
    (cpp/SetTargetFPS 60)

    ;; state: ball x/y, ball speed x/y, texture rotation
    (loop [bx (/ RT-SIZE 2.0) by (/ RT-SIZE 2.0) svx 5.0 svy 4.0 rot 0.0]
      (when (cpp/! (cpp/WindowShouldClose))
        (let [bx  (+ bx svx)
              by  (+ by svy)
              svx (if (or (>= bx (- RT-SIZE RADIUS)) (<= bx RADIUS)) (* svx -1.0) svx)
              svy (if (or (>= by (- RT-SIZE RADIUS)) (<= by RADIUS)) (* svy -1.0) svy)
              rot (+ rot 0.5)]

          ;; render the bouncing ball into the off-screen texture
          (cpp/BeginTextureMode target)
          (cpp/ClearBackground cpp/SKYBLUE)
          (cpp/DrawRectangle 0 0 20 20 cpp/RED)
          (cpp/DrawCircleV (cpp/Vector2 (cpp/float bx) (cpp/float by))
                           (cpp/float RADIUS) cpp/MAROON)
          (cpp/EndTextureMode)

          ;; blit the texture to the screen, centred and rotated (y-flipped)
          (cpp/BeginDrawing)
          (cpp/ClearBackground cpp/RAYWHITE)
          (cpp/DrawTexturePro (.-texture target)
                              (cpp/Rectangle (cpp/float 0.0) (cpp/float 0.0)
                                             (cpp/float 300.0) (cpp/float -300.0))
                              (cpp/Rectangle (cpp/float (/ WIDTH 2.0)) (cpp/float (/ HEIGHT 2.0))
                                             (cpp/float 300.0) (cpp/float 300.0))
                              (cpp/Vector2 (cpp/float 150.0) (cpp/float 150.0))
                              (cpp/float rot) cpp/WHITE)
          (cpp/DrawText "DRAWING BOUNCING BALL INSIDE RENDER TEXTURE!" 10 (- HEIGHT 40) 20 cpp/BLACK)
          (cpp/DrawFPS 10 10)
          (cpp/EndDrawing)

          (recur bx by svx svy rot))))

    (cpp/UnloadRenderTexture target))

  (cpp/CloseWindow))
