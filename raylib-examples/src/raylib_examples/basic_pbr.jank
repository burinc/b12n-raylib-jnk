(ns raylib-examples.basic-pbr
  "raylib [shaders] example - basic pbr, ported to jank.

  Physically-based rendering: the rusty-car GLB under four colored
  point lights, every surface driven by albedo + normal + MRA
  (metalness/roughness/occlusion) + emissive texture maps through the
  pbr shader pair. Keys 1-4 toggle the lights. Orbital camera. ESC
  quits. Model: 'Old Rusty Car' by Renafox (CC BY-NC).
  Based on raylib/examples/shaders/shaders_basic_pbr.c

  jank-native notes:
  - The PBR example ships its OWN light struct (with an intensity
    field - not rlights.h compatible), so its CreateLight/UpdateLight
    stay a per-file cpp/raw block behind index wrappers, while
    rlights still supplies the generic uniform setters.
  - Material map .color / .value / .texture writes are map-slot
    shims; the per-model uniform values (tiling, emissive, metallic,
    roughness) are known jank constants re-sent per frame, matching
    the C reads off the material.
  - Teardown keeps the C's unbind dance (shader zeroed, material
    unloaded manually, maps NULLed) as a Model-by-value shim so the
    shared PBR shader isn't double-freed."
  (:require [raylib-examples.models :as md])
  (:require [raylib-examples.rlights :as rl]
            [raylib-examples.shaders :as sh])
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/shaders/resources/")

;; The four lights, as jank data for the marker spheres:
;; YELLOW / GREEN / RED / BLUE with per-light intensity.
(def LIGHTS [{:x -1.0 :y 1.0 :z -2.0 :r 253 :g 249 :b 0 :intensity 4.0}
             {:x 2.0 :y 1.0 :z 1.0 :r 0 :g 228 :b 48 :intensity 3.3}
             {:x -2.0 :y 1.0 :z 1.0 :r 230 :g 41 :b 55 :intensity 8.3}
             {:x 1.0 :y 1.0 :z -2.0 :r 0 :g 121 :b 241 :intensity 2.0}])

(defn- light-color
  "The light's Color as a packed-RGBA GetColor int."
  [{:keys [r g b]}]
  (+ (* r 16777216) (* g 65536) (* b 256) 255))

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_MSAA_4X_HINT)
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [shaders] example - basic pbr (jank)")

  (let [camera (cpp/Camera3D (cpp/Vector3 (cpp/float 2.0) (cpp/float 2.0) (cpp/float 6.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.5) (cpp/float 0.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 45.0)
                             cpp/CAMERA_PERSPECTIVE)
        shader (cpp/LoadShader (str RES "shaders/glsl330/pbr.vs")
                               (str RES "shaders/glsl330/pbr.fs"))
        ;; boxed here, where the shader is still native (see rlights ns)
        sh-box (cpp/box (cpp/new cpp/Shader shader))
        view-loc (int (cpp/GetShaderLocation shader "viewPos"))
        metallic-loc (int (cpp/GetShaderLocation shader "metallicValue"))
        roughness-loc (int (cpp/GetShaderLocation shader "roughnessValue"))
        emissive-power-loc (int (cpp/GetShaderLocation shader "emissivePower"))
        emissive-color-loc (int (cpp/GetShaderLocation shader "emissiveColor"))
        tiling-loc (int (cpp/GetShaderLocation shader "tiling"))
        car (cpp/LoadModel (str RES "models/old_car_new.glb"))
        floor (cpp/LoadModel (str RES "models/plane.glb"))]

    ;; wire the packed texture maps into raylib's material slots
    (sh/set-shader-loc! sh-box cpp/SHADER_LOC_MAP_ALBEDO
                                (int (cpp/GetShaderLocation shader "albedoMap")))
    (sh/set-shader-loc! sh-box cpp/SHADER_LOC_MAP_METALNESS
                                (int (cpp/GetShaderLocation shader "mraMap")))
    (sh/set-shader-loc! sh-box cpp/SHADER_LOC_MAP_NORMAL
                                (int (cpp/GetShaderLocation shader "normalMap")))
    (sh/set-shader-loc! sh-box cpp/SHADER_LOC_MAP_EMISSION
                                (int (cpp/GetShaderLocation shader "emissiveMap")))
    (sh/set-shader-loc! sh-box cpp/SHADER_LOC_COLOR_DIFFUSE
                                (int (cpp/GetShaderLocation shader "albedoColor")))
    (sh/set-shader-loc! sh-box cpp/SHADER_LOC_VECTOR_VIEW view-loc)

    (sh/set-int! sh-box (int (cpp/GetShaderLocation shader "numOfLights")) 4)

    ;; ambient: Color(26 32 135) normalized + a low intensity
    (sh/set-vec3! sh-box (int (cpp/GetShaderLocation shader "ambientColor"))
                          (/ 26.0 255.0) (/ 32.0 255.0) (/ 135.0 255.0))
    (sh/set-float! sh-box (int (cpp/GetShaderLocation shader "ambient")) 0.02)

    ;; car: PBR maps + defaults
    (md/set-shader! (cpp/box (cpp/new cpp/Model car)) 0 (cpp/box (cpp/new cpp/Shader shader)))
    (md/set-map-color! (cpp/box (cpp/new cpp/Model car)) (cpp/int cpp/MATERIAL_MAP_ALBEDO)
                       (cpp/box (cpp/new cpp/Color (cpp/cast cpp/uint8_t 255)
                                                   (cpp/cast cpp/uint8_t 255)
                                                   (cpp/cast cpp/uint8_t 255)
                                                   (cpp/cast cpp/uint8_t 255))))
    (md/set-map-value! (cpp/box (cpp/new cpp/Model car)) (cpp/int cpp/MATERIAL_MAP_METALNESS) 1.0)
    (md/set-map-value! (cpp/box (cpp/new cpp/Model car)) (cpp/int cpp/MATERIAL_MAP_ROUGHNESS) 0.0)
    (md/set-map-value! (cpp/box (cpp/new cpp/Model car)) (cpp/int cpp/MATERIAL_MAP_OCCLUSION) 1.0)
    (md/set-map-color! (cpp/box (cpp/new cpp/Model car)) (cpp/int cpp/MATERIAL_MAP_EMISSION)
                       (cpp/box (cpp/new cpp/Color (cpp/cast cpp/uint8_t 255)
                                                   (cpp/cast cpp/uint8_t 162)
                                                   (cpp/cast cpp/uint8_t 0)
                                                   (cpp/cast cpp/uint8_t 255))))
    (md/set-map-texture! (cpp/box (cpp/new cpp/Model car)) 0 (cpp/int cpp/MATERIAL_MAP_ALBEDO)
                              (cpp/box (cpp/new cpp/Texture2D (cpp/LoadTexture (str RES "old_car_d.png")))))
    (md/set-map-texture! (cpp/box (cpp/new cpp/Model car)) 0 (cpp/int cpp/MATERIAL_MAP_METALNESS)
                              (cpp/box (cpp/new cpp/Texture2D (cpp/LoadTexture (str RES "old_car_mra.png")))))
    (md/set-map-texture! (cpp/box (cpp/new cpp/Model car)) 0 (cpp/int cpp/MATERIAL_MAP_NORMAL)
                              (cpp/box (cpp/new cpp/Texture2D (cpp/LoadTexture (str RES "old_car_n.png")))))
    (md/set-map-texture! (cpp/box (cpp/new cpp/Model car)) 0 (cpp/int cpp/MATERIAL_MAP_EMISSION)
                              (cpp/box (cpp/new cpp/Texture2D (cpp/LoadTexture (str RES "old_car_e.png")))))

    ;; floor: road maps + defaults
    (md/set-shader! (cpp/box (cpp/new cpp/Model floor)) 0 (cpp/box (cpp/new cpp/Shader shader)))
    (md/set-map-color! (cpp/box (cpp/new cpp/Model floor)) (cpp/int cpp/MATERIAL_MAP_ALBEDO)
                       (cpp/box (cpp/new cpp/Color (cpp/cast cpp/uint8_t 255)
                                                   (cpp/cast cpp/uint8_t 255)
                                                   (cpp/cast cpp/uint8_t 255)
                                                   (cpp/cast cpp/uint8_t 255))))
    (md/set-map-value! (cpp/box (cpp/new cpp/Model floor)) (cpp/int cpp/MATERIAL_MAP_METALNESS) 0.8)
    (md/set-map-value! (cpp/box (cpp/new cpp/Model floor)) (cpp/int cpp/MATERIAL_MAP_ROUGHNESS) 0.1)
    (md/set-map-value! (cpp/box (cpp/new cpp/Model floor)) (cpp/int cpp/MATERIAL_MAP_OCCLUSION) 1.0)
    (md/set-map-color! (cpp/box (cpp/new cpp/Model floor)) (cpp/int cpp/MATERIAL_MAP_EMISSION)
                       (cpp/box (cpp/new cpp/Color (cpp/cast cpp/uint8_t 0)
                                                   (cpp/cast cpp/uint8_t 0)
                                                   (cpp/cast cpp/uint8_t 0)
                                                   (cpp/cast cpp/uint8_t 255))))
    (md/set-map-texture! (cpp/box (cpp/new cpp/Model floor)) 0 (cpp/int cpp/MATERIAL_MAP_ALBEDO)
                              (cpp/box (cpp/new cpp/Texture2D (cpp/LoadTexture (str RES "road_a.png")))))
    (md/set-map-texture! (cpp/box (cpp/new cpp/Model floor)) 0 (cpp/int cpp/MATERIAL_MAP_METALNESS)
                              (cpp/box (cpp/new cpp/Texture2D (cpp/LoadTexture (str RES "road_mra.png")))))
    (md/set-map-texture! (cpp/box (cpp/new cpp/Model floor)) 0 (cpp/int cpp/MATERIAL_MAP_NORMAL)
                              (cpp/box (cpp/new cpp/Texture2D (cpp/LoadTexture (str RES "road_n.png")))))

    ;; the four point lights (LIGHT_POINT = 1 in the PBR enum)
    (loop [i 0]
      (when (< i 4)
        (let [{:keys [x y z r g b intensity]} (nth LIGHTS i)]
          (rl/create-light! {:type rl/LIGHT-POINT
                             :px x :py y :pz z :tx 0.0 :ty 0.0 :tz 0.0
                             :r (int r) :g (int g) :b (int b) :a 255
                             :intensity intensity :shader sh-box}))
        (recur (inc i))))

    ;; texture maps all in use
    (sh/set-int! sh-box (int (cpp/GetShaderLocation shader "useTexAlbedo")) 1)
    (sh/set-int! sh-box (int (cpp/GetShaderLocation shader "useTexNormal")) 1)
    (sh/set-int! sh-box (int (cpp/GetShaderLocation shader "useTexMRA")) 1)
    (sh/set-int! sh-box (int (cpp/GetShaderLocation shader "useTexEmissive")) 1)

    (cpp/SetTargetFPS 60)

    (loop []
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/UpdateCamera (cpp/& camera) cpp/CAMERA_ORBITAL)
        (let [p (.-position camera)]
          (rl/push-view-pos! sh-box view-loc (.-x p) (.-y p) (.-z p)))

        ;; the C toggles lights 2/1/3/0 on keys 1/2/3/4
        (when (cpp/IsKeyPressed cpp/KEY_ONE) (rl/toggle-light! 2))
        (when (cpp/IsKeyPressed cpp/KEY_TWO) (rl/toggle-light! 1))
        (when (cpp/IsKeyPressed cpp/KEY_THREE) (rl/toggle-light! 3))
        (when (cpp/IsKeyPressed cpp/KEY_FOUR) (rl/toggle-light! 0))
        (loop [i 0]
          (when (< i 4)
            (rl/update-light! sh-box i)
            (recur (inc i))))

        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/BLACK)

        (cpp/BeginMode3D camera)

        ;; floor: tiling 0.5, black emissive, metallic 0.8 / roughness 0.1
        (sh/set-vec2! sh-box tiling-loc 0.5 0.5)
        (sh/set-vec4! sh-box emissive-color-loc 0.0 0.0 0.0 1.0)
        (sh/set-float! sh-box metallic-loc 0.8)
        (sh/set-float! sh-box roughness-loc 0.1)
        (cpp/DrawModel floor
                       (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                       (cpp/float 5.0) cpp/WHITE)

        ;; car: tiling 0.5, orange emissive, metallic 1.0 / roughness 0.0
        (sh/set-vec2! sh-box tiling-loc 0.5 0.5)
        (sh/set-vec4! sh-box emissive-color-loc
                              1.0 (/ 162.0 255.0) 0.0 1.0)
        (sh/set-float! sh-box emissive-power-loc 0.01)
        (sh/set-float! sh-box metallic-loc 1.0)
        (sh/set-float! sh-box roughness-loc 0.0)
        (cpp/DrawModel car
                       (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                       (cpp/float 0.25) cpp/WHITE)

        ;; marker spheres: solid when on, wire when off
        (loop [i 0]
          (when (< i 4)
            (let [{:keys [x y z] :as light} (nth LIGHTS i)]
              (if (rl/light-enabled? i)
                (cpp/DrawSphereEx (cpp/Vector3 (cpp/float x) (cpp/float y) (cpp/float z))
                                  (cpp/float 0.2) 8 8
                                  (cpp/GetColor (light-color light)))
                (cpp/DrawSphereWires (cpp/Vector3 (cpp/float x) (cpp/float y) (cpp/float z))
                                     (cpp/float 0.2) 8 8
                                     (cpp/ColorAlpha (cpp/GetColor (light-color light))
                                                     (cpp/float 0.3)))))
            (recur (inc i))))

        (cpp/EndMode3D)

        (cpp/DrawText "Toggle lights: [1][2][3][4]" 10 40 20 cpp/LIGHTGRAY)
        (cpp/DrawText "(c) Old Rusty Car model by Renafox (https://skfb.ly/LxRy)"
                      (- WIDTH 320) (- HEIGHT 20) 10 cpp/LIGHTGRAY)
        (cpp/DrawFPS 10 10)

        (cpp/EndDrawing)
        (recur)))

    ;; unbind the shared shader first so it is not freed twice
    (cpp/= (.-shader (cpp/aget (.-materials car) (cpp/int 0))) (cpp/* (cpp/new cpp/Shader)))
    (cpp/UnloadMaterial (cpp/aget (.-materials car) (cpp/int 0)))
    (cpp/= (.-maps (cpp/aget (.-materials car) (cpp/int 0))) (cpp/cast (:* cpp/MaterialMap) cpp/nullptr))
    (cpp/UnloadModel car)
    (cpp/= (.-shader (cpp/aget (.-materials floor) (cpp/int 0))) (cpp/* (cpp/new cpp/Shader)))
    (cpp/UnloadMaterial (cpp/aget (.-materials floor) (cpp/int 0)))
    (cpp/= (.-maps (cpp/aget (.-materials floor) (cpp/int 0))) (cpp/cast (:* cpp/MaterialMap) cpp/nullptr))
    (cpp/UnloadModel floor)
    (cpp/UnloadShader shader))

  (cpp/CloseWindow))
