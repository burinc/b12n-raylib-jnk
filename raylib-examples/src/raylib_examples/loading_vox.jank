(ns raylib-examples.loading-vox
  "raylib [models] example - loading vox, ported to jank.

  Four MagicaVoxel (.vox) models - knight, sword, monument, fez -
  cycled with LEFT CLICK under a custom fly camera (ARROWS/WASD move,
  MIDDLE-drag rotates, WHEEL zooms) and four gray point lights on the
  voxel lighting shader. ESC quits.
  Based on raylib/examples/models/models_loading_vox.c

  jank-native notes:
  - First VOX format (the last probe-first model format); the four
    Models are let-locals cycled by a per-index cond (the
    mesh-generation pattern).
  - Each model is centered by a shim computing its bounding-box
    XZ-middle and setting a MatrixTranslate transform.
  - First UpdateCameraPro: movement/rotation Vector3s built inline
    from jank-computed key/mouse values, called on (cpp/& camera).
  - Lights + uniforms ride the rlights namespace."
  (:require [raylib-examples.models :as md]
            [raylib-examples.rlights :as rl]
            [raylib-examples.shaders :as sh])
  (:include "raylib.h" "raymath.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/models/resources/")

(def VOX-NAMES ["chr_knight.vox" "chr_sword.vox" "monu9.vox" "fez.vox"])

;; The four gray point lights, as jank data for the marker spheres.
(def LIGHTS [{:x -20.0 :y 20.0 :z -20.0}
             {:x 20.0 :y -20.0 :z 20.0}
             {:x -20.0 :y 20.0 :z 20.0}
             {:x 20.0 :y -20.0 :z -20.0}])

(defn- center-xz!
  "model.transform = MatrixTranslate(-cx, 0, -cz), centering the model's
  bounding box on the X/Z plane. Takes a BOXED model: Model has no
  conversion trait, so it cannot arrive as a bare jank fn argument."
  [m-box]
  (let [m  (cpp/unbox (:* cpp/Model) m-box)
        bb (cpp/GetModelBoundingBox (cpp/* m))
        lo (.-min bb)
        hi (.-max bb)
        cx (+ (+ 0.0 (.-x lo)) (/ (- (+ 0.0 (.-x hi)) (+ 0.0 (.-x lo))) 2.0))
        cz (+ (+ 0.0 (.-z lo)) (/ (- (+ 0.0 (.-z hi)) (+ 0.0 (.-z lo))) 2.0))]
    (cpp/= (.-transform (cpp/* m))
           (cpp/MatrixTranslate (cpp/float (- cx)) (cpp/float 0.0) (cpp/float (- cz)))))
  nil)

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [models] example - loading vox (jank)")

  (let [camera (cpp/Camera3D (cpp/Vector3 (cpp/float 10.0) (cpp/float 10.0) (cpp/float 10.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 45.0)
                             cpp/CAMERA_PERSPECTIVE)
        m0 (cpp/LoadModel (str RES "models/vox/chr_knight.vox"))
        m1 (cpp/LoadModel (str RES "models/vox/chr_sword.vox"))
        m2 (cpp/LoadModel (str RES "models/vox/monu9.vox"))
        m3 (cpp/LoadModel (str RES "models/vox/fez.vox"))
        shader (cpp/LoadShader (str RES "shaders/glsl330/voxel_lighting.vs")
                               (str RES "shaders/glsl330/voxel_lighting.fs"))
        ;; boxed here, where the shader is still native (see rlights ns)
        sh-box (cpp/box (cpp/new cpp/Shader shader))
        view-loc (int (cpp/GetShaderLocation shader "viewPos"))
        ambient-loc (int (cpp/GetShaderLocation shader "ambient"))]

    (center-xz! (cpp/box (cpp/new cpp/Model m0)))
    (center-xz! (cpp/box (cpp/new cpp/Model m1)))
    (center-xz! (cpp/box (cpp/new cpp/Model m2)))
    (center-xz! (cpp/box (cpp/new cpp/Model m3)))

    (sh/set-shader-loc! sh-box cpp/SHADER_LOC_VECTOR_VIEW view-loc)
    (sh/set-vec4! sh-box ambient-loc 0.1 0.1 0.1 1.0)

    (md/set-shader-all! (cpp/box (cpp/new cpp/Model m0)) (int (.-materialCount m0))
                        (cpp/box (cpp/new cpp/Shader shader)))
    (md/set-shader-all! (cpp/box (cpp/new cpp/Model m1)) (int (.-materialCount m1))
                        (cpp/box (cpp/new cpp/Shader shader)))
    (md/set-shader-all! (cpp/box (cpp/new cpp/Model m2)) (int (.-materialCount m2))
                        (cpp/box (cpp/new cpp/Shader shader)))
    (md/set-shader-all! (cpp/box (cpp/new cpp/Model m3)) (int (.-materialCount m3))
                        (cpp/box (cpp/new cpp/Shader shader)))

    ;; four GRAY point lights
    (loop [i 0]
      (when (< i 4)
        (let [{:keys [x y z]} (nth LIGHTS i)]
          (rl/create-light! {:type rl/LIGHT-POINT
                                      :px x :py y :pz z
                                      :tx 0.0 :ty 0.0 :tz 0.0
                                      :r 130 :g 130 :b 130 :a 255
                                      :shader sh-box}))
        (recur (inc i))))

    (cpp/SetTargetFPS 60)

    ;; Thread [current-model-index].
    (loop [current 0]
      (when (cpp/! (cpp/WindowShouldClose))
        (let [middle? (if (cpp/IsMouseButtonDown cpp/MOUSE_BUTTON_MIDDLE) true false)
              delta (cpp/GetMouseDelta)
              rot-x (if middle? (* (+ 0.0 (.-x delta)) 0.05) 0.0)
              rot-y (if middle? (* (+ 0.0 (.-y delta)) 0.05) 0.0)
              fwd (- (+ (if (cpp/IsKeyDown cpp/KEY_W) 0.1 0.0)
                        (if (cpp/IsKeyDown cpp/KEY_UP) 0.1 0.0))
                     (+ (if (cpp/IsKeyDown cpp/KEY_S) 0.1 0.0)
                        (if (cpp/IsKeyDown cpp/KEY_DOWN) 0.1 0.0)))
              side (- (+ (if (cpp/IsKeyDown cpp/KEY_D) 0.1 0.0)
                         (if (cpp/IsKeyDown cpp/KEY_RIGHT) 0.1 0.0))
                      (+ (if (cpp/IsKeyDown cpp/KEY_A) 0.1 0.0)
                         (if (cpp/IsKeyDown cpp/KEY_LEFT) 0.1 0.0)))
              zoom (* (+ 0.0 (cpp/GetMouseWheelMove)) -2.0)
              current (if (cpp/IsMouseButtonPressed cpp/MOUSE_BUTTON_LEFT)
                        (int (mod (inc current) 4))
                        current)]

          (cpp/UpdateCameraPro (cpp/& camera)
                               (cpp/Vector3 (cpp/float fwd) (cpp/float side) (cpp/float 0.0))
                               (cpp/Vector3 (cpp/float rot-x) (cpp/float rot-y) (cpp/float 0.0))
                               (cpp/float zoom))

          (let [p (.-position camera)]
              (rl/push-view-pos! sh-box view-loc (.-x p) (.-y p) (.-z p)))
          (loop [i 0]
            (when (< i 4)
              (rl/update-light! sh-box (int i))
              (recur (inc i))))

          (cpp/BeginDrawing)
          (cpp/ClearBackground cpp/RAYWHITE)

          (cpp/BeginMode3D camera)
          ;; four native Models can't sit in a vector: per-index cond
          (cond (= current 0) (cpp/DrawModel m0 (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0)) (cpp/float 1.0) cpp/WHITE)
                (= current 1) (cpp/DrawModel m1 (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0)) (cpp/float 1.0) cpp/WHITE)
                (= current 2) (cpp/DrawModel m2 (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0)) (cpp/float 1.0) cpp/WHITE)
                :else (cpp/DrawModel m3 (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0)) (cpp/float 1.0) cpp/WHITE))
          (cpp/DrawGrid 10 (cpp/float 1.0))

          ;; gray marker spheres at the lights
          (loop [i 0]
            (when (< i 4)
              (let [{:keys [x y z]} (nth LIGHTS i)]
                (if (rl/light-enabled? (int i))
                  (cpp/DrawSphereEx (cpp/Vector3 (cpp/float x) (cpp/float y) (cpp/float z))
                                    (cpp/float 0.2) 8 8 cpp/GRAY)
                  (cpp/DrawSphereWires (cpp/Vector3 (cpp/float x) (cpp/float y) (cpp/float z))
                                       (cpp/float 0.2) 8 8
                                       (cpp/ColorAlpha cpp/GRAY (cpp/float 0.3)))))
              (recur (inc i))))
          (cpp/EndMode3D)

          (cpp/DrawRectangle 10 40 340 70 (cpp/Fade cpp/SKYBLUE (cpp/float 0.5)))
          (cpp/DrawRectangleLines 10 40 340 70 (cpp/Fade cpp/DARKBLUE (cpp/float 0.5)))
          (cpp/DrawText "- MOUSE LEFT BUTTON: CYCLE VOX MODELS" 20 50 10 cpp/BLUE)
          (cpp/DrawText "- MOUSE MIDDLE BUTTON: ZOOM OR ROTATE CAMERA" 20 70 10 cpp/BLUE)
          (cpp/DrawText "- UP-DOWN-LEFT-RIGHT KEYS: MOVE CAMERA" 20 90 10 cpp/BLUE)
          (cpp/DrawText (str "VOX model file: " (nth VOX-NAMES current)) 10 10 20 cpp/GRAY)

          (cpp/EndDrawing)
          (recur current))))

    (cpp/UnloadModel m0)
    (cpp/UnloadModel m1)
    (cpp/UnloadModel m2)
    (cpp/UnloadModel m3)
    (cpp/UnloadShader shader))

  (cpp/CloseWindow))
