(ns raylib-examples.deferred-rendering
  "raylib [shaders] example - deferred rendering, ported to jank.

  A deferred pipeline: the scene renders once into a three-target
  G-buffer (world position, normal, albedo+specular), then a
  full-screen quad shades every pixel from those textures under four
  toggleable point lights (Y/R/G/B). Keys 1/2/3/4 show the raw
  position / normal / albedo textures / the final shading. Orbital
  camera. ESC quits.
  Based on raylib/examples/shaders/shaders_deferred_rendering.c

  jank-native notes:
  - First MULTI-RENDER-TARGET framebuffer: the G-buffer (3 color
    textures + depth renderbuffer, rlActiveDrawBuffers 3) is built with
    direct rlgl calls, its ids held as plain jank ints since GL names are
    unsigned ints and cross a fn boundary freely.
  - The debug views draw a Texture2D assembled with cpp/new from a raw
    GL id.
  - Lights ride the rlights namespace against the deferred shader; the 30
    random cubes are a jank vector of maps drawn with DrawModelEx."
  (:require [raylib-examples.models :as md])
  (:require [raylib-examples.rlights :as rl]
            [raylib-examples.shaders :as sh])
  (:include "raylib.h" "rlgl.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def MAX-CUBES 30)
(def RES "../jank-raylib-sys/raylib/examples/shaders/resources/")

;; The four lights (YELLOW / RED / GREEN / BLUE), as jank data for the
;; marker spheres.
(def LIGHTS [{:x -2.0 :y 1.0 :z -2.0 :r 253 :g 249 :b 0}
             {:x 2.0 :y 1.0 :z 2.0 :r 230 :g 41 :b 55}
             {:x -2.0 :y 1.0 :z 2.0 :r 0 :g 228 :b 48}
             {:x 2.0 :y 1.0 :z -2.0 :r 0 :g 121 :b 241}])

(defn- light-color
  "The light's Color as a packed-RGBA GetColor int."
  [{:keys [r g b]}]
  (+ (* r 16777216) (* g 65536) (* b 256) 255))

;; Deferred debug modes (the C's enum): 0 position, 1 normal, 2 albedo,
;; 3 the final shading.
(def MODE-SHADING 3)

(defn- gbuffer-init!
  "Build the G-buffer and return its ids as an ordinary jank map.

  The C kept five `static unsigned int`s and a getter per field. None of
  that is needed: a GPU id is an unsigned int, which is trait-convertible,
  so it crosses the jank boundary freely and a plain map holds the set."
  [width height]
  (let [fbo (cpp/rlLoadFramebuffer)]
    (cpp/rlEnableFramebuffer fbo)
    (let [position (cpp/rlLoadTexture cpp/nullptr (cpp/int width) (cpp/int height)
                                      (cpp/int cpp/RL_PIXELFORMAT_UNCOMPRESSED_R16G16B16) (cpp/int 1))
          normal (cpp/rlLoadTexture cpp/nullptr (cpp/int width) (cpp/int height)
                                    (cpp/int cpp/RL_PIXELFORMAT_UNCOMPRESSED_R16G16B16) (cpp/int 1))
          albedo (cpp/rlLoadTexture cpp/nullptr (cpp/int width) (cpp/int height)
                                    (cpp/int cpp/RL_PIXELFORMAT_UNCOMPRESSED_R8G8B8A8) (cpp/int 1))]
      (cpp/rlActiveDrawBuffers (cpp/int 3))
      (cpp/rlFramebufferAttach fbo position (cpp/int cpp/RL_ATTACHMENT_COLOR_CHANNEL0)
                               (cpp/int cpp/RL_ATTACHMENT_TEXTURE2D) (cpp/int 0))
      (cpp/rlFramebufferAttach fbo normal (cpp/int cpp/RL_ATTACHMENT_COLOR_CHANNEL1)
                               (cpp/int cpp/RL_ATTACHMENT_TEXTURE2D) (cpp/int 0))
      (cpp/rlFramebufferAttach fbo albedo (cpp/int cpp/RL_ATTACHMENT_COLOR_CHANNEL2)
                               (cpp/int cpp/RL_ATTACHMENT_TEXTURE2D) (cpp/int 0))
      (let [depth (cpp/rlLoadTextureDepth (cpp/int width) (cpp/int height) (cpp/bool true))]
        (cpp/rlFramebufferAttach fbo depth (cpp/int cpp/RL_ATTACHMENT_DEPTH)
                                 (cpp/int cpp/RL_ATTACHMENT_RENDERBUFFER) (cpp/int 0))
        (when-not (cpp/rlFramebufferComplete fbo)
          (println "G-buffer framebuffer is not complete"))
        {:fbo (int (+ 0.0 fbo)) :position (int (+ 0.0 position))
         :normal (int (+ 0.0 normal)) :albedo (int (+ 0.0 albedo))
         :depth (int (+ 0.0 depth))}))))

(defn- gbuffer-unload!
  [{:keys [fbo position normal albedo depth]}]
  (cpp/rlUnloadFramebuffer (cpp/int fbo))
  (cpp/rlUnloadTexture (cpp/int position))
  (cpp/rlUnloadTexture (cpp/int normal))
  (cpp/rlUnloadTexture (cpp/int albedo))
  (cpp/rlUnloadTexture (cpp/int depth))
  nil)

(defn- draw-gbuffer-tex!
  "Draw a raw G-buffer texture id full-screen, y-flipped."
  [id width height]
  (let [tex (cpp/new cpp/Texture2D)]
    (cpp/= (.-id (cpp/* tex)) (cpp/cast cpp/uint (int id)))
    (cpp/= (.-width (cpp/* tex)) (cpp/int width))
    (cpp/= (.-height (cpp/* tex)) (cpp/int height))
    (cpp/DrawTextureRec (cpp/* tex)
                        (cpp/Rectangle (cpp/float 0.0) (cpp/float 0.0)
                                       (cpp/float (+ 0.0 width)) (cpp/float (- 0.0 (+ 0.0 height))))
                        (cpp/Vector2 (cpp/float 0.0) (cpp/float 0.0))
                        cpp/RAYWHITE))
  nil)

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [shaders] example - deferred rendering (jank)")

  (let [camera (cpp/Camera3D (cpp/Vector3 (cpp/float 5.0) (cpp/float 4.0) (cpp/float 5.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 60.0)
                             cpp/CAMERA_PERSPECTIVE)
        model (cpp/LoadModelFromMesh (cpp/GenMeshPlane (cpp/float 10.0) (cpp/float 10.0) 3 3))
        cube (cpp/LoadModelFromMesh (cpp/GenMeshCube (cpp/float 2.0) (cpp/float 2.0) (cpp/float 2.0)))
        gbuffer-shader (cpp/LoadShader (str RES "shaders/glsl330/gbuffer.vs")
                                       (str RES "shaders/glsl330/gbuffer.fs"))
        deferred-shader (cpp/LoadShader (str RES "shaders/glsl330/deferred_shading.vs")
                                        (str RES "shaders/glsl330/deferred_shading.fs"))
        ;; boxed here, where the shader is still native (see rlights ns)
        sh-box (cpp/box (cpp/new cpp/Shader deferred-shader))
        view-loc (int (cpp/GetShaderLocation deferred-shader "viewPosition"))
        ;; 30 random tumbling cubes, as jank data
        cubes (loop [i 0 acc []]
                (if (< i MAX-CUBES)
                  (recur (inc i)
                         (conj acc {:x (+ 0.0 (int (cpp/GetRandomValue -5 4)))
                                    :y (+ 0.0 (int (cpp/GetRandomValue 0 4)))
                                    :z (+ 0.0 (int (cpp/GetRandomValue -5 4)))
                                    :rot (+ 0.0 (int (cpp/GetRandomValue 0 359)))}))
                  acc))
        ;; the G-buffer's five GPU ids as a plain jank map, replacing five
        ;; cpp/raw statics and a getter each
        gbuf (gbuffer-init! WIDTH HEIGHT)]

    (sh/set-shader-loc! sh-box cpp/SHADER_LOC_VECTOR_VIEW view-loc)

    (cpp/rlEnableShader (.-id deferred-shader))
    ;; point the deferred shader's sampler2D uniforms at texture units 0/1/2
    (doseq [[nm unit] [["gPosition" 0] ["gNormal" 1] ["gAlbedoSpec" 2]]]
      (cpp/SetShaderValue deferred-shader
                          (cpp/rlGetLocationUniform (.-id deferred-shader) nm)
                          (cpp/new cpp/int (cpp/int unit))
                          (cpp/int cpp/RL_SHADER_UNIFORM_SAMPLER2D)))
    (cpp/rlDisableShader)

    (md/set-shader! (cpp/box (cpp/new cpp/Model model)) 0
                    (cpp/box (cpp/new cpp/Shader gbuffer-shader)))
    (md/set-shader! (cpp/box (cpp/new cpp/Model cube)) 0
                    (cpp/box (cpp/new cpp/Shader gbuffer-shader)))

    ;; the four point lights live on the DEFERRED shader
    (loop [i 0]
      (when (< i 4)
        (let [{:keys [x y z r g b]} (nth LIGHTS i)]
          (rl/create-light! {:type rl/LIGHT-POINT
                                      :px x :py y :pz z
                                      :tx 0.0 :ty 0.0 :tz 0.0
                                      :r (int r) :g (int g) :b (int b) :a 255
                                      :shader sh-box}))
        (recur (inc i))))

    (cpp/rlEnableDepthTest)
    (cpp/SetTargetFPS 60)

    ;; Thread [debug-mode].
    (loop [mode MODE-SHADING]
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/UpdateCamera (cpp/& camera) cpp/CAMERA_ORBITAL)
        (let [p (.-position camera)]
          (rl/push-view-pos! sh-box view-loc (.-x p) (.-y p) (.-z p)))

        (when (cpp/IsKeyPressed cpp/KEY_Y) (rl/toggle-light! 0))
        (when (cpp/IsKeyPressed cpp/KEY_R) (rl/toggle-light! 1))
        (when (cpp/IsKeyPressed cpp/KEY_G) (rl/toggle-light! 2))
        (when (cpp/IsKeyPressed cpp/KEY_B) (rl/toggle-light! 3))

        (let [mode (cond (cpp/IsKeyPressed cpp/KEY_ONE) 0
                         (cpp/IsKeyPressed cpp/KEY_TWO) 1
                         (cpp/IsKeyPressed cpp/KEY_THREE) 2
                         (cpp/IsKeyPressed cpp/KEY_FOUR) 3
                         :else mode)]

          (loop [i 0]
            (when (< i 4)
              (rl/update-light! sh-box (int i))
              (recur (inc i))))

          (cpp/BeginDrawing)

          ;; geometry pass: the scene into the three G-buffer targets
          (cpp/rlEnableFramebuffer (cpp/cast cpp/uint (:fbo gbuf)))
          (cpp/rlClearColor 0 0 0 0)
          (cpp/rlClearScreenBuffers)
          (cpp/rlDisableColorBlend)

          (cpp/BeginMode3D camera)
          ;; BeginShaderMode won't load the program in time - raw enable
          (cpp/rlEnableShader (.-id gbuffer-shader))
          (cpp/DrawModel model
                         (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                         (cpp/float 1.0) cpp/WHITE)
          (cpp/DrawModel cube
                         (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                         (cpp/float 1.0) cpp/WHITE)
          (loop [i 0]
            (when (< i MAX-CUBES)
              (let [{:keys [x y z rot]} (nth cubes i)]
                (cpp/DrawModelEx cube
                                 (cpp/Vector3 (cpp/float x) (cpp/float y) (cpp/float z))
                                 (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                                 (cpp/float rot)
                                 (cpp/Vector3 (cpp/float 0.25) (cpp/float 0.25) (cpp/float 0.25))
                                 cpp/WHITE))
              (recur (inc i))))
          (cpp/rlDisableShader)
          (cpp/EndMode3D)

          (cpp/rlEnableColorBlend)

          ;; back to the default framebuffer
          (cpp/rlDisableFramebuffer)
          (cpp/rlClearScreenBuffers)

          (if (= mode MODE-SHADING)
            (do
              ;; lighting pass: full-screen quad shaded from the G-buffer
              (cpp/BeginMode3D camera)
              (cpp/rlDisableColorBlend)
              (cpp/rlEnableShader (.-id deferred-shader))
              (cpp/rlActiveTextureSlot 0)
              (cpp/rlEnableTexture (cpp/cast cpp/uint (:position gbuf)))
              (cpp/rlActiveTextureSlot 1)
              (cpp/rlEnableTexture (cpp/cast cpp/uint (:normal gbuf)))
              (cpp/rlActiveTextureSlot 2)
              (cpp/rlEnableTexture (cpp/cast cpp/uint (:albedo gbuf)))
              (cpp/rlLoadDrawQuad)
              (cpp/rlDisableShader)
              (cpp/rlEnableColorBlend)
              (cpp/EndMode3D)

              ;; carry the G-buffer depth over, then forward-draw the markers
              (cpp/rlBindFramebuffer (cpp/int cpp/RL_READ_FRAMEBUFFER) (cpp/cast cpp/uint (:fbo gbuf)))
              (cpp/rlBindFramebuffer (cpp/int cpp/RL_DRAW_FRAMEBUFFER) (cpp/cast cpp/uint 0))
              (cpp/rlBlitFramebuffer (cpp/int 0) (cpp/int 0) (cpp/int WIDTH) (cpp/int HEIGHT)
                                     (cpp/int 0) (cpp/int 0) (cpp/int WIDTH) (cpp/int HEIGHT)
                                     (cpp/int 0x00000100))
              (cpp/rlDisableFramebuffer)

              (cpp/BeginMode3D camera)
              (cpp/rlEnableShader (cpp/rlGetShaderIdDefault))
              (loop [i 0]
                (when (< i 4)
                  (let [{:keys [x y z] :as light} (nth LIGHTS i)]
                    (if (rl/light-enabled? (int i))
                      (cpp/DrawSphereEx (cpp/Vector3 (cpp/float x) (cpp/float y) (cpp/float z))
                                        (cpp/float 0.2) 8 8
                                        (cpp/GetColor (light-color light)))
                      (cpp/DrawSphereWires (cpp/Vector3 (cpp/float x) (cpp/float y) (cpp/float z))
                                           (cpp/float 0.2) 8 8
                                           (cpp/ColorAlpha (cpp/GetColor (light-color light))
                                                           (cpp/float 0.3)))))
                  (recur (inc i))))
              (cpp/rlDisableShader)
              (cpp/EndMode3D)

              (cpp/DrawText "FINAL RESULT" 10 (- HEIGHT 30) 20 cpp/DARKGREEN))
            (do
              ;; raw G-buffer texture debug views
              (cond (= mode 0) (draw-gbuffer-tex! (:position gbuf) WIDTH HEIGHT)
                    (= mode 1) (draw-gbuffer-tex! (:normal gbuf) WIDTH HEIGHT)
                    :else (draw-gbuffer-tex! (:albedo gbuf) WIDTH HEIGHT))
              (cond (= mode 0) (cpp/DrawText "POSITION TEXTURE" 10 (- HEIGHT 30) 20 cpp/DARKGREEN)
                    (= mode 1) (cpp/DrawText "NORMAL TEXTURE" 10 (- HEIGHT 30) 20 cpp/DARKGREEN)
                    :else (cpp/DrawText "ALBEDO TEXTURE" 10 (- HEIGHT 30) 20 cpp/DARKGREEN))))

          (cpp/DrawText "Toggle lights keys: [Y][R][G][B]" 10 40 20 cpp/DARKGRAY)
          (cpp/DrawText "Switch G-buffer textures: [1][2][3][4]" 10 70 20 cpp/DARKGRAY)
          (cpp/DrawFPS 10 10)

          (cpp/EndDrawing)
          (recur mode))))

    (cpp/UnloadModel model)
    (cpp/UnloadModel cube)
    (cpp/UnloadShader deferred-shader)
    (cpp/UnloadShader gbuffer-shader)
    (gbuffer-unload! gbuf))

  (cpp/CloseWindow))
