(ns raylib-examples.loading-iqm
  "raylib [models] example - loading iqm, ported to jank.

  The classic IQM guy walking on loop: the animated mesh and its
  animation data load from two separate .iqm files, drawn lying-flat
  corrected by a -90 degree X rotation. Orbital camera. ESC quits.
  Based on raylib/examples/models/models_loading_iqm.c

  jank-native notes:
  - First IQM format (model + animations from separate files); the
    animation array binds in the outer let, with the frame threaded as
    a jank int wrapping at the keyframe count.
  - The C's SetMaterialTexture(&model.materials[0], ...) is
    models.jank's set-texture!."
  (:require [raylib-examples.models :as md])
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/models/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [models] example - loading iqm (jank)")

  (let [camera (cpp/Camera3D (cpp/Vector3 (cpp/float 10.0) (cpp/float 10.0) (cpp/float 10.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 4.0) (cpp/float 0.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 45.0)
                             cpp/CAMERA_PERSPECTIVE)
        model (cpp/LoadModel (str RES "models/iqm/guy.iqm"))
        texture (cpp/LoadTexture (str RES "models/iqm/guytex.png"))
        ;; the array outlives this call by living in the outer let, not in a
        ;; cpp/raw static; the count comes back through an int* out-param
        anim-n (cpp/int 0)
        anims (cpp/LoadModelAnimations (str RES "models/iqm/guyanim.iqm") (cpp/& anim-n))
        keyframes (int (+ 0.0 (.-keyframeCount (cpp/aget anims (cpp/int 0)))))]

    (md/set-texture! (cpp/box (cpp/new cpp/Model model))
                     (cpp/box (cpp/new cpp/Texture2D texture)))

    (cpp/SetTargetFPS 60)

    ;; Thread [animation-frame].
    (loop [frame 0]
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/UpdateCamera (cpp/& camera) cpp/CAMERA_ORBITAL)

        (let [frame (inc frame)
              _ (cpp/UpdateModelAnimation model (cpp/aget anims (cpp/int 0))
                                            (cpp/float (+ 0.0 (int frame))))
              frame (if (>= frame keyframes) 0 frame)]

          (cpp/BeginDrawing)
          (cpp/ClearBackground cpp/RAYWHITE)

          (cpp/BeginMode3D camera)
          ;; IQM models lie flat: stand the guy up with a -90 X rotation
          (cpp/DrawModelEx model
                           (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                           (cpp/Vector3 (cpp/float 1.0) (cpp/float 0.0) (cpp/float 0.0))
                           (cpp/float -90.0)
                           (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                           cpp/WHITE)
          (cpp/DrawGrid 10 (cpp/float 1.0))
          (cpp/EndMode3D)

          (cpp/DrawText (str "Current animation: " (str (.-name (cpp/aget anims (cpp/int 0))))) 10 10 20 cpp/MAROON)
          (cpp/DrawText "(c) Guy IQM 3D model by @culacant" (- WIDTH 200) (- HEIGHT 20) 10 cpp/GRAY)

          (cpp/EndDrawing)
          (recur frame))))

    (cpp/UnloadTexture texture)
    (cpp/UnloadModel model))

  (cpp/CloseWindow))
