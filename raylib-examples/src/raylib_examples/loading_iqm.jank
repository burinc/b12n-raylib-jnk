(ns raylib-examples.loading-iqm
  "raylib [models] example - loading iqm, ported to jank.

  The classic IQM guy walking on loop: the animated mesh and its
  animation data load from two separate .iqm files, drawn lying-flat
  corrected by a -90 degree X rotation. Orbital camera. ESC quits.
  Based on raylib/examples/models/models_loading_iqm.c

  jank-native notes:
  - First IQM format (model + animations from separate files); the
    usual animation shims, with the frame threaded as a jank int
    wrapping at the keyframe count.
  - The C's SetMaterialTexture(&model.materials[0], ...) is the
    familiar material-texture write shim."
  (:include "raylib.h"))

(cpp/raw "static void jank_model_set_texture(Model* m, Texture2D tex) {
  m->materials[0].maps[MATERIAL_MAP_DIFFUSE].texture = tex;
}
static ModelAnimation *jank_anims = NULL;
static int jank_anims_count = 0;
static int jank_load_anims(const char* path) {
  jank_anims = LoadModelAnimations(path, &jank_anims_count);
  return jank_anims_count;
}
static int jank_anim_keyframes(int i) { return jank_anims[i].keyframeCount; }
static const char* jank_anim_name(int i) { return jank_anims[i].name; }
static void jank_update_anim(Model m, int i, int frame) {
  UpdateModelAnimation(m, jank_anims[i], frame);
}")

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/models/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [models] example - loading iqm (jank)")

  (let [camera (cpp/Camera3D (cpp/Vector3 (cpp/float 10.0) (cpp/float 10.0) (cpp/float 10.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 4.0) (cpp/float 0.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 45.0)
                             cpp/CAMERA_PERSPECTIVE)
        model (cpp/LoadModel (str RES "models/iqm/guy.iqm"))
        texture (cpp/LoadTexture (str RES "models/iqm/guytex.png"))
        _ (int (cpp/jank_load_anims (str RES "models/iqm/guyanim.iqm")))
        keyframes (int (cpp/jank_anim_keyframes 0))]

    (cpp/jank_model_set_texture (cpp/& model) texture)

    (cpp/SetTargetFPS 60)

    ;; Thread [animation-frame].
    (loop [frame 0]
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/UpdateCamera (cpp/& camera) cpp/CAMERA_ORBITAL)

        (let [frame (inc frame)
              _ (cpp/jank_update_anim model 0 (int frame))
              frame (if (>= frame keyframes) 0 frame)]

          (cpp/BeginDrawing)
          (cpp/ClearBackground cpp/RAYWHITE)

          (cpp/BeginMode3D camera)
          ;; IQM models lie flat: stand the guy up with a -90 X rotation
          (cpp/DrawModelEx model
                           (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                           (cpp/Vector3 (cpp/float 1.0) (cpp/float 0.0) (cpp/float 0.0))
                           (cpp/float -90.0)
                           (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                           cpp/WHITE)
          (cpp/DrawGrid 10 (cpp/float 1.0))
          (cpp/EndMode3D)

          (cpp/DrawText (str "Current animation: " (cpp/jank_anim_name 0)) 10 10 20 cpp/MAROON)
          (cpp/DrawText "(c) Guy IQM 3D model by @culacant" (- WIDTH 200) (- HEIGHT 20) 10 cpp/GRAY)

          (cpp/EndDrawing)
          (recur frame))))

    (cpp/UnloadTexture texture)
    (cpp/UnloadModel model))

  (cpp/CloseWindow))
