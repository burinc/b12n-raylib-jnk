(ns raylib-examples.srcrec-dstrec
  "raylib [textures] example - srcrec dstrec, ported to jank.

  One frame of the scarfy spritesheet drawn with DrawTexturePro:
  the source rectangle picks the frame, the destination rectangle
  scales it 2x at screen center, and the origin makes it spin in
  place (rotation increments every frame). Q quits.
  Scarfy sprite by Eiden Marsal.
  Based on raylib/examples/textures/textures_srcrec_dstrec.c
  (jank-native: all rectangles/vectors are built inline as call
  arguments each frame; only the rotation int threads the loop.)"
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def SHEET "../jank-raylib-sys/raylib/examples/textures/resources/scarfy.png")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [textures] example - srcrec dstrec (jank)")
  (cpp/SetTargetFPS 60)

  ;; Textures must load after InitWindow (needs the OpenGL context).
  (let [scarfy (cpp/LoadTexture SHEET)
        fw (int (quot (int (+ 0.0 (.-width scarfy))) 6))
        fh (int (+ 0.0 (.-height scarfy)))
        cx (int (quot WIDTH 2))
        cy (int (quot HEIGHT 2))]

    (loop [rotation 0]
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/RAYWHITE)

        ;; source = one sheet frame, dest = 2x at screen center,
        ;; origin = frame size so the sprite rotates around the center.
        (cpp/DrawTexturePro scarfy
                            (cpp/Rectangle (cpp/float 0.0) (cpp/float 0.0)
                                           (cpp/float (+ 0.0 fw)) (cpp/float (+ 0.0 fh)))
                            (cpp/Rectangle (cpp/float (+ 0.0 cx)) (cpp/float (+ 0.0 cy))
                                           (cpp/float (* 2.0 fw)) (cpp/float (* 2.0 fh)))
                            (cpp/Vector2 (cpp/float (+ 0.0 fw)) (cpp/float (+ 0.0 fh)))
                            (cpp/float (+ 0.0 rotation))
                            cpp/WHITE)

        (cpp/DrawLine cx 0 cx HEIGHT cpp/GRAY)
        (cpp/DrawLine 0 cy WIDTH cy cpp/GRAY)

        (cpp/DrawText "(c) Scarfy sprite by Eiden Marsal" (- WIDTH 200) (- HEIGHT 20) 10 cpp/GRAY)
        (cpp/DrawText "Q to quit" 10 10 10 cpp/GRAY)

        (cpp/EndDrawing)

        (when-not (cpp/IsKeyDown cpp/KEY_Q)
          (recur (+ rotation 1)))))

    (cpp/UnloadTexture scarfy))

  (cpp/CloseWindow))
