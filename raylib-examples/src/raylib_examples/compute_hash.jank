(ns raylib-examples.compute-hash
  "raylib [core] example - compute hash, ported to jank.

  Type into the input box (BACKSPACE deletes) and press ENTER to compute
  the CRC32 / MD5 / SHA1 / SHA256 hashes of the text, plus its Base64
  encoding. ESC quits.
  Based on raylib/examples/core/core_compute_hash.c

  jank-native notes:
  - The C is a raygui showcase (GuiTextBox / GuiButton / GuiLabel); per the
    repo's raygui-to-keyboard pattern the textbox is always type-enabled
    (GetCharPressed + the ASCII-table subs trick from input-box) and the
    COMPUTE button becomes ENTER.
  - ComputeMD5/SHA1/SHA256 take unsigned char* (a jank string only converts
    to const char*), so one-line cpp/raw shims do the cast. Their returned
    static unsigned int arrays are read with (cpp/aget p (cpp/int i)) -
    the first proven native array subscript in this repo (previously the
    'known-blocked' interop class); the u32 elements box to jank ints
    correctly, verified against the canonical CRC32 / SHA1 / SHA256 test
    vectors of 'The quick brown fox jumps over the lazy dog'. (MD5 shows
    raylib's raw little-endian words, exactly like the C's %08X display.)
    EncodeDataBase64's char* return + int* out-param round-trip lives in a
    shim that copies into a static buffer and MemFrees the malloc'd text
    (the C itself leaks each recompute).
  - The C's %08X becomes a small quot/mod hex loop (rule 3: mod/quot return
    reals, re-int before use)."
  (:include "raylib.h"))

;; Cast jank's const char* to the unsigned char* the hash APIs want, read
;; the returned static u32 arrays element-wise, and own EncodeDataBase64's
;; malloc'd text + int* out-param.
(cpp/raw "static long long jank_crc32(const char* s, int n) { return (long long)ComputeCRC32((unsigned char*)s, n); }
static unsigned int* jank_md5(const char* s, int n) { return ComputeMD5((unsigned char*)s, n); }
static unsigned int* jank_sha1(const char* s, int n) { return ComputeSHA1((unsigned char*)s, n); }
static unsigned int* jank_sha256(const char* s, int n) { return ComputeSHA256((unsigned char*)s, n); }
static const char* jank_b64(const char* s, int n) {
  static char buf[256] = {0};
  int outSize = 0;
  char* b = EncodeDataBase64((const unsigned char*)s, n, &outSize);
  buf[0] = 0;
  if (b != NULL) { if (outSize <= 256) TextCopy(buf, b); MemFree(b); }
  return buf;
}")

(def WIDTH 800)
(def HEIGHT 450)
(def MAX-CHARS 95)                     ; the C's char[96] buffer

;; Characters 32..126 in code order; (subs ASCII (- c 32) (- c 31)) is the
;; one-char string for code c (the input-box trick).
(def ASCII " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~")

(def HEX-DIGITS "0123456789ABCDEF")

(defn- hex8
  "8-digit uppercase hex of a non-negative 32-bit value (the C's %08X)."
  [v]
  (loop [i 0 v (int v) out ""]
    (if (< i 8)
      (let [d (int (mod v 16))]
        (recur (inc i) (int (quot v 16)) (str (subs HEX-DIGITS d (inc d)) out)))
      out)))

(defn- crc32-hex
  "Hex string of the CRC32 of `s`."
  [s]
  (hex8 (cpp/jank_crc32 s (int (count s)))))

(defn- hash-hex
  "Concatenated %08X words of the static u32 array the raylib hash fn for
  `algo` returns over `s` (:md5 4 words, :sha1 5, :sha256 8). The array
  pointer stays a let-local (rule 2)."
  [algo s]
  (let [nw (if (= algo :md5) 4 (if (= algo :sha1) 5 8))
        n (int (count s))
        p (if (= algo :md5)
            (cpp/jank_md5 s n)
            (if (= algo :sha1) (cpp/jank_sha1 s n) (cpp/jank_sha256 s n)))]
    (loop [i 0 out ""]
      (if (< i nw)
        (recur (inc i) (str out (hex8 (cpp/aget p (cpp/int i)))))
        out))))

(defn- b64-str
  "Base64 encoding of `s` folded into a jank string."
  [s]
  (str (cpp/jank_b64 s (int (count s)))))

(defn- draw-row
  "One label + read-only value box row (the C's GuiLabel + GuiTextBox)."
  [y label value]
  (cpp/DrawText label 40 (+ y 11) 10 cpp/DARKGRAY)
  (cpp/DrawRectangle 160 y 600 32 (cpp/Fade cpp/LIGHTGRAY (cpp/float 0.4)))
  (cpp/DrawRectangleLines 160 y 600 32 cpp/GRAY)
  (cpp/DrawText value 168 (+ y 11) 10 cpp/DARKGREEN)
  nil)

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [core] example - compute hash (jank)")
  (cpp/SetTargetFPS 60)

  ;; Thread [input-text hash-map frames-counter]; hashes stay nil until the
  ;; first ENTER, mirroring the C's NULL pointers -> "00000000" display.
  (loop [text "The quick brown fox jumps over the lazy dog." hashes nil fc 0]
    (when (cpp/! (cpp/WindowShouldClose))
      (let [;; drain this frame's typed-character queue
            text (loop [t text]
                   (let [key (int (cpp/GetCharPressed))]
                     (if (> key 0)
                       (recur (if (and (>= key 32) (<= key 125)
                                       (< (count t) MAX-CHARS))
                                (str t (subs ASCII (- key 32) (- key 31)))
                                t))
                       t)))
            text (if (and (cpp/IsKeyPressed cpp/KEY_BACKSPACE) (> (count text) 0))
                   (subs text 0 (- (count text) 1))
                   text)
            hashes (if (cpp/IsKeyPressed cpp/KEY_ENTER)
                     {:crc (crc32-hex text)
                      :md5 (hash-hex :md5 text)
                      :sha1 (hash-hex :sha1 text)
                      :sha256 (hash-hex :sha256 text)
                      :b64 (b64-str text)}
                     hashes)
            h (or hashes {:crc "00000000" :md5 "00000000"
                          :sha1 "00000000" :sha256 "00000000" :b64 ""})
            fc (+ fc 1)]

        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/RAYWHITE)

        (cpp/DrawText "INPUT DATA (TEXT):" 40 32 20 cpp/DARKGRAY)

        ;; the input box (typing is always live)
        (cpp/DrawRectangle 40 64 720 32 (cpp/Fade cpp/LIGHTGRAY (cpp/float 0.4)))
        (cpp/DrawRectangleLines 40 64 720 32 cpp/DARKGRAY)
        (cpp/DrawText text 48 71 20 cpp/MAROON)
        (when (and (< (count text) MAX-CHARS)
                   (= (int (mod (int (quot fc 20)) 2)) 0))
          (cpp/DrawText "_" (int (+ 50.0 (+ 0.0 (cpp/MeasureText text 20)))) 71 20 cpp/MAROON))

        ;; the COMPUTE button, keyboard style
        (cpp/DrawRectangle 40 104 720 32 (cpp/Fade cpp/SKYBLUE (cpp/float 0.5)))
        (cpp/DrawRectangleLines 40 104 720 32 cpp/DARKBLUE)
        (cpp/DrawText "PRESS [ENTER] TO COMPUTE INPUT DATA HASHES" 158 110 20 cpp/DARKBLUE)

        (cpp/DrawText "INPUT DATA HASH VALUES:" 40 166 20 cpp/DARKGRAY)
        (draw-row 200 "CRC32 [32 bit]:" (:crc h))
        (draw-row 236 "MD5 [128 bit]:" (:md5 h))
        (draw-row 272 "SHA1 [160 bit]:" (:sha1 h))
        (draw-row 308 "SHA256 [256 bit]:" (:sha256 h))

        (cpp/DrawText "BONUS - BAS64 ENCODED STRING:" 40 356 10 cpp/DARKBLUE)
        (draw-row 380 "BASE64 ENCODING:" (:b64 h))

        (cpp/EndDrawing)

        (recur text hashes fc))))

  (cpp/CloseWindow))
