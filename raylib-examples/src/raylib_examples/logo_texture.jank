(ns raylib-examples.logo-texture
  "raylib [textures] example - texture loading and drawing, ported to
  jank.

  The raylib logo loaded from a PNG file and drawn centered. Q quits.
  Based on raylib/examples/textures/textures_logo_raylib.c
  (jank-native: FIRST file-loading example - LoadTexture reads the
  PNG from the vendored raylib submodule via a path relative to the
  raylib-examples/ working directory, and the texture's .-width /
  .-height fields center it.)"
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def LOGO "../jank-raylib-sys/raylib/examples/textures/resources/raylib_logo.png")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [textures] example - texture loading and drawing (jank)")
  (cpp/SetTargetFPS 60)

  (let [tex (cpp/LoadTexture LOGO)
        tw (int (+ 0.0 (.-width tex)))
        th (int (+ 0.0 (.-height tex)))]

    (loop []
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/RAYWHITE)

        (cpp/DrawTexture tex
                         (int (/ (- WIDTH tw) 2))
                         (int (/ (- HEIGHT th) 2))
                         cpp/WHITE)

        (cpp/DrawText "this IS a texture loaded from a PNG! (Q quits)" 300 370 10 cpp/GRAY)

        (cpp/EndDrawing)

        (when-not (cpp/IsKeyDown cpp/KEY_Q)
          (recur))))

    (cpp/UnloadTexture tex))

  (cpp/CloseWindow))
