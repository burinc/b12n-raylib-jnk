(ns raylib-examples.eratosthenes-sieve
  "raylib [shaders] example - eratosthenes sieve, ported to jank.

  The Sieve of Eratosthenes computed per-pixel in a fragment shader:
  every pixel maps to a number, primes light up, composites are dimmed
  by their smallest factor. No uniforms, no input - the whole example
  is the shader. ESC quits.
  Based on raylib/examples/shaders/shaders_eratosthenes_sieve.c

  jank-native notes: the C's blank-RenderTexture canvas trick (the
  julia-set pattern) - a black RT drawn through the shader, which
  derives everything from texture coordinates. Simplest shader port
  yet: LoadShader + BeginShaderMode only."
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/shaders/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [shaders] example - eratosthenes sieve (jank)")

  (let [target (cpp/LoadRenderTexture WIDTH HEIGHT)
        shader (cpp/LoadShader cpp/nullptr (str RES "shaders/glsl330/eratosthenes.fs"))]
    (cpp/SetTargetFPS 60)

    (loop []
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/BeginTextureMode target)
        (cpp/ClearBackground cpp/BLACK)
        (cpp/DrawRectangle 0 0 WIDTH HEIGHT cpp/BLACK)
        (cpp/EndTextureMode)

        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/RAYWHITE)
        (cpp/BeginShaderMode shader)
        (cpp/DrawTextureRec (.-texture target)
                            (cpp/Rectangle (cpp/float 0.0) (cpp/float 0.0)
                                           (cpp/float 800.0) (cpp/float -450.0))
                            (cpp/Vector2 (cpp/float 0.0) (cpp/float 0.0)) cpp/WHITE)
        (cpp/EndShaderMode)
        (cpp/EndDrawing)

        (recur)))

    (cpp/UnloadShader shader)
    (cpp/UnloadRenderTexture target))

  (cpp/CloseWindow))
