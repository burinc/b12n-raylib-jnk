(ns raylib-examples.input-keys
  "raylib [core] example - keyboard input, ported to jank.

  Move the ball with the ARROW KEYS; it is clamped to the window.
  Press Q to quit. Based on raylib/examples/core/core_input_keys.c"
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def BALL-RADIUS 50.0)
(def MOVE-SPEED 4.0)

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [core] example - keyboard input (jank)")
  (cpp/SetTargetFPS 60)

  (loop [x (/ WIDTH 2.0)
         y (/ HEIGHT 2.0)]
    (when (cpp/! (cpp/WindowShouldClose))
      (let [x (cond-> x
                (cpp/IsKeyDown cpp/KEY_RIGHT) (+ MOVE-SPEED)
                (cpp/IsKeyDown cpp/KEY_LEFT)  (- MOVE-SPEED))
            y (cond-> y
                (cpp/IsKeyDown cpp/KEY_DOWN)  (+ MOVE-SPEED)
                (cpp/IsKeyDown cpp/KEY_UP)    (- MOVE-SPEED))
            ;; Clamp to the window bounds.
            x (max BALL-RADIUS (min (- WIDTH BALL-RADIUS) x))
            y (max BALL-RADIUS (min (- HEIGHT BALL-RADIUS) y))]

        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/RAYWHITE)
        (cpp/DrawCircle (int x) (int y) (cpp/float BALL-RADIUS) cpp/MAROON)
        (cpp/DrawText "Move the ball with ARROW KEYS" 10 10 20 cpp/DARKGRAY)
        (cpp/DrawText "Press Q to exit" 10 35 20 cpp/GRAY)
        (cpp/EndDrawing)

        (when-not (cpp/IsKeyDown cpp/KEY_Q)
          (recur x y)))))

  (cpp/CloseWindow))
