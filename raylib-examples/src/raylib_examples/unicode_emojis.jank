(ns raylib-examples.unicode-emojis
  "raylib [text] example - unicode emojis, ported to jank.

  A grid of 32 random emojis (Symbola font glyphs, not textures); hover
  lights one up, click it to pop a speech bubble with a message in one
  of a dozen languages (DejaVu for most, Noto CJK for Chinese/Korean/
  Japanese), word-wrapped to the bubble. SPACE re-rolls the emojis and
  messages. ESC quits.
  Based on raylib/examples/text/text_unicode_emojis.c

  jank-native notes:
  - The C embeds 180 emojis as a \\0-separated UTF-8 byte blob and walks
    char* offsets; the port stores plain codepoint ints (decoded from the
    C source) and draws each with DrawTextCodepoint. The 47 messages are
    real UTF-8 literals (proven in codepoints-loading).
  - The C's DrawTextBoxed walks UTF-8 bytes; jank strings are opaque
    here, so the bubble text goes through LoadCodepoints (int* +
    out-param), advances come from glyphs[i].advanceX / recs[i].width
    via struct-array cpp/aget, and a pure-jank greedy breaker
    (break-lines) wraps at codepoint level - hard \\n breaks, last-space
    word wrap, mid-word fallback (safe for the spaceless CJK messages).
  - Emoji colors are Fade(ColorFromHSV(hue)) rebuilt inline at each draw
    from a stored hue int (rule 2); the message font is picked with an
    (if asian? font-asian font-default) let-local (same-type native
    branches are fine).
  - All three BMFonts are create-once outer-let locals; no cpp/raw
    statics anywhere, so helper fns are safe.
  - The C's FLAG_MSAA_4X_HINT | FLAG_VSYNC_HINT becomes the literal 96
    (0x20 | 0x40) - jank has no bitwise-or over enum constants.
  - Faithful quirk kept: the C's grid puts 9 emojis on the first row
    (the newline check runs after drawing element i%8==0)."
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/text/resources/")
(def EMOJI-COUNT 32)

;; The C's emojiCodepoints blob, decoded to plain codepoints.
(def EMOJI-CPS
  [127744 128512 128514 129315 128515 128518 128521 128523 128526 128525
   128536 128535 128537 128538 128578 129303 129321 129300 129320 128528
   128529 128566 128580 128527 128547 128549 128558 129296 128559 128554
   128555 128564 128524 128539 128541 129316 128530 128533 128579 129297
   128562 128577 128534 128542 128543 128548 128546 128557 128550 128553
   129327 128556 128560 128561 128563 129322 128565 128545 128544 129324
   128567 129298 129301 129314 129326 129319 128519 129312 129323 129325
   129488 129299 128520 128127 128121 128122 128128 128123 128125 128126
   129302 128169 128570 128568 128569 128571 128573 128576 128575 127806
   127807 127808 127811 127815 127827 129373 127813 129381 129361 127814
   129364 129365 127805 127798 129362 129382 127812 129372 127792 127838
   129360 129366 129384 129374 129472 127830 127831 129385 129363 127828
   127839 127829 127789 129386 127790 127791 129369 129370 127859 129368
   127858 129379 129367 127871 129387 127857 127832 127837 127840 127842
   127845 127841 129375 129377 127846 127850 127874 127856 129383 127851
   127855 127868 129371 127861 127862 127870 127863 127867 129346 129347
   129380 129378 128065 128069 128068 128139 128152 128147 128151 128153
   128155 129505 128156 128420 128157 128159 128140 128164 128162 128163])

;; The C messages array, hex escapes decoded to UTF-8.
(def MESSAGES
  [["Falsches Üben von Xylophonmusik quält jeden größeren Zwerg" "German"]
   ["Beiß nicht in die Hand, die dich füttert." "German"]
   ["Außerordentliche Übel erfordern außerordentliche Mittel." "German"]
   ["Կրնամ ապակի ուտել և ինծի անհանգիստ չըներ" "Armenian"]
   ["Երբ որ կացինը եկաւ անտառ, ծառերը ասացին... «Կոտը մերոնցից է:»" "Armenian"]
   ["Գառը՝ գարնան, ձիւնը՝ ձմռան" "Armenian"]
   ["Jeżu klątw, spłódź Finom część gry hańb!" "Polish"]
   ["Dobrymi chęciami jest piekło wybrukowane." "Polish"]
   ["Îți mulțumesc că ai ales raylib.\nȘi sper să ai o zi bună!" "Romanian"]
   ["Эх, чужак, общий съём цен шляп (юфть) вдрызг!" "Russian"]
   ["Я люблю raylib!" "Russian"]
   ["Молчи, скрывайся и таи\nИ чувства и мечты свои –\nПускай в душевной глубине\nИ всходят и зайдут оне\nКак звезды ясные в ночи-\nЛюбуйся ими – и молчи." "Russian"]
   ["Voix ambiguë d’un cœur qui au zéphyr préfère les jattes de kiwi" "French"]
   ["Benjamín pidió una bebida de kiwi y fresa; Noé, sin vergüenza, la más exquisita champaña del menú." "Spanish"]
   ["Ταχίστη αλώπηξ βαφής ψημένη γη, δρασκελίζει υπέρ νωθρού κυνός" "Greek"]
   ["Η καλύτερη άμυνα είναι η επίθεση." "Greek"]
   ["Χρόνια και ζαμάνια!" "Greek"]
   ["Πώς τα πας σήμερα;" "Greek"]
   ["我能吞下玻璃而不伤身体。" "Chinese"]
   ["你吃了吗？" "Chinese"]
   ["不作不死。" "Chinese"]
   ["最近好吗？" "Chinese"]
   ["塞翁失马，焉知非福。" "Chinese"]
   ["千军易得, 一将难求" "Chinese"]
   ["万事开头难。" "Chinese"]
   ["风无常顺，兵无常胜。" "Chinese"]
   ["活到老，学到老。" "Chinese"]
   ["一言既出，驷马难追。" "Chinese"]
   ["路遥知马力，日久见人心" "Chinese"]
   ["有理走遍天下，无理寸步难行。" "Chinese"]
   ["猿も木から落ちる" "Japanese"]
   ["亀の甲より年の功" "Japanese"]
   ["うらやまし  思ひ切る時  猫の恋" "Japanese"]
   ["虎穴に入らずんば虎子を得ず。" "Japanese"]
   ["二兎を追う者は一兎をも得ず。" "Japanese"]
   ["馬鹿は死ななきゃ治らない。" "Japanese"]
   ["枯野路に　影かさなりて　わかれけり" "Japanese"]
   ["繰り返し麦の畝縫ふ胡蝶哉" "Japanese"]
   ["아득한 바다 위에 갈매기 두엇 날아 돈다.\n너훌너훌 시를 쓴다. 모르는 나라 글자다.\n널따란 하늘 복판에 나도 같이 시를 쓴다." "Korean"]
   ["제 눈에 안경이다" "Korean"]
   ["꿩 먹고 알 먹는다" "Korean"]
   ["로마는 하루아침에 이루어진 것이 아니다" "Korean"]
   ["고생 끝에 낙이 온다" "Korean"]
   ["개천에서 용 난다" "Korean"]
   ["안녕하세요?" "Korean"]
   ["만나서 반갑습니다" "Korean"]
   ["한국말 하실 줄 아세요?" "Korean"]])

(defn- randomize-emojis
  "The C's RandomizeEmoji: 32 maps of random codepoint index / message /
  hue (one shared random start spins the hue wheel per slot)."
  []
  (let [start (int (cpp/GetRandomValue 45 360))]
    (loop [i 0 acc []]
      (if (< i EMOJI-COUNT)
        (recur (inc i)
               (conj acc {:cp (nth EMOJI-CPS (int (cpp/GetRandomValue 0 179)))
                          :msg (int (cpp/GetRandomValue 0 (dec (count MESSAGES))))
                          :hue (int (mod (* start (inc i)) 360))}))
        acc))))

(defn- break-lines
  "Greedy codepoint word-wrap: [start end] index pairs of lines of `cps`
  (per-codepoint advances `advs`) fitting `width`. Hard-breaks on
  newline (10), prefers the last space, falls back mid-word (the
  spaceless CJK case)."
  [cps advs width]
  (let [n (count cps)]
    (loop [k 0 start 0 w 0.0 last-sp -1 acc []]
      (if (< k n)
        (let [cp (nth cps k)
              a (nth advs k)]
          (cond
            (= cp 10)
            (recur (inc k) (inc k) 0.0 -1 (conj acc [start k]))
            (> (+ w a) width)
            (if (>= last-sp start)
              (recur (inc last-sp) (inc last-sp) 0.0 -1 (conj acc [start last-sp]))
              (if (> k start)
                (recur k k 0.0 -1 (conj acc [start k]))
                (recur (inc k) (inc k) 0.0 -1 (conj acc [start (inc k)]))))
            :else
            (recur (inc k) start (+ w a) (if (= cp 32) k last-sp) acc)))
        (conj acc [start n])))))

(defn -main [& args]
  ;; FLAG_MSAA_4X_HINT (0x20) | FLAG_VSYNC_HINT (0x40)
  (cpp/SetConfigFlags 96)
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [text] example - unicode emojis (jank)")

  (let [font-default (cpp/LoadFont (str RES "dejavu.fnt"))
        font-asian (cpp/LoadFont (str RES "noto_cjk.fnt"))
        font-emoji (cpp/LoadFont (str RES "symbola.fnt"))
        esize (+ 0.0 (.-baseSize font-emoji))]
    (cpp/SetTargetFPS 60)

    ;; Thread [emojis selected sel-x sel-y hovered hov-x hov-y]; hovered
    ;; carries over from the previous frame's draw, like the C's global.
    (loop [emojis (randomize-emojis) selected -1 sel-x 0.0 sel-y 0.0
           hovered -1 hov-x 0.0 hov-y 0.0]
      (when (cpp/! (cpp/WindowShouldClose))
        (let [space? (if (cpp/IsKeyPressed cpp/KEY_SPACE) true false)
              emojis (if space? (randomize-emojis) emojis)
              selected (if space? -1 selected)
              hovered (if space? -1 hovered)
              click? (if (cpp/IsMouseButtonPressed cpp/MOUSE_BUTTON_LEFT) true false)
              pick? (and click? (not= hovered -1) (not= hovered selected))
              selected (if pick? hovered selected)
              sel-x (if pick? hov-x sel-x)
              sel-y (if pick? hov-y sel-y)
              mouse (cpp/Vector2 (cpp/float (+ 0.0 (cpp/GetMouseX)))
                                 (cpp/float (+ 0.0 (cpp/GetMouseY))))]

          (cpp/BeginDrawing)
          (cpp/ClearBackground cpp/RAYWHITE)

          ;; emoji grid; returns the newly-hovered slot + its position
          (let [grid (loop [i 0 x 28.8 y 10.0 hov -1 hx 0.0 hy 0.0]
                       (if (< i EMOJI-COUNT)
                         (let [e (nth emojis i)
                               over? (if (cpp/CheckCollisionPointRec
                                          mouse (cpp/Rectangle (cpp/float x) (cpp/float y)
                                                               (cpp/float esize) (cpp/float esize)))
                                       true false)]
                           (cpp/DrawTextCodepoint
                            font-emoji (:cp e)
                            (cpp/Vector2 (cpp/float x) (cpp/float y))
                            (cpp/float esize)
                            (if (or over? (= selected i))
                              (cpp/Fade (cpp/ColorFromHSV (cpp/float (+ 0.0 (:hue e)))
                                                          (cpp/float 0.6) (cpp/float 0.85))
                                        (cpp/float 0.8))
                              (cpp/Fade cpp/LIGHTGRAY (cpp/float 0.4))))
                           (let [hov (if over? i hov)
                                 hx (if over? x hx)
                                 hy (if over? y hy)]
                             ;; faithful C quirk: newline check on the slot
                             ;; just drawn, so the first row holds 9
                             (if (and (not= i 0) (= (int (mod i 8)) 0))
                               (recur (inc i) 28.8 (+ y esize 24.25) hov hx hy)
                               (recur (inc i) (+ x esize 28.8) y hov hx hy))))
                         [hov hx hy]))
                hovered (nth grid 0)
                hov-x (nth grid 1)
                hov-y (nth grid 2)]

            ;; speech bubble for the selected emoji
            (when (not= selected -1)
              (let [e (nth emojis selected)
                    msg (nth MESSAGES (:msg e))
                    text (nth msg 0)
                    lang (nth msg 1)
                    asian? (or (= lang "Chinese") (= lang "Korean") (= lang "Japanese"))
                    font (if asian? font-asian font-default)
                    fsize (+ 0.0 (.-baseSize font))
                    msz (cpp/MeasureTextEx font text (cpp/float fsize) (cpp/float 1.0))
                    szx0 (+ 0.0 (.-x msz))
                    szy0 (+ 0.0 (.-y msz))
                    szy (if (> szx0 300.0) (* szy0 (/ szx0 300.0)) szy0)
                    szx (cond (> szx0 300.0) 300.0
                              (< szx0 160.0) 160.0
                              :else szx0)
                    mw (+ 40.0 szx)
                    mh (+ 60.0 szy)
                    mx0 (- sel-x 38.8)
                    mx1 (if (< mx0 10.0) (+ mx0 28.0) mx0)
                    my0 (- sel-y mh)
                    below? (< my0 10.0)
                    my (if below? (+ sel-y 84.0) my0)
                    mx (if (> (+ mx1 mw) 800.0)
                         (- mx1 (+ (- (+ mx1 mw) 800.0) 10.0))
                         mx1)
                    ;; bubble triangle (flipped + vertex-swapped below)
                    tri (if below?
                          [[(+ sel-x 8.0) (- my 10.0)] [sel-x my] [(+ sel-x 10.0) my]]
                          [[sel-x (+ my mh)] [(+ sel-x 8.0) (+ my mh 10.0)] [(+ sel-x 10.0) (+ my mh)]])
                    tx (+ mx 10.0)
                    ty (+ my 15.0)
                    tw (- mw 20.0)

                    ;; message codepoints + per-codepoint advances
                    ncp-out (cpp/int 0)
                    cp-ptr (cpp/LoadCodepoints text (cpp/& ncp-out))
                    ncp (int (+ 0.0 ncp-out))
                    cps (loop [k 0 acc []]
                          (if (< k ncp)
                            (recur (inc k) (conj acc (int (cpp/aget cp-ptr (cpp/int k)))))
                            acc))
                    advs (loop [k 0 acc []]
                           (if (< k ncp)
                             (let [cp (nth cps k)
                                   idx (int (cpp/GetGlyphIndex font cp))
                                   g (cpp/aget (.-glyphs font) (cpp/int idx))
                                   adv (int (.-advanceX g))
                                   a (if (= adv 0)
                                       (let [rc (cpp/aget (.-recs font) (cpp/int idx))]
                                         (+ (+ 0.0 (.-width rc)) 1.0))
                                       (+ 0.0 adv 1.0))]
                               (recur (inc k) (conj acc a)))
                             acc))
                    lines (break-lines cps advs tw)
                    bytes-n (int (+ 0.0 (cpp/TextLength text)))
                    info (str lang " " ncp " characters " bytes-n " bytes")
                    isz (cpp/MeasureTextEx (cpp/GetFontDefault) info (cpp/float 10.0) (cpp/float 1.0))]
                (cpp/UnloadCodepoints cp-ptr)

                (cpp/DrawRectangleRec
                 (cpp/Rectangle (cpp/float mx) (cpp/float my) (cpp/float mw) (cpp/float mh))
                 (cpp/Fade (cpp/ColorFromHSV (cpp/float (+ 0.0 (:hue e)))
                                             (cpp/float 0.6) (cpp/float 0.85))
                           (cpp/float 0.8)))
                (cpp/DrawTriangle
                 (cpp/Vector2 (cpp/float (nth (nth tri 0) 0)) (cpp/float (nth (nth tri 0) 1)))
                 (cpp/Vector2 (cpp/float (nth (nth tri 1) 0)) (cpp/float (nth (nth tri 1) 1)))
                 (cpp/Vector2 (cpp/float (nth (nth tri 2) 0)) (cpp/float (nth (nth tri 2) 1)))
                 (cpp/Fade (cpp/ColorFromHSV (cpp/float (+ 0.0 (:hue e)))
                                             (cpp/float 0.6) (cpp/float 0.85))
                           (cpp/float 0.8)))

                ;; the wrapped message, codepoint by codepoint
                (loop [li 0]
                  (when (< li (count lines))
                    (let [se (nth lines li)
                          ls (nth se 0)
                          le (nth se 1)
                          ly (+ ty (* li 1.5 fsize))]
                      (loop [k ls lx tx]
                        (when (< k le)
                          (cpp/DrawTextCodepoint font (nth cps k)
                                                 (cpp/Vector2 (cpp/float lx) (cpp/float ly))
                                                 (cpp/float fsize) cpp/WHITE)
                          (recur (inc k) (+ lx (nth advs k))))))
                    (recur (inc li))))

                ;; language/length info, bottom-right of the bubble
                (cpp/DrawText info
                              (int (- (+ tx tw) (+ 0.0 (.-x isz))))
                              (int (- (+ my mh) (+ 0.0 (.-y isz)) 2.0))
                              10 cpp/RAYWHITE)))

            (cpp/DrawText "These emojis have something to tell you, click each to find out!"
                          75 (- HEIGHT 40) 20 cpp/GRAY)
            (cpp/DrawText "Each emoji is a unicode character from a font, not a texture... Press [SPACEBAR] to refresh"
                          158 (- HEIGHT 16) 10 cpp/GRAY)

            (cpp/EndDrawing)

            (recur emojis selected sel-x sel-y hovered hov-x hov-y)))))

    (cpp/UnloadFont font-default)
    (cpp/UnloadFont font-asian)
    (cpp/UnloadFont font-emoji))

  (cpp/CloseWindow))
