(ns raylib-examples.fog-rendering
  "raylib [shaders] example - fog rendering, ported to jank.

  A spinning torus, a cube and a sphere (plus a receding row of
  toruses) in exponential-squared fog under one point light; UP/DOWN
  change the fog density. Orbital camera. ESC quits.
  Based on raylib/examples/shaders/shaders_fog_rendering.c

  jank-native notes:
  - Lights come from the rlights namespace: light
    creation, viewPos push, shader.locs writes and all uniforms come
    from the header. Material texture/shader writes go through
    models.jank; the torus's per-frame transform spin is a cpp/=
    read-modify-write (MatrixMultiply/MatrixRotate via raymath.h).
  - ColorNormalize(GRAY) reduces to (/ 130.0 255.0) components sent
    with sh/set-vec4!; fog density threads through recur as a
    jank real, clamped in jank."
  (:require [raylib-examples.models :as md]
            [clojure.string :as string])
  (:require [raylib-examples.rlights :as rl]
            [raylib-examples.shaders :as sh])
  (:include "raylib.h" "raymath.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/shaders/resources/")

(defn- fmt2
  "The C's %.2f, via trimming str two digits past the dot."
  [v]
  (let [s (str v)
        dot (string/index-of s ".")]
    (if dot (subs s 0 (min (count s) (+ dot 3))) s)))

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_MSAA_4X_HINT)
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [shaders] example - fog rendering (jank)")

  (let [camera (cpp/Camera3D (cpp/Vector3 (cpp/float 2.0) (cpp/float 2.0) (cpp/float 6.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.5) (cpp/float 0.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 45.0)
                             cpp/CAMERA_PERSPECTIVE)
        model-a (cpp/LoadModelFromMesh (cpp/GenMeshTorus (cpp/float 0.4) (cpp/float 1.0) 16 32))
        model-b (cpp/LoadModelFromMesh (cpp/GenMeshCube (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0)))
        model-c (cpp/LoadModelFromMesh (cpp/GenMeshSphere (cpp/float 0.5) 32 32))
        texture (cpp/LoadTexture (str RES "texel_checker.png"))
        shader (cpp/LoadShader (str RES "shaders/glsl330/lighting.vs")
                               (str RES "shaders/glsl330/fog.fs"))
        ;; boxed here, where the shader is still native (see rlights ns)
        sh-box (cpp/box (cpp/new cpp/Shader shader))
        view-loc (int (cpp/GetShaderLocation shader "viewPos"))
        ambient-loc (int (cpp/GetShaderLocation shader "ambient"))
        fog-color-loc (int (cpp/GetShaderLocation shader "fogColor"))
        fog-density-loc (int (cpp/GetShaderLocation shader "fogDensity"))]

    (md/set-texture! (cpp/box (cpp/new cpp/Model model-a)) (cpp/box (cpp/new cpp/Texture2D texture)))
    (md/set-texture! (cpp/box (cpp/new cpp/Model model-b)) (cpp/box (cpp/new cpp/Texture2D texture)))
    (md/set-texture! (cpp/box (cpp/new cpp/Model model-c)) (cpp/box (cpp/new cpp/Texture2D texture)))

    (sh/set-shader-loc! sh-box cpp/SHADER_LOC_MATRIX_MODEL
                                (int (cpp/GetShaderLocation shader "matModel")))
    (sh/set-shader-loc! sh-box cpp/SHADER_LOC_VECTOR_VIEW view-loc)

    (sh/set-vec4! sh-box ambient-loc 0.2 0.2 0.2 1.0)
    ;; ColorNormalize(GRAY) = 130/255 per channel
    (let [g (/ 130.0 255.0)]
      (sh/set-vec4! sh-box fog-color-loc g g g 1.0))

    (md/set-shader! (cpp/box (cpp/new cpp/Model model-a)) 0 (cpp/box (cpp/new cpp/Shader shader)))
    (md/set-shader! (cpp/box (cpp/new cpp/Model model-b)) 0 (cpp/box (cpp/new cpp/Shader shader)))
    (md/set-shader! (cpp/box (cpp/new cpp/Model model-c)) 0 (cpp/box (cpp/new cpp/Shader shader)))

    ;; one white point light
    (rl/create-light! {:type rl/LIGHT-POINT
                                      :px 0.0 :py 2.0 :pz 6.0
                                      :tx 0.0 :ty 0.0 :tz 0.0
                                      :r 255 :g 255 :b 255 :a 255
                                      :shader sh-box})

    (cpp/SetTargetFPS 60)

    ;; Thread [fog-density].
    (loop [fog-density 0.15]
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/UpdateCamera (cpp/& camera) cpp/CAMERA_ORBITAL)

        (let [fog-density (cond (cpp/IsKeyDown cpp/KEY_UP) (+ fog-density 0.001)
                                (cpp/IsKeyDown cpp/KEY_DOWN) (- fog-density 0.001)
                                :else fog-density)
              fog-density (if (> fog-density 1.0) 1.0 (if (< fog-density 0.0) 0.0 fog-density))]

          (sh/set-float! sh-box fog-density-loc fog-density)
          (cpp/= (.-transform model-a)
                 (cpp/MatrixMultiply (.-transform model-a) (cpp/MatrixRotateX (cpp/float -0.025))))
          (cpp/= (.-transform model-a)
                 (cpp/MatrixMultiply (.-transform model-a) (cpp/MatrixRotateZ (cpp/float 0.012))))
          (let [p (.-position camera)]
            (rl/push-view-pos! sh-box view-loc (.-x p) (.-y p) (.-z p)))

          (cpp/BeginDrawing)
          (cpp/ClearBackground cpp/GRAY)

          (cpp/BeginMode3D camera)
          (cpp/DrawModel model-a
                         (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                         (cpp/float 1.0) cpp/WHITE)
          (cpp/DrawModel model-b
                         (cpp/Vector3 (cpp/float -2.6) (cpp/float 0.0) (cpp/float 0.0))
                         (cpp/float 1.0) cpp/WHITE)
          (cpp/DrawModel model-c
                         (cpp/Vector3 (cpp/float 2.6) (cpp/float 0.0) (cpp/float 0.0))
                         (cpp/float 1.0) cpp/WHITE)
          ;; a receding row of toruses into the fog
          (loop [i -20]
            (when (< i 20)
              (cpp/DrawModel model-a
                             (cpp/Vector3 (cpp/float (+ 0.0 i)) (cpp/float 0.0) (cpp/float 2.0))
                             (cpp/float 1.0) cpp/WHITE)
              (recur (+ i 2))))
          (cpp/EndMode3D)

          (cpp/DrawText (str "Use KEY_UP/KEY_DOWN to change fog density [" (fmt2 fog-density) "]")
                        10 10 20 cpp/RAYWHITE)

          (cpp/EndDrawing)
          (recur fog-density))))

    (cpp/UnloadModel model-a)
    (cpp/UnloadModel model-b)
    (cpp/UnloadModel model-c)
    (cpp/UnloadTexture texture)
    (cpp/UnloadShader shader))

  (cpp/CloseWindow))
