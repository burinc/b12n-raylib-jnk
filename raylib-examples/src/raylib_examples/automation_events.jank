(ns raylib-examples.automation-events
  "raylib [core] example - automation events, ported to jank.

  A small platformer whose input can be RECORDED and REPLAYED. Arrow
  keys move, SPACE jumps, R resets, S starts/stops recording (exported
  to automation.rae), A replays the last recording, and dropping a
  .rae/.txt file loads and replays it. Mouse wheel zooms. ESC quits.
  Based on raylib/examples/core/core_automation_events.c

  jank-native notes:
  - The player, the five environment elements and all the recording
    state are plain jank data: a Vector2 is two numbers and a Rectangle
    is four, so the whole simulation threads through recur with nothing
    boxed.
  - Two things are genuinely native. The Camera2D is boxed because
    BeginMode2D and GetWorldToScreen2D want the struct. The
    AutomationEventList is boxed IN AN ATOM, because dropping a file
    replaces it at runtime and a create-once let-local could not be
    rebound (the viewport-scaling pattern).
  - An AutomationEvent is read out of the list with cpp/aget and passed
    straight to PlayAutomationEvent in the same form, so it never has to
    cross a fn boundary.
  - TextFormat is variadic and unavailable, so the two readouts are str."
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)

(def ^:private GRAVITY 400.0)
(def ^:private JUMP-SPD 350.0)
(def ^:private HOR-SPD 200.0)
(def ^:private DELTA 0.015) ;; fixed timestep keeps replay deterministic

(def ^:private ENV
  [{:x 0.0   :y 0.0   :w 1000.0 :h 400.0 :blocking? false :color :light}
   {:x 0.0   :y 400.0 :w 1000.0 :h 200.0 :blocking? true  :color :gray}
   {:x 300.0 :y 200.0 :w 400.0  :h 10.0  :blocking? true  :color :gray}
   {:x 250.0 :y 300.0 :w 100.0  :h 10.0  :blocking? true  :color :gray}
   {:x 650.0 :y 300.0 :w 100.0  :h 10.0  :blocking? true  :color :gray}])

(def ^:private START-PLAYER {:x 400.0 :y 280.0 :speed 0.0 :can-jump? false})

(defn- set-camera!
  [cam-box tx ty ox oy zoom]
  (let [c (cpp/* (cpp/unbox (:* cpp/Camera2D) cam-box))]
    (cpp/= (.-x (.-target c)) (cpp/float tx))
    (cpp/= (.-y (.-target c)) (cpp/float ty))
    (cpp/= (.-x (.-offset c)) (cpp/float ox))
    (cpp/= (.-y (.-offset c)) (cpp/float oy))
    (cpp/= (.-rotation c) (cpp/float 0.0))
    (cpp/= (.-zoom c) (cpp/float zoom)))
  nil)

(defn- world->screen
  "GetWorldToScreen2D against the boxed camera, in and out as numbers."
  [cam-box x y]
  (let [c (cpp/* (cpp/unbox (:* cpp/Camera2D) cam-box))
        v (cpp/GetWorldToScreen2D (cpp/Vector2 (cpp/float x) (cpp/float y)) c)]
    [(+ 0.0 (.-x v)) (+ 0.0 (.-y v))]))

(defn- step-player
  "Horizontal input, jump, then the C's blocking-element scan and gravity."
  [p]
  (let [x (cond (cpp/IsKeyDown cpp/KEY_LEFT) (- (:x p) (* HOR-SPD DELTA))
                (cpp/IsKeyDown cpp/KEY_RIGHT) (+ (:x p) (* HOR-SPD DELTA))
                :else (:x p))
        [speed can-jump?] (if (and (cpp/IsKeyDown cpp/KEY_SPACE) (:can-jump? p))
                            [(- 0.0 JUMP-SPD) false]
                            [(:speed p) (:can-jump? p)])
        hit (loop [i 0]
              (when (< i (count ENV))
                (let [e (nth ENV i)]
                  (if (and (:blocking? e)
                           (<= (:x e) x)
                           (>= (+ (:x e) (:w e)) x)
                           (>= (:y e) (:y p))
                           (<= (:y e) (+ (:y p) (* speed DELTA))))
                    e
                    (recur (inc i))))))]
    (if hit
      {:x x :y (:y hit) :speed 0.0 :can-jump? true}
      {:x x :y (+ (:y p) (* speed DELTA))
       :speed (+ speed (* GRAVITY DELTA))
       :can-jump? false})))

(defn- frame-of
  "The frame number of event i in the boxed list."
  [list-box i]
  (int (+ 0.0 (.-frame (cpp/aget (.-events (cpp/* (cpp/unbox (:* cpp/AutomationEventList) list-box)))
                                 (cpp/int i))))))

(defn- event-count [list-box]
  (int (+ 0.0 (.-count (cpp/* (cpp/unbox (:* cpp/AutomationEventList) list-box))))))

(defn- play-due!
  "Fire every event scheduled for this playback frame, as the C's while
  loop does. Returns [playing? current-frame]."
  [list-box play-counter current]
  (let [n (event-count list-box)]
    (loop [cur current]
      (if (and (< cur n) (= play-counter (frame-of list-box cur)))
        (do
          (cpp/PlayAutomationEvent
           (cpp/aget (.-events (cpp/* (cpp/unbox (:* cpp/AutomationEventList) list-box)))
                     (cpp/int cur)))
          (let [nxt (inc cur)]
            (if (= nxt n)
              (do (cpp/TraceLog cpp/LOG_INFO "FINISH PLAYING!") [false 0])
              (recur nxt))))
        [true cur]))))

(defn- camera-offset
  "Frame the whole level: clamp the camera so the level edges stay in
  view, exactly as the C does after the zoom clamp."
  [cam-box]
  (let [[min-x min-y max-x max-y]
        (loop [i 0 nx 1000.0 ny 1000.0 xx -1000.0 xy -1000.0]
          (if (< i (count ENV))
            (let [e (nth ENV i)]
              (recur (inc i)
                     (min (:x e) nx) (min (:y e) ny)
                     (max (+ (:x e) (:w e)) xx) (max (+ (:y e) (:h e)) xy)))
            [nx ny xx xy]))
        [max-sx max-sy] (world->screen cam-box max-x max-y)
        [min-sx min-sy] (world->screen cam-box min-x min-y)
        ox (/ WIDTH 2.0)
        oy (/ HEIGHT 2.0)
        ox (if (< max-sx WIDTH) (- WIDTH (- max-sx (/ WIDTH 2.0))) ox)
        oy (if (< max-sy HEIGHT) (- HEIGHT (- max-sy (/ HEIGHT 2.0))) oy)
        ox (if (> min-sx 0.0) (- (/ WIDTH 2.0) min-sx) ox)
        oy (if (> min-sy 0.0) (- (/ HEIGHT 2.0) min-sy) oy)]
    [ox oy]))

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [core] example - automation events (jank)")

  (let [cam-box (cpp/box (cpp/new cpp/Camera2D))
        ;; the list is replaced when a file is dropped, so the box lives
        ;; in an atom rather than a create-once let-local
        list-atom (atom (cpp/box (cpp/new cpp/AutomationEventList
                                          (cpp/LoadAutomationEventList cpp/nullptr))))]
    (cpp/SetAutomationEventList (cpp/unbox (:* cpp/AutomationEventList) @list-atom))
    (set-camera! cam-box (:x START-PLAYER) (:y START-PLAYER)
                 (/ WIDTH 2.0) (/ HEIGHT 2.0) 1.0)
    (cpp/SetTargetFPS 60)

    ;; Thread [player recording? playing? frames play-counter current zoom].
    (loop [player START-PLAYER
           recording? false
           playing? false
           frames 0
           play-counter 0
           current 0
           zoom 1.0]
      (when (cpp/! (cpp/WindowShouldClose))
        (let [;; dropped .rae/.txt: swap the list and replay it
              [player recording? playing? play-counter current]
              (if (cpp/IsFileDropped)
                (let [dropped (cpp/LoadDroppedFiles)
                      path (cpp/aget (.-paths dropped) (cpp/int 0))
                      ok? (cpp/IsFileExtension path ".txt;.rae")
                      r (if ok?
                          (do (cpp/UnloadAutomationEventList
                               (cpp/* (cpp/unbox (:* cpp/AutomationEventList) @list-atom)))
                              (reset! list-atom
                                      (cpp/box (cpp/new cpp/AutomationEventList
                                                        (cpp/LoadAutomationEventList path))))
                              (cpp/SetAutomationEventList
                               (cpp/unbox (:* cpp/AutomationEventList) @list-atom))
                              [START-PLAYER false true 0 0])
                          [player recording? playing? play-counter current])]
                  (cpp/UnloadDroppedFiles dropped)
                  r)
                [player recording? playing? play-counter current])

              player (step-player player)
              player (if (cpp/IsKeyPressed cpp/KEY_R) START-PLAYER player)

              ;; replay before the camera update: an event can set the wheel
              [playing? current play-counter]
              (if playing?
                (let [[p c] (play-due! @list-atom play-counter current)]
                  [p c (if p (inc play-counter) 0)])
                [playing? current play-counter])

              zoom (let [z (+ zoom (* (+ 0.0 (cpp/GetMouseWheelMove)) 0.05))]
                     (if (> z 3.0) 3.0 (if (< z 0.25) 0.25 z)))
              _ (set-camera! cam-box (:x player) (:y player)
                             (/ WIDTH 2.0) (/ HEIGHT 2.0) zoom)
              [ox oy] (camera-offset cam-box)
              _ (set-camera! cam-box (:x player) (:y player) ox oy zoom)

              ;; S toggles recording, A replays
              [recording? playing? play-counter current player]
              (cond
                (cpp/IsKeyPressed cpp/KEY_S)
                (if playing?
                  [recording? playing? play-counter current player]
                  (if recording?
                    (do (cpp/StopAutomationEventRecording)
                        (cpp/ExportAutomationEventList
                         (cpp/* (cpp/unbox (:* cpp/AutomationEventList) @list-atom))
                         "automation.rae")
                        (cpp/TraceLog cpp/LOG_INFO
                                      (str "RECORDED FRAMES: " (event-count @list-atom)))
                        [false playing? play-counter current player])
                    (do (cpp/SetAutomationEventBaseFrame 180)
                        (cpp/StartAutomationEventRecording)
                        [true playing? play-counter current player])))

                (cpp/IsKeyPressed cpp/KEY_A)
                (if (and (not recording?) (> (event-count @list-atom) 0))
                  [recording? true 0 0 START-PLAYER]
                  [recording? playing? play-counter current player])

                :else [recording? playing? play-counter current player])

              frames (if (or recording? playing?) (inc frames) 0)]

          (cpp/BeginDrawing)
          (cpp/ClearBackground cpp/LIGHTGRAY)

          (cpp/BeginMode2D (cpp/* (cpp/unbox (:* cpp/Camera2D) cam-box)))
          (loop [i 0]
            (when (< i (count ENV))
              (let [e (nth ENV i)]
                (cpp/DrawRectangleRec
                 (cpp/Rectangle (cpp/float (:x e)) (cpp/float (:y e))
                                (cpp/float (:w e)) (cpp/float (:h e)))
                 (if (= (:color e) :light) cpp/LIGHTGRAY cpp/GRAY)))
              (recur (inc i))))
          (cpp/DrawRectangleRec
           (cpp/Rectangle (cpp/float (- (:x player) 20.0)) (cpp/float (- (:y player) 40.0))
                          (cpp/float 40.0) (cpp/float 40.0))
           cpp/RED)
          (cpp/EndMode2D)

          (cpp/DrawRectangle 10 10 290 145 (cpp/Fade cpp/SKYBLUE (cpp/float 0.5)))
          (cpp/DrawRectangleLines 10 10 290 145 (cpp/Fade cpp/BLUE (cpp/float 0.8)))
          (cpp/DrawText "Controls:" 20 20 10 cpp/BLACK)
          (cpp/DrawText "- RIGHT | LEFT: Player movement" 30 40 10 cpp/DARKGRAY)
          (cpp/DrawText "- SPACE: Player jump" 30 60 10 cpp/DARKGRAY)
          (cpp/DrawText "- R: Reset game state" 30 80 10 cpp/DARKGRAY)
          (cpp/DrawText "- S: START/STOP RECORDING INPUT EVENTS" 30 110 10 cpp/BLACK)
          (cpp/DrawText "- A: REPLAY LAST RECORDED INPUT EVENTS" 30 130 10 cpp/BLACK)

          (cond
            recording?
            (do (cpp/DrawRectangle 10 160 290 30 (cpp/Fade cpp/RED (cpp/float 0.3)))
                (cpp/DrawRectangleLines 10 160 290 30 (cpp/Fade cpp/MAROON (cpp/float 0.8)))
                (cpp/DrawCircle 30 175 (cpp/float 10.0) cpp/MAROON)
                (when (= (int (rem (int (quot frames 15)) 2)) 1)
                  (cpp/DrawText (str "RECORDING EVENTS... [" (event-count @list-atom) "]")
                                50 170 10 cpp/MAROON)))
            playing?
            (do (cpp/DrawRectangle 10 160 290 30 (cpp/Fade cpp/LIME (cpp/float 0.3)))
                (cpp/DrawRectangleLines 10 160 290 30 (cpp/Fade cpp/DARKGREEN (cpp/float 0.8)))
                (cpp/DrawTriangle (cpp/Vector2 (cpp/float 20.0) (cpp/float 165.0))
                                  (cpp/Vector2 (cpp/float 20.0) (cpp/float 185.0))
                                  (cpp/Vector2 (cpp/float 40.0) (cpp/float 175.0))
                                  cpp/DARKGREEN)
                (when (= (int (rem (int (quot frames 15)) 2)) 1)
                  (cpp/DrawText (str "PLAYING RECORDED EVENTS... [" current "]")
                                50 170 10 cpp/DARKGREEN)))
            :else nil)

          (cpp/EndDrawing)
          (recur player recording? playing? frames play-counter current zoom))))

    (cpp/UnloadAutomationEventList
     (cpp/* (cpp/unbox (:* cpp/AutomationEventList) @list-atom))))

  (cpp/CloseWindow))
