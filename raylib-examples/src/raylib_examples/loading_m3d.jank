(ns raylib-examples.loading-m3d
  "raylib [models] example - loading m3d, ported to jank.

  The Cesium Man walking in the Model3D (.m3d) format - both mesh and
  animations from one file. LEFT/RIGHT switch animations, HOLD SPACE
  to see the animated skeleton bones instead of the mesh. Orbital
  camera. ESC quits.
  Based on raylib/examples/models/models_loading_m3d.c

  jank-native notes:
  - First M3D format; the usual animation shims.
  - The C's DrawModelSkeleton helper walks skeleton.bones[] +
    keyframePoses[frame][] native arrays - it stays a verbatim C shim
    taking the model, animation index and frame."
  (:include "raylib.h"))

(cpp/raw "static ModelAnimation *jank_anims = NULL;
static int jank_anims_count = 0;
static int jank_load_anims(const char* path) {
  jank_anims = LoadModelAnimations(path, &jank_anims_count);
  return jank_anims_count;
}
static int jank_anim_keyframes(int i) { return jank_anims[i].keyframeCount; }
static const char* jank_anim_name(int i) { return jank_anims[i].name; }
static void jank_update_anim(Model m, int i, int frame) {
  UpdateModelAnimation(m, jank_anims[i], frame);
}
/* the C's DrawModelSkeleton, verbatim: cubes at the bones, lines to parents */
static void jank_draw_skeleton(Model m, int animIdx, int frame, float scale) {
  ModelSkeleton skeleton = m.skeleton;
  ModelAnimPose pose = jank_anims[animIdx].keyframePoses[frame];
  for (int i = 0; i < skeleton.boneCount - 1; i++) {
    DrawCube(pose[i].translation, scale*0.05f, scale*0.05f, scale*0.05f, RED);
    if (skeleton.bones[i].parent >= 0)
      DrawLine3D(pose[i].translation, pose[skeleton.bones[i].parent].translation, RED);
  }
}")

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/models/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [models] example - loading m3d (jank)")

  (let [camera (cpp/Camera3D (cpp/Vector3 (cpp/float 1.5) (cpp/float 1.5) (cpp/float 1.5))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.4) (cpp/float 0.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 45.0)
                             cpp/CAMERA_PERSPECTIVE)
        model (cpp/LoadModel (str RES "models/m3d/cesium_man.m3d"))
        anim-count (int (cpp/jank_load_anims (str RES "models/m3d/cesium_man.m3d")))]

    (cpp/SetTargetFPS 60)

    ;; Thread [animation-index animation-frame].
    (loop [anim-index 0
           frame 0]
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/UpdateCamera (cpp/& camera) cpp/CAMERA_ORBITAL)

        (let [anim-index (cond (cpp/IsKeyPressed cpp/KEY_RIGHT)
                               (int (mod (inc anim-index) anim-count))
                               (cpp/IsKeyPressed cpp/KEY_LEFT)
                               (int (mod (+ anim-index (dec anim-count)) anim-count))
                               :else anim-index)
              frame (inc frame)
              frame (if (>= frame (int (cpp/jank_anim_keyframes (int anim-index)))) 0 frame)]

          (cpp/jank_update_anim model (int anim-index) (int frame))

          (cpp/BeginDrawing)
          (cpp/ClearBackground cpp/RAYWHITE)

          (cpp/BeginMode3D camera)
          (if (cpp/IsKeyDown cpp/KEY_SPACE)
            ;; the animated skeleton instead of the mesh
            (cpp/jank_draw_skeleton model (int anim-index) (int frame) (cpp/float 1.0))
            (cpp/DrawModel model
                           (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                           (cpp/float 1.0) cpp/WHITE))
          (cpp/DrawGrid 10 (cpp/float 1.0))
          (cpp/EndMode3D)

          (cpp/DrawText (str "Current animation: " (cpp/jank_anim_name (int anim-index)))
                        10 10 20 cpp/LIGHTGRAY)
          (cpp/DrawText "Press SPACE to draw skeleton" 10 40 20 cpp/MAROON)
          (cpp/DrawText "(c) CesiumMan model by KhronosGroup" (- WIDTH 210) (- HEIGHT 20) 10 cpp/GRAY)

          (cpp/EndDrawing)
          (recur anim-index frame))))

    (cpp/UnloadModel model))

  (cpp/CloseWindow))
