(ns raylib-examples.format-text
  "raylib [text] example - format text, ported to jank.

  Zero-padded score / hiscore / lives readouts plus a live frame-time
  readout, all with the default font. Q quits.
  Based on raylib/examples/text/text_format_text.c
  (jank-native: TextFormat's %08i / %02.02f become small jank string
  helpers - there is no `format` in jank.)"
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)

(defn zero-pad
  "The decimal digits of n, left-padded with zeros to width."
  [n width]
  (loop [s (str n)]
    (if (< (count s) width)
      (recur (str "0" s))
      s)))

(defn fmt2
  "A non-negative real formatted with exactly two decimals."
  [x]
  (let [c     (int (+ (* x 100.0) 0.5))
        whole (int (quot c 100))
        frac  (int (mod c 100))]
    (str whole "." (zero-pad frac 2))))

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [text] example - format text (jank)")
  (cpp/SetTargetFPS 60)

  (loop []
    (when (cpp/! (cpp/WindowShouldClose))
      (let [ms (* (+ 0.0 (cpp/GetFrameTime)) 1000.0)]

        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/RAYWHITE)

        (cpp/DrawText (str "Score: " (zero-pad 100020 8)) 200 80 20 cpp/RED)
        (cpp/DrawText (str "HiScore: " (zero-pad 200450 8)) 200 120 20 cpp/GREEN)
        (cpp/DrawText (str "Lives: " (zero-pad 5 2)) 200 160 40 cpp/BLUE)
        (cpp/DrawText (str "Elapsed Time: " (fmt2 ms) " ms") 200 220 20 cpp/BLACK)
        (cpp/DrawText "Q quits" 200 260 20 cpp/LIGHTGRAY)

        (cpp/EndDrawing)

        (when-not (cpp/IsKeyDown cpp/KEY_Q)
          (recur)))))

  (cpp/CloseWindow))
