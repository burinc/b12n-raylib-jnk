(ns raylib-examples.image-processing
  "raylib [textures] example - image processing, ported to jank.

  Pick one of nine CPU image processes (grayscale, tint, invert,
  contrast, brightness, gaussian blur, flip V/H) from the toggle list -
  click or UP/DOWN - and it is applied to a fresh copy of the parrots
  image, then re-uploaded to the on-screen texture. Q quits.
  Based on raylib/examples/textures/textures_image_processing.c

  jank-native notes:
  - This is the repo's first use of pointer-taking `Image*` APIs. jank
    forms the pointer with `(cpp/& img)` on a mutable let-local (the
    same address-of C uses: `ImageColorInvert(&imCopy)`). No -sys
    wrapper change was needed - every raylib fn is already callable.
  - The working copy `imCopy` is never carried in loop/recur state (a
    native value can't be): it is rebuilt from `imOrigin`, processed,
    read back via `LoadImageColors` (a `Color*` return) into
    `UpdateTexture`, and unloaded, all inside the reload block that only
    runs when the selected process changes. Only the process index (a
    jank int) lives in loop state."
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/textures/resources/")
(def N 9)
(def LABELS ["NO PROCESSING" "COLOR GRAYSCALE" "COLOR TINT" "COLOR INVERT"
             "COLOR CONTRAST" "COLOR BRIGHTNESS" "GAUSSIAN BLUR"
             "FLIP VERTICAL" "FLIP HORIZONTAL"])

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [textures] example - image processing (jank)")
  (cpp/SetTargetFPS 60)

  (let [im-origin (cpp/LoadImage (str RES "parrots.png"))]
    ;; Format to RGBA 32bit so UpdateTexture always matches (mutates in place).
    (cpp/ImageFormat (cpp/& im-origin) cpp/PIXELFORMAT_UNCOMPRESSED_R8G8B8A8)
    (let [texture (cpp/LoadTextureFromImage im-origin)
          tw (int (+ 0.0 (.-width texture)))
          th (int (+ 0.0 (.-height texture)))]

      ;; loop state: currently-selected process index (0 = none).
      (loop [process 0]
        (when (cpp/! (cpp/WindowShouldClose))
          (let [;; which toggle is the mouse over? (-1 = none)
                hover (loop [i 0]
                        (if (< i N)
                          (if (cpp/CheckCollisionPointRec
                               (cpp/GetMousePosition)
                               (cpp/Rectangle (cpp/float 40.0) (cpp/float (+ 0.0 (+ 50 (* 32 i))))
                                              (cpp/float 150.0) (cpp/float 30.0)))
                            i
                            (recur (inc i)))
                          -1))
                ;; new process from click / UP / DOWN (C wraps UP<0 to 7; use a
                ;; correct modular wrap to 8 here).
                np (cond
                     (and (>= hover 0) (cpp/IsMouseButtonReleased cpp/MOUSE_BUTTON_LEFT)) hover
                     (cpp/IsKeyPressed cpp/KEY_DOWN) (mod (+ process 1) N)
                     (cpp/IsKeyPressed cpp/KEY_UP)   (mod (- process 1) N)
                     :else process)]

            ;; Reload + reprocess only when the selection changes.
            (when (not= np process)
              (let [im-copy (cpp/ImageCopy im-origin)]
                (cond
                  (= np 1) (cpp/ImageColorGrayscale (cpp/& im-copy))
                  (= np 2) (cpp/ImageColorTint (cpp/& im-copy) cpp/GREEN)
                  (= np 3) (cpp/ImageColorInvert (cpp/& im-copy))
                  (= np 4) (cpp/ImageColorContrast (cpp/& im-copy) (cpp/float -40.0))
                  (= np 5) (cpp/ImageColorBrightness (cpp/& im-copy) (cpp/int -80))
                  (= np 6) (cpp/ImageBlurGaussian (cpp/& im-copy) (cpp/int 10))
                  (= np 7) (cpp/ImageFlipVertical (cpp/& im-copy))
                  (= np 8) (cpp/ImageFlipHorizontal (cpp/& im-copy))
                  :else nil)
                (let [pixels (cpp/LoadImageColors im-copy)]
                  (cpp/UpdateTexture texture pixels)
                  (cpp/UnloadImageColors pixels))
                (cpp/UnloadImage im-copy)))

            (cpp/BeginDrawing)
            (cpp/ClearBackground cpp/RAYWHITE)

            (cpp/DrawText "IMAGE PROCESSING:" 40 30 10 cpp/DARKGRAY)

            (loop [i 0]
              (when (< i N)
                (let [y (+ 50 (* 32 i))
                      on? (or (= i np) (= i hover))]
                  (cpp/DrawRectangleRec
                   (cpp/Rectangle (cpp/float 40.0) (cpp/float (+ 0.0 y)) (cpp/float 150.0) (cpp/float 30.0))
                   (if on? cpp/SKYBLUE cpp/LIGHTGRAY))
                  (cpp/DrawRectangleLines 40 y 150 30 (if on? cpp/BLUE cpp/GRAY))
                  (cpp/DrawText (nth LABELS i)
                                (int (- (+ 40 75) (/ (+ 0.0 (cpp/MeasureText (nth LABELS i) 10)) 2.0)))
                                (+ y 11) 10 (if on? cpp/DARKBLUE cpp/DARKGRAY)))
                (recur (inc i))))

            (cpp/DrawTexture texture (- (- WIDTH tw) 60) (- (int (/ HEIGHT 2)) (int (/ th 2))) cpp/WHITE)
            (cpp/DrawRectangleLines (- (- WIDTH tw) 60) (- (int (/ HEIGHT 2)) (int (/ th 2))) tw th cpp/BLACK)
            (cpp/DrawText "click / UP / DOWN - Q quits" 40 (- HEIGHT 20) 10 cpp/GRAY)

            (cpp/EndDrawing)

            (when-not (cpp/IsKeyDown cpp/KEY_Q)
              (recur np)))))

      (cpp/UnloadTexture texture)
      (cpp/UnloadImage im-origin)))

  (cpp/CloseWindow))
