(ns raylib-examples.billboard-rendering
  "raylib [models] example - billboard rendering, ported to jank.

  Two camera-facing billboards over a grid - one static (DrawBillboard)
  and one spinning around its center (DrawBillboardPro) - while the
  camera orbits the scene. Draw order flips by distance so the nearer
  one composites over the farther one. Q quits.
  Based on raylib/examples/models/models_billboard_rendering.c
  (jank-native: the C's UpdateCamera(&camera, CAMERA_ORBITAL) needs a
  pointer jank cannot form, so the orbit is done by REBUILDING the
  Camera3D inline each frame from a jank-tracked angle - the
  per-frame-camera pattern. Distances come from scalar jank math.)"
  (:include "raylib.h" "math.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def BILL "../jank-raylib-sys/raylib/examples/models/resources/billboard.png")
(def ORBIT-R 7.07)
;; Billboard positions: static at (0,2,0), rotating at (1,2,1).
(def SX 0.0)
(def SY 2.0)
(def SZ 0.0)
(def RX 1.0)
(def RY 2.0)
(def RZ 1.0)

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [models] example - billboard rendering (jank)")
  (cpp/SetTargetFPS 60)

  (let [bill (cpp/LoadTexture BILL)
        ;; nth re-boxes the native field reads so the cpp/float call
        ;; sites below get jank reals (the all-native-chain trap)
        bw (nth [(+ 0.0 (.-width bill))] 0)
        bh (nth [(+ 0.0 (.-height bill))] 0)
        aspect (/ bw bh)]

    ;; Thread [orbit-angle billboard-rotation].
    (loop [a 0.8 rotation 0.0]
      (when (cpp/! (cpp/WindowShouldClose))
        (let [a (+ a (* 0.5 (+ 0.0 (cpp/GetFrameTime))))
              rotation (+ rotation 0.4)
              cx (* ORBIT-R (cpp/cos a))
              cz (* ORBIT-R (cpp/sin a))
              cy 4.0
              ;; Squared distances are enough to order the two draws.
              ds (+ (* (- cx SX) (- cx SX))
                    (+ (* (- cy SY) (- cy SY)) (* (- cz SZ) (- cz SZ))))
              dr (+ (* (- cx RX) (- cx RX))
                    (+ (* (- cy RY) (- cy RY)) (* (- cz RZ) (- cz RZ))))
              ;; The orbital camera, rebuilt from this frame's angle.
              camera (cpp/Camera3D (cpp/Vector3 (cpp/float cx) (cpp/float cy) (cpp/float cz))
                                   (cpp/Vector3 (cpp/float 0.0) (cpp/float 2.0) (cpp/float 0.0))
                                   (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                                   (cpp/float 45.0)
                                   cpp/CAMERA_PERSPECTIVE)]

          (cpp/BeginDrawing)
          (cpp/ClearBackground cpp/RAYWHITE)

          (cpp/BeginMode3D camera)
          (cpp/DrawGrid 10 (cpp/float 1.0))

          ;; Farther billboard first so the nearer one overlays it.
          (if (> ds dr)
            (do
              (cpp/DrawBillboard camera bill
                                 (cpp/Vector3 (cpp/float SX) (cpp/float SY) (cpp/float SZ))
                                 (cpp/float 2.0) cpp/WHITE)
              (cpp/DrawBillboardPro camera bill
                                    (cpp/Rectangle (cpp/float 0.0) (cpp/float 0.0)
                                                   (cpp/float bw) (cpp/float bh))
                                    (cpp/Vector3 (cpp/float RX) (cpp/float RY) (cpp/float RZ))
                                    (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                                    (cpp/Vector2 (cpp/float aspect) (cpp/float 1.0))
                                    (cpp/Vector2 (cpp/float (* aspect 0.5)) (cpp/float 0.5))
                                    (cpp/float rotation) cpp/WHITE))
            (do
              (cpp/DrawBillboardPro camera bill
                                    (cpp/Rectangle (cpp/float 0.0) (cpp/float 0.0)
                                                   (cpp/float bw) (cpp/float bh))
                                    (cpp/Vector3 (cpp/float RX) (cpp/float RY) (cpp/float RZ))
                                    (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                                    (cpp/Vector2 (cpp/float aspect) (cpp/float 1.0))
                                    (cpp/Vector2 (cpp/float (* aspect 0.5)) (cpp/float 0.5))
                                    (cpp/float rotation) cpp/WHITE)
              (cpp/DrawBillboard camera bill
                                 (cpp/Vector3 (cpp/float SX) (cpp/float SY) (cpp/float SZ))
                                 (cpp/float 2.0) cpp/WHITE)))

          (cpp/EndMode3D)

          (cpp/DrawFPS 10 10)
          (cpp/DrawText "The camera orbits; the right billboard also spins (Q quits)"
                        10 40 10 cpp/GRAY)

          (cpp/EndDrawing)

          (when-not (cpp/IsKeyDown cpp/KEY_Q)
            (recur a rotation)))))

    (cpp/UnloadTexture bill))

  (cpp/CloseWindow))
