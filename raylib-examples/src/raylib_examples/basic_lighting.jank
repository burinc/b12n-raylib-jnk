(ns raylib-examples.basic-lighting
  "raylib [shaders] example - basic lighting, ported to jank.

  A white plane and cube lit by four colored point lights under the
  lighting.vs/lighting.fs shader pair, orbital camera. Keys Y/R/G/B
  toggle the yellow/red/green/blue lights (spheres mark them; wire
  spheres are off). ESC quits.
  Based on raylib/examples/shaders/shaders_basic_lighting.c

  jank-native notes:
  - Lighting comes from raylib-examples.rlights, a plain jank namespace.
    It used to be a C header shipped by the -sys wrapper; nothing about
    it needed C once cpp/new was available to produce the pointers
    SetShaderValue wants. See docs/guide/native-value-lifetimes.md.
  - The C original writes shader.locs[SHADER_LOC_VECTOR_VIEW] and reads it
    back each frame. That is the example's own bookkeeping - raylib never
    reads that slot itself - so this keeps the location in a jank local
    and skips the write, which jank has no syntax for anyway."
  (:require [raylib-examples.rlights :as rl]
            [raylib-examples.shaders :as sh])
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/shaders/resources/")

;; The four lights (raylib's YELLOW / RED / GREEN / BLUE as RGB triplets).
(def LIGHTS [{:x -2.0 :y 1.0 :z -2.0 :r 253 :g 249 :b 0}
             {:x 2.0 :y 1.0 :z 2.0 :r 230 :g 41 :b 55}
             {:x -2.0 :y 1.0 :z 2.0 :r 0 :g 228 :b 48}
             {:x 2.0 :y 1.0 :z -2.0 :r 0 :g 121 :b 241}])

(defn- light-color
  "The light's Color as a packed-RGBA GetColor int."
  [{:keys [r g b]}]
  (+ (* r 16777216) (* g 65536) (* b 256) 255))

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_MSAA_4X_HINT)
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [shaders] example - basic lighting (jank)")

  (rl/reset-lights!)

  (let [camera (cpp/Camera3D (cpp/Vector3 (cpp/float 2.0) (cpp/float 4.0) (cpp/float 6.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.5) (cpp/float 0.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 45.0)
                             cpp/CAMERA_PERSPECTIVE)
        shader (cpp/LoadShader (str RES "shaders/glsl330/lighting.vs")
                               (str RES "shaders/glsl330/lighting.fs"))
        ;; boxed HERE, where shader is still native - see rlights ns docstring
        sh-box (cpp/box (cpp/new cpp/Shader shader))
        view-loc (int (cpp/GetShaderLocation shader "viewPos"))
        ambient-loc (int (cpp/GetShaderLocation shader "ambient"))]

    (sh/set-vec4! sh-box ambient-loc 0.1 0.1 0.1 1.0)

    ;; create the four point lights (indices 0-3)
    (loop [i 0]
      (when (< i 4)
        (let [{:keys [x y z r g b]} (nth LIGHTS i)]
          (rl/create-light! {:type rl/LIGHT-POINT
                             :px x :py y :pz z
                             :tx 0.0 :ty 0.0 :tz 0.0
                             :r r :g g :b b :a 255
                             :shader sh-box}))
        (recur (inc i))))

    (cpp/SetTargetFPS 60)

    (loop []
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/UpdateCamera (cpp/& camera) cpp/CAMERA_ORBITAL)
        (let [p (.-position camera)]        ;; camera is native here
          (rl/push-view-pos! sh-box view-loc (.-x p) (.-y p) (.-z p)))

        ;; Y/R/G/B toggle their lights
        (when (cpp/IsKeyPressed cpp/KEY_Y) (rl/toggle-light! 0))
        (when (cpp/IsKeyPressed cpp/KEY_R) (rl/toggle-light! 1))
        (when (cpp/IsKeyPressed cpp/KEY_G) (rl/toggle-light! 2))
        (when (cpp/IsKeyPressed cpp/KEY_B) (rl/toggle-light! 3))
        (loop [i 0]
          (when (< i 4)
            (rl/update-light! sh-box i)
            (recur (inc i))))

        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/RAYWHITE)

        (cpp/BeginMode3D camera)
        (cpp/BeginShaderMode shader)
        (cpp/DrawPlane (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                       (cpp/Vector2 (cpp/float 10.0) (cpp/float 10.0)) cpp/WHITE)
        (cpp/DrawCube (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                      (cpp/float 2.0) (cpp/float 4.0) (cpp/float 2.0) cpp/WHITE)
        (cpp/EndShaderMode)

        ;; marker spheres: solid when the light is on, wire when off
        (loop [i 0]
          (when (< i 4)
            (let [{:keys [x y z] :as light} (nth LIGHTS i)]
              (if (rl/light-enabled? i)
                (cpp/DrawSphereEx (cpp/Vector3 (cpp/float x) (cpp/float y) (cpp/float z))
                                  (cpp/float 0.2) 8 8
                                  (cpp/GetColor (light-color light)))
                (cpp/DrawSphereWires (cpp/Vector3 (cpp/float x) (cpp/float y) (cpp/float z))
                                     (cpp/float 0.2) 8 8
                                     (cpp/ColorAlpha (cpp/GetColor (light-color light))
                                                     (cpp/float 0.3)))))
            (recur (inc i))))
        (cpp/DrawGrid 10 (cpp/float 1.0))
        (cpp/EndMode3D)

        (cpp/DrawFPS 10 10)
        (cpp/DrawText "Use keys [Y][R][G][B] to toggle lights" 10 40 20 cpp/DARKGRAY)

        (cpp/EndDrawing)
        (recur)))

    (cpp/UnloadShader shader))

  (cpp/CloseWindow))
