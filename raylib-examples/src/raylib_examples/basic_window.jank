(ns raylib-examples.basic-window
  "raylib [core] example - basic window, ported to jank.

  The minimal raylib program: open a window and draw a line of text.
  Q quits. Based on raylib/examples/core/core_basic_window.c"
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [core] example - basic window (jank)")
  (cpp/SetTargetFPS 60)

  (loop []
    (when (cpp/! (cpp/WindowShouldClose))
      (cpp/BeginDrawing)
      (cpp/ClearBackground cpp/RAYWHITE)
      (cpp/DrawText "Congrats! You created your first jank window!" 160 200 20 cpp/LIGHTGRAY)
      (cpp/DrawText "Q quits" 10 10 20 cpp/LIGHTGRAY)
      (cpp/EndDrawing)
      (when-not (cpp/IsKeyDown cpp/KEY_Q)
        (recur))))

  (cpp/CloseWindow))
