(ns raylib-examples.shadowmap-rendering
  "raylib [shaders] example - shadowmap rendering, ported to jank.

  Real shadows via the textbook shadowmapping algorithm: pass 1
  renders the scene's DEPTH from the light's orthographic camera into
  a depth-only framebuffer, pass 2 renders from the player camera
  with the shadow shader comparing each fragment against that depth
  map. An animated robot walks among cubes; ARROW keys steer the
  light, F takes a screenshot. ESC quits.
  Based on raylib/examples/shaders/shaders_shadowmap_rendering.c

  jank-native notes:
  - FIRST MODEL ANIMATIONS: LoadModelAnimations' ModelAnimation* +
    int* out-param stay behind C-side statics; jank drives
    UpdateModelAnimation by index + frame number each frame.
  - The depth-ONLY framebuffer (no color attachment) is the
    depth-writing shim minus the color texture, verbatim.
  - DrawScene draws two Models - a jank helper cannot take them
    (rule 2), so the scene stays a C shim called from both passes.
  - The light direction threads as three jank reals, hand-normalized;
    the light's orthographic Camera3D is rebuilt inline each frame
    from them (the per-frame-camera pattern).
  - Pass-boundary matrices (rlGetMatrixModelview/Projection,
    MatrixMultiply) are frame-local native let-locals handed to
    SetShaderValueMatrix by value."
  (:require [raylib-examples.models :as md]
            [raylib-examples.rendertex :as rt])
  (:require [raylib-examples.rlights :as rl]
            [raylib-examples.shaders :as sh])
  (:include "raylib.h" "rlgl.h" "raymath.h" "math.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def SHADOWMAP-RES 1024)
(def RES "../jank-raylib-sys/raylib/examples/shaders/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_MSAA_4X_HINT)
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [shaders] example - shadowmap rendering (jank)")

  (let [camera (cpp/Camera3D (cpp/Vector3 (cpp/float 10.0) (cpp/float 10.0) (cpp/float 10.0))
                               (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                               (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 45.0)
                             cpp/CAMERA_PERSPECTIVE)
        shadow-shader (cpp/LoadShader (str RES "shaders/glsl330/shadowmap.vs")
                                      (str RES "shaders/glsl330/shadowmap.fs"))
        ;; boxed here, where the shader is still native (see rlights ns)
        sh-box (cpp/box (cpp/new cpp/Shader shadow-shader))
        view-loc (int (cpp/GetShaderLocation shadow-shader "viewPos"))
        light-dir-loc (int (cpp/GetShaderLocation shadow-shader "lightDir"))
        light-col-loc (int (cpp/GetShaderLocation shadow-shader "lightColor"))
        ambient-loc (int (cpp/GetShaderLocation shadow-shader "ambient"))
        light-vp-loc (int (cpp/GetShaderLocation shadow-shader "lightVP"))
        shadow-map-loc (int (cpp/GetShaderLocation shadow-shader "shadowMap"))
        res-loc (int (cpp/GetShaderLocation shadow-shader "shadowMapResolution"))
        cube (cpp/LoadModelFromMesh (cpp/GenMeshCube (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0)))
        robot (cpp/LoadModel (str RES "models/robot.glb"))
        ;; count through an int* out-param, array in the outer let
        anim-n (cpp/int 0)
        anims (cpp/LoadModelAnimations (str RES "models/robot.glb") (cpp/& anim-n))
        anim-count (int (+ 0.0 anim-n))
        keyframes (int (+ 0.0 (.-keyframeCount (cpp/aget anims (cpp/int 0)))))
        shadow-box (rt/load-shadowmap! SHADOWMAP-RES SHADOWMAP-RES)
        shadow-map (cpp/* (cpp/unbox (:* cpp/RenderTexture2D) shadow-box))
        ;; initial light dir = normalize(0.35, -1, -0.35)
        len0 (+ 0.0 (cpp/sqrt (+ (* 0.35 0.35) 1.0 (* 0.35 0.35))))
        lx0 (/ 0.35 len0)
        ly0 (/ -1.0 len0)
        lz0 (/ -0.35 len0)]

    (sh/set-shader-loc! sh-box cpp/SHADER_LOC_VECTOR_VIEW view-loc)
    (sh/set-vec3! sh-box light-dir-loc lx0 ly0 lz0)
    (sh/set-vec4! sh-box light-col-loc 1.0 1.0 1.0 1.0)
    (sh/set-vec4! sh-box ambient-loc 0.1 0.1 0.1 1.0)
    (sh/set-int! sh-box res-loc SHADOWMAP-RES)

    (md/set-shader-all! (cpp/box (cpp/new cpp/Model cube)) (int (.-materialCount cube))
                        (cpp/box (cpp/new cpp/Shader shadow-shader)))
    (md/set-shader-all! (cpp/box (cpp/new cpp/Model robot)) (int (.-materialCount robot))
                        (cpp/box (cpp/new cpp/Shader shadow-shader)))

    (cpp/SetTargetFPS 60)

    ;; Thread [frame-counter light-dir-x light-dir-y light-dir-z].
    (loop [fc 0
           lx lx0
           ly ly0
           lz lz0]
      (when (cpp/! (cpp/WindowShouldClose))
        (let [dt (+ 0.0 (cpp/GetFrameTime))]
          ;; view pos from the PRE-update camera position, matching the C
          (let [p (.-position camera)]
            (rl/push-view-pos! sh-box view-loc (.-x p) (.-y p) (.-z p)))
          (cpp/UpdateCamera (cpp/& camera) cpp/CAMERA_ORBITAL)

          (let [fc (int (mod (inc fc) keyframes))
                _ (cpp/UpdateModelAnimation robot (cpp/aget anims (cpp/int 0))
                                            (cpp/float (+ 0.0 fc)))
                step (* 0.05 60.0 dt)
                ;; box the native key states before they feed and-logic
                left? (if (cpp/IsKeyDown cpp/KEY_LEFT) true false)
                right? (if (cpp/IsKeyDown cpp/KEY_RIGHT) true false)
                up? (if (cpp/IsKeyDown cpp/KEY_UP) true false)
                down? (if (cpp/IsKeyDown cpp/KEY_DOWN) true false)
                lx (cond (and left? (< lx 0.6)) (+ lx step)
                         (and right? (> lx -0.6)) (- lx step)
                         :else lx)
                lz (cond (and up? (< lz 0.6)) (+ lz step)
                         (and down? (> lz -0.6)) (- lz step)
                         :else lz)
                len (+ 0.0 (cpp/sqrt (+ (* lx lx) (* ly ly) (* lz lz))))
                lx (/ lx len)
                ly (/ ly len)
                lz (/ lz len)
                ;; the light's orthographic camera, rebuilt from the dir
                light-camera (cpp/Camera3D (cpp/Vector3 (cpp/float (* lx -15.0))
                                                        (cpp/float (* ly -15.0))
                                                        (cpp/float (* lz -15.0)))
                               (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                               (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                                           (cpp/float 20.0)
                                           cpp/CAMERA_ORTHOGRAPHIC)]

            (sh/set-vec3! sh-box light-dir-loc lx ly lz)

            ;; PASS 1: depth from the light's point of view
            (cpp/BeginTextureMode shadow-map)
            (cpp/ClearBackground cpp/WHITE)
            (cpp/BeginMode3D light-camera)
            (let [light-view (cpp/rlGetMatrixModelview)
                  light-proj (cpp/rlGetMatrixProjection)]
              ;; the scene, drawn identically into both passes
              (cpp/DrawModelEx cube (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                               (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                               (cpp/float 0.0)
                               (cpp/Vector3 (cpp/float 10.0) (cpp/float 1.0) (cpp/float 10.0))
                               cpp/BLUE)
              (cpp/DrawModelEx cube (cpp/Vector3 (cpp/float 1.5) (cpp/float 1.0) (cpp/float -1.5))
                               (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                               (cpp/float 0.0)
                               (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                               cpp/WHITE)
              (cpp/DrawModelEx robot (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.5) (cpp/float 0.0))
                               (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                               (cpp/float 0.0)
                               (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                               cpp/RED)
              (cpp/EndMode3D)
              (cpp/EndTextureMode)

              ;; PASS 2: the player view, sampling the shadowmap depth
              (cpp/BeginDrawing)
              (cpp/ClearBackground cpp/RAYWHITE)

              (cpp/SetShaderValueMatrix shadow-shader light-vp-loc
                                        (cpp/MatrixMultiply light-view light-proj))
              (cpp/rlEnableShader (.-id shadow-shader))
              (cpp/rlActiveTextureSlot 10)
              (let [depth-tex (.-depth shadow-map)]
                (cpp/rlEnableTexture (.-id depth-tex)))
              (sh/set-int! sh-box shadow-map-loc 10)

              (cpp/BeginMode3D camera)
              ;; the scene, drawn identically into both passes
              (cpp/DrawModelEx cube (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                               (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                               (cpp/float 0.0)
                               (cpp/Vector3 (cpp/float 10.0) (cpp/float 1.0) (cpp/float 10.0))
                               cpp/BLUE)
              (cpp/DrawModelEx cube (cpp/Vector3 (cpp/float 1.5) (cpp/float 1.0) (cpp/float -1.5))
                               (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                               (cpp/float 0.0)
                               (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                               cpp/WHITE)
              (cpp/DrawModelEx robot (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.5) (cpp/float 0.0))
                               (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                               (cpp/float 0.0)
                               (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                               cpp/RED)
              (cpp/EndMode3D)

              (cpp/DrawText "Use the arrow keys to rotate the light!" 10 10 30 cpp/RED)
              (cpp/DrawText "Shadows in raylib using the shadowmapping algorithm!"
                            (- WIDTH 280) (- HEIGHT 20) 10 cpp/GRAY)

              (cpp/EndDrawing)

              (when (cpp/IsKeyPressed cpp/KEY_F)
                (cpp/TakeScreenshot "shaders_shadowmap.png"))

              (recur fc lx ly lz))))))

    (cpp/UnloadShader shadow-shader)
    (cpp/UnloadModel cube)
    (cpp/UnloadModel robot)
    (rt/unload-shadowmap! shadow-box))

  (cpp/CloseWindow))
