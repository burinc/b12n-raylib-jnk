(ns raylib-examples.camera-3d
  "raylib [core] example - 3d camera mode, ported to jank.

  The canonical minimal 3D scene: a single red cube (solid +
  wireframe) sitting on a grid, viewed through a fixed perspective
  camera. Welcome to the third dimension! Q quits.
  Based on raylib/examples/core/core_3d_camera_mode.c
  (jank-native: the Camera3D is an outer-let local and every Vector3
  is constructed inline as a call argument.)"
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [core] example - 3d camera mode (jank)")
  (cpp/SetTargetFPS 60)

  (let [camera (cpp/Camera3D (cpp/Vector3 (cpp/float 0.0) (cpp/float 10.0) (cpp/float 10.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 45.0)
                             cpp/CAMERA_PERSPECTIVE)]

    (loop []
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/RAYWHITE)

        (cpp/BeginMode3D camera)

        (cpp/DrawCube (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                      (cpp/float 2.0) (cpp/float 2.0) (cpp/float 2.0) cpp/RED)
        (cpp/DrawCubeWires (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                           (cpp/float 2.0) (cpp/float 2.0) (cpp/float 2.0) cpp/MAROON)

        (cpp/DrawGrid 10 (cpp/float 1.0))

        (cpp/EndMode3D)

        (cpp/DrawText "Welcome to the third dimension!" 10 40 20 cpp/DARKGRAY)
        (cpp/DrawFPS 10 10)

        (cpp/EndDrawing)

        (when-not (cpp/IsKeyDown cpp/KEY_Q)
          (recur))))

    nil)

  (cpp/CloseWindow))
