(ns raylib-examples.input-gamepad
  "raylib [core] example - input gamepad, ported to jank.

  Draws a live controller diagram: buttons light up as you press them,
  the sticks and triggers track the analog axes, and a VIBRATE button
  (mouse) rumbles the pad. It recognises Xbox and PlayStation pads by
  name (drawing the matching photo) and falls back to a generic layout
  otherwise. LEFT/RIGHT switch which gamepad slot is shown. With no
  controller plugged in it shows the Xbox diagram greyed out and
  'GP0: NOT DETECTED'.
  Based on raylib/examples/core/core_input_gamepad.c (2/4 complexity).

  jank-native notes:
  - Nothing here needed to stay in C. The gamepad API returns ints,
    floats, bools and C strings, all of which cross a jank fn boundary
    freely, and the two controller photos are ordinary let-local
    Texture2Ds used inline.
  - The C repeats a button-lit-up draw about sixty times, one `if` per
    button. Here each layout is a vector of [button x y radius colour]
    rows walked by one loop. Same draws in the same order, expressed
    once. Colours travel as [r g b] taken from raylib.h, since a Color
    cannot live in a jank vector.
  - Deadzones, the axis readout and the Xbox/PS name match via
    TextFindIndex(TextToLower(...)) are all plain jank."
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def ^:private RES "../jank-raylib-sys/raylib/examples/core/resources/")

;; raylib.h values. A Color cannot live in a jank vector, nor be returned
;; from a jank fn, so colours travel as [r g b] and the cpp/Color is built
;; inline wherever it is passed.
(def ^:private C-RED [230 41 55])
(def ^:private C-BLUE [0 121 241])
(def ^:private C-LIME [0 158 47])
(def ^:private C-GOLD [255 203 0])
(def ^:private C-VIOLET [135 60 190])
(def ^:private C-PINK [255 109 194])
(def ^:private C-GREEN [0 228 48])
(def ^:private C-BLACK [0 0 0])
(def ^:private C-LIGHTGRAY [200 200 200])
(def ^:private C-RAYWHITE [245 245 245])

(def ^:private STICK-DEADZONE 0.1)
(def ^:private TRIGGER-DEADZONE -0.9)

(defn- deaden
  "The C's stick deadzone: snap to 0 inside the band."
  [v dz]
  (if (and (> v (- dz)) (< v dz)) 0.0 v))

(defn- circles!
  "Rows of [button cx cy radius colour], drawn when that button is down."
  [gp rows]
  (loop [i 0]
    (when (< i (count rows))
      (let [[b x y r c] (nth rows i)]
        (when (cpp/IsGamepadButtonDown (cpp/int gp) (cpp/int b))
          (cpp/DrawCircle (cpp/int x) (cpp/int y) (cpp/float r) (cpp/Color (cpp/cast cpp/uint8_t (nth c 0)) (cpp/cast cpp/uint8_t (nth c 1))
                             (cpp/cast cpp/uint8_t (nth c 2)) (cpp/cast cpp/uint8_t 255)))))
      (recur (inc i))))
  nil)

(defn- rects!
  "Rows of [button x y w h colour], drawn when that button is down."
  [gp rows]
  (loop [i 0]
    (when (< i (count rows))
      (let [[b x y w h c] (nth rows i)]
        (when (cpp/IsGamepadButtonDown (cpp/int gp) (cpp/int b))
          (cpp/DrawRectangle (cpp/int x) (cpp/int y) (cpp/int w) (cpp/int h) (cpp/Color (cpp/cast cpp/uint8_t (nth c 0)) (cpp/cast cpp/uint8_t (nth c 1))
                             (cpp/cast cpp/uint8_t (nth c 2)) (cpp/cast cpp/uint8_t 255)))))
      (recur (inc i))))
  nil)

(defn- stick!
  "Base disc plus the thumbstick puck, offset by the axis and reddened
  while the stick is clicked in."
  [gp cx cy outer inner ax ay btn]
  (cpp/DrawCircle (cpp/int cx) (cpp/int cy) (cpp/float outer) (cpp/Color (cpp/cast cpp/uint8_t (nth C-BLACK 0)) (cpp/cast cpp/uint8_t (nth C-BLACK 1))
                             (cpp/cast cpp/uint8_t (nth C-BLACK 2)) (cpp/cast cpp/uint8_t 255)))
  (cpp/DrawCircle (cpp/int cx) (cpp/int cy) (cpp/float inner) (cpp/Color (cpp/cast cpp/uint8_t (nth C-LIGHTGRAY 0)) (cpp/cast cpp/uint8_t (nth C-LIGHTGRAY 1))
                             (cpp/cast cpp/uint8_t (nth C-LIGHTGRAY 2)) (cpp/cast cpp/uint8_t 255)))
  (cpp/DrawCircle (cpp/int (+ cx (int (* ax 20.0)))) (cpp/int (+ cy (int (* ay 20.0))))
                  (cpp/float 25.0)
                  (let [k (if (cpp/IsGamepadButtonDown (cpp/int gp) (cpp/int btn))
                            C-RED C-BLACK)]
                    (cpp/Color (cpp/cast cpp/uint8_t (nth k 0)) (cpp/cast cpp/uint8_t (nth k 1))
                               (cpp/cast cpp/uint8_t (nth k 2)) (cpp/cast cpp/uint8_t 255))))
  nil)

(defn- triggers!
  "Two grey tracks with a red fill proportional to the trigger axis."
  [lx rx y w h lt rt]
  (cpp/DrawRectangle (cpp/int lx) (cpp/int y) (cpp/int w) (cpp/int h) cpp/GRAY)
  (cpp/DrawRectangle (cpp/int rx) (cpp/int y) (cpp/int w) (cpp/int h) cpp/GRAY)
  (cpp/DrawRectangle (cpp/int lx) (cpp/int y) (cpp/int w)
                     (cpp/int (int (* (/ (+ 1.0 lt) 2.0) h))) (cpp/Color (cpp/cast cpp/uint8_t (nth C-RED 0)) (cpp/cast cpp/uint8_t (nth C-RED 1))
                             (cpp/cast cpp/uint8_t (nth C-RED 2)) (cpp/cast cpp/uint8_t 255)))
  (cpp/DrawRectangle (cpp/int rx) (cpp/int y) (cpp/int w)
                     (cpp/int (int (* (/ (+ 1.0 rt) 2.0) h))) (cpp/Color (cpp/cast cpp/uint8_t (nth C-RED 0)) (cpp/cast cpp/uint8_t (nth C-RED 1))
                             (cpp/cast cpp/uint8_t (nth C-RED 2)) (cpp/cast cpp/uint8_t 255)))
  nil)

(defn- fmt2
  "The C's %.02f."
  [v]
  (let [s (str (/ (+ 0.0 (cpp/round (* v 100.0))) 100.0))
        s (if (loop [i 0] (if (< i (count s)) (if (= (subs s i (inc i)) ".") true (recur (inc i))) false))
            s (str s "."))
        d (loop [i 0] (if (= (subs s i (inc i)) ".") i (recur (inc i))))
        frac (- (count s) d 1)]
    (if (> frac 2) (subs s 0 (+ d 3)) (str s (subs "00" 0 (- 2 frac))))))

(defn- pad-name-has?
  "The C's TextFindIndex(TextToLower(GetGamepadName(gp)), alias) > -1."
  [gp alias]
  (> (int (cpp/TextFindIndex (cpp/TextToLower (cpp/GetGamepadName (cpp/int gp))) alias)) -1))

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_MSAA_4X_HINT)
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [core] example - input gamepad (jank)")

  (let [ps3 (cpp/LoadTexture (str RES "ps3.png"))
        xbox (cpp/LoadTexture (str RES "xbox.png"))]
    (cpp/SetTargetFPS 60)

    ;; Thread [gamepad-slot].
    (loop [gp 0]
      (when (cpp/! (cpp/WindowShouldClose))
        (let [gp (cond (and (cpp/IsKeyPressed cpp/KEY_LEFT) (> gp 0)) (dec gp)
                       (cpp/IsKeyPressed cpp/KEY_RIGHT) (inc gp)
                       :else gp)
              axis-count (int (cpp/GetGamepadAxisCount (cpp/int gp)))
              vib-y (+ 70.0 (* 20 axis-count) 20)
              mouse (cpp/GetMousePosition)]

          (when (and (cpp/IsMouseButtonPressed cpp/MOUSE_BUTTON_LEFT)
                     (cpp/CheckCollisionPointRec
                      mouse
                      (cpp/Rectangle (cpp/float 10.0) (cpp/float vib-y)
                                     (cpp/float 75.0) (cpp/float 24.0))))
            (cpp/SetGamepadVibration (cpp/int gp) (cpp/float 1.0) (cpp/float 1.0)
                                     (cpp/float 1.0)))

          (cpp/BeginDrawing)
          (cpp/ClearBackground cpp/RAYWHITE)

          (if (cpp/IsGamepadAvailable (cpp/int gp))
            (let [nm (str (cpp/GetGamepadName (cpp/int gp)))
                  ax (deaden (+ 0.0 (cpp/GetGamepadAxisMovement (cpp/int gp) cpp/GAMEPAD_AXIS_LEFT_X)) STICK-DEADZONE)
                  ay (deaden (+ 0.0 (cpp/GetGamepadAxisMovement (cpp/int gp) cpp/GAMEPAD_AXIS_LEFT_Y)) STICK-DEADZONE)
                  bx (deaden (+ 0.0 (cpp/GetGamepadAxisMovement (cpp/int gp) cpp/GAMEPAD_AXIS_RIGHT_X)) STICK-DEADZONE)
                  by (deaden (+ 0.0 (cpp/GetGamepadAxisMovement (cpp/int gp) cpp/GAMEPAD_AXIS_RIGHT_Y)) STICK-DEADZONE)
                  lt0 (+ 0.0 (cpp/GetGamepadAxisMovement (cpp/int gp) cpp/GAMEPAD_AXIS_LEFT_TRIGGER))
                  rt0 (+ 0.0 (cpp/GetGamepadAxisMovement (cpp/int gp) cpp/GAMEPAD_AXIS_RIGHT_TRIGGER))
                  lt (if (< lt0 TRIGGER-DEADZONE) -1.0 lt0)
                  rt (if (< rt0 TRIGGER-DEADZONE) -1.0 rt0)
                  xbox? (or (pad-name-has? gp "xbox") (pad-name-has? gp "x-box"))
                  ps? (or (pad-name-has? gp "playstation") (pad-name-has? gp "sony"))]

              (cpp/DrawText (str "GP" gp ": " nm) 10 10 10 cpp/BLACK)

              (cond
                xbox?
                (do
                  (cpp/DrawTexture xbox 0 0 cpp/DARKGRAY)
                  (circles! gp [[cpp/GAMEPAD_BUTTON_MIDDLE 394 89 19.0 C-RED]
                                [cpp/GAMEPAD_BUTTON_MIDDLE_RIGHT 436 150 9.0 C-RED]
                                [cpp/GAMEPAD_BUTTON_MIDDLE_LEFT 352 150 9.0 C-RED]
                                [cpp/GAMEPAD_BUTTON_RIGHT_FACE_LEFT 501 151 15.0 C-BLUE]
                                [cpp/GAMEPAD_BUTTON_RIGHT_FACE_DOWN 536 187 15.0 C-LIME]
                                [cpp/GAMEPAD_BUTTON_RIGHT_FACE_RIGHT 572 151 15.0 [190 33 55]]
                                [cpp/GAMEPAD_BUTTON_RIGHT_FACE_UP 536 115 15.0 C-GOLD]])
                  (cpp/DrawRectangle 317 202 19 71 cpp/BLACK)
                  (cpp/DrawRectangle 293 228 69 19 cpp/BLACK)
                  (rects! gp [[cpp/GAMEPAD_BUTTON_LEFT_FACE_UP 317 202 19 26 C-RED]
                              [cpp/GAMEPAD_BUTTON_LEFT_FACE_DOWN 317 247 19 26 C-RED]
                              [cpp/GAMEPAD_BUTTON_LEFT_FACE_LEFT 292 228 25 19 C-RED]
                              [cpp/GAMEPAD_BUTTON_LEFT_FACE_RIGHT 336 228 26 19 C-RED]])
                  (circles! gp [[cpp/GAMEPAD_BUTTON_LEFT_TRIGGER_1 259 61 20.0 C-RED]
                                [cpp/GAMEPAD_BUTTON_RIGHT_TRIGGER_1 536 61 20.0 C-RED]])
                  (stick! gp 259 152 39.0 34.0 ax ay cpp/GAMEPAD_BUTTON_LEFT_THUMB)
                  (stick! gp 461 237 38.0 33.0 bx by cpp/GAMEPAD_BUTTON_RIGHT_THUMB)
                  (triggers! 170 604 30 15 70 lt rt))

                ps?
                (do
                  (cpp/DrawTexture ps3 0 0 cpp/DARKGRAY)
                  (circles! gp [[cpp/GAMEPAD_BUTTON_MIDDLE 396 222 13.0 C-RED]])
                  (rects! gp [[cpp/GAMEPAD_BUTTON_MIDDLE_LEFT 328 170 32 13 C-RED]])
                  (when (cpp/IsGamepadButtonDown (cpp/int gp) cpp/GAMEPAD_BUTTON_MIDDLE_RIGHT)
                    (cpp/DrawTriangle (cpp/Vector2 (cpp/float 436.0) (cpp/float 168.0))
                                      (cpp/Vector2 (cpp/float 436.0) (cpp/float 185.0))
                                      (cpp/Vector2 (cpp/float 464.0) (cpp/float 177.0))
                                      (cpp/Color (cpp/cast cpp/uint8_t (nth C-RED 0)) (cpp/cast cpp/uint8_t (nth C-RED 1))
                             (cpp/cast cpp/uint8_t (nth C-RED 2)) (cpp/cast cpp/uint8_t 255))))
                  (circles! gp [[cpp/GAMEPAD_BUTTON_RIGHT_FACE_UP 557 144 13.0 C-LIME]
                                [cpp/GAMEPAD_BUTTON_RIGHT_FACE_RIGHT 586 173 13.0 C-RED]
                                [cpp/GAMEPAD_BUTTON_RIGHT_FACE_DOWN 557 203 13.0 C-VIOLET]
                                [cpp/GAMEPAD_BUTTON_RIGHT_FACE_LEFT 527 173 13.0 C-PINK]])
                  (cpp/DrawRectangle 225 132 24 84 cpp/BLACK)
                  (cpp/DrawRectangle 195 161 84 25 cpp/BLACK)
                  (rects! gp [[cpp/GAMEPAD_BUTTON_LEFT_FACE_UP 225 132 24 29 C-RED]
                              [cpp/GAMEPAD_BUTTON_LEFT_FACE_DOWN 225 186 24 30 C-RED]
                              [cpp/GAMEPAD_BUTTON_LEFT_FACE_LEFT 195 161 30 25 C-RED]
                              [cpp/GAMEPAD_BUTTON_LEFT_FACE_RIGHT 249 161 30 25 C-RED]])
                  (circles! gp [[cpp/GAMEPAD_BUTTON_LEFT_TRIGGER_1 239 82 20.0 C-RED]
                                [cpp/GAMEPAD_BUTTON_RIGHT_TRIGGER_1 557 82 20.0 C-RED]])
                  (stick! gp 319 255 35.0 31.0 ax ay cpp/GAMEPAD_BUTTON_LEFT_THUMB)
                  (stick! gp 475 255 35.0 31.0 bx by cpp/GAMEPAD_BUTTON_RIGHT_THUMB)
                  (triggers! 169 611 48 15 70 lt rt))

                :else
                (do
                  (cpp/DrawRectangleRounded
                   (cpp/Rectangle (cpp/float 175.0) (cpp/float 110.0)
                                  (cpp/float 460.0) (cpp/float 220.0))
                   (cpp/float 0.3) 16 cpp/DARKGRAY)
                  (loop [i 0]
                    (when (< i (count [[365 170 12.0] [405 170 12.0] [445 170 12.0]
                                       [516 191 17.0] [551 227 17.0] [587 191 17.0]
                                       [551 155 17.0]]))
                      (let [[x y r] (nth [[365 170 12.0] [405 170 12.0] [445 170 12.0]
                                          [516 191 17.0] [551 227 17.0] [587 191 17.0]
                                          [551 155 17.0]] i)]
                        (cpp/DrawCircle (cpp/int x) (cpp/int y) (cpp/float r) (cpp/Color (cpp/cast cpp/uint8_t (nth C-RAYWHITE 0)) (cpp/cast cpp/uint8_t (nth C-RAYWHITE 1))
                             (cpp/cast cpp/uint8_t (nth C-RAYWHITE 2)) (cpp/cast cpp/uint8_t 255))))
                      (recur (inc i))))
                  (circles! gp [[cpp/GAMEPAD_BUTTON_MIDDLE_LEFT 365 170 10.0 C-RED]
                                [cpp/GAMEPAD_BUTTON_MIDDLE 405 170 10.0 C-GREEN]
                                [cpp/GAMEPAD_BUTTON_MIDDLE_RIGHT 445 170 10.0 C-BLUE]
                                [cpp/GAMEPAD_BUTTON_RIGHT_FACE_LEFT 516 191 15.0 C-GOLD]
                                [cpp/GAMEPAD_BUTTON_RIGHT_FACE_DOWN 551 227 15.0 C-BLUE]
                                [cpp/GAMEPAD_BUTTON_RIGHT_FACE_RIGHT 587 191 15.0 C-GREEN]
                                [cpp/GAMEPAD_BUTTON_RIGHT_FACE_UP 551 155 15.0 C-RED]])
                  (cpp/DrawRectangle 245 145 28 88 cpp/RAYWHITE)
                  (cpp/DrawRectangle 215 174 88 29 cpp/RAYWHITE)
                  (cpp/DrawRectangle 247 147 24 84 cpp/BLACK)
                  (cpp/DrawRectangle 217 176 84 25 cpp/BLACK)
                  (rects! gp [[cpp/GAMEPAD_BUTTON_LEFT_FACE_UP 247 147 24 29 C-RED]
                              [cpp/GAMEPAD_BUTTON_LEFT_FACE_DOWN 247 201 24 30 C-RED]
                              [cpp/GAMEPAD_BUTTON_LEFT_FACE_LEFT 217 176 30 25 C-RED]
                              [cpp/GAMEPAD_BUTTON_LEFT_FACE_RIGHT 271 176 30 25 C-RED]])
                  (cpp/DrawRectangleRounded
                   (cpp/Rectangle (cpp/float 215.0) (cpp/float 98.0)
                                  (cpp/float 100.0) (cpp/float 10.0))
                   (cpp/float 0.5) 16 cpp/DARKGRAY)
                  (cpp/DrawRectangleRounded
                   (cpp/Rectangle (cpp/float 495.0) (cpp/float 98.0)
                                  (cpp/float 100.0) (cpp/float 10.0))
                   (cpp/float 0.5) 16 cpp/DARKGRAY)
                  (when (cpp/IsGamepadButtonDown (cpp/int gp) cpp/GAMEPAD_BUTTON_LEFT_TRIGGER_1)
                    (cpp/DrawRectangleRounded
                     (cpp/Rectangle (cpp/float 215.0) (cpp/float 98.0)
                                    (cpp/float 100.0) (cpp/float 10.0))
                     (cpp/float 0.5) 16 (cpp/Color (cpp/cast cpp/uint8_t (nth C-RED 0)) (cpp/cast cpp/uint8_t (nth C-RED 1))
                             (cpp/cast cpp/uint8_t (nth C-RED 2)) (cpp/cast cpp/uint8_t 255))))
                  (when (cpp/IsGamepadButtonDown (cpp/int gp) cpp/GAMEPAD_BUTTON_RIGHT_TRIGGER_1)
                    (cpp/DrawRectangleRounded
                     (cpp/Rectangle (cpp/float 495.0) (cpp/float 98.0)
                                    (cpp/float 100.0) (cpp/float 10.0))
                     (cpp/float 0.5) 16 (cpp/Color (cpp/cast cpp/uint8_t (nth C-RED 0)) (cpp/cast cpp/uint8_t (nth C-RED 1))
                             (cpp/cast cpp/uint8_t (nth C-RED 2)) (cpp/cast cpp/uint8_t 255))))
                  (stick! gp 345 260 40.0 35.0 ax ay cpp/GAMEPAD_BUTTON_LEFT_THUMB)
                  (stick! gp 465 260 40.0 35.0 bx by cpp/GAMEPAD_BUTTON_RIGHT_THUMB)
                  (triggers! 151 644 110 15 70 lt rt)))

              (cpp/DrawText (str "DETECTED AXIS [" axis-count "]:") 10 50 10 cpp/MAROON)
              (loop [i 0]
                (when (< i axis-count)
                  (cpp/DrawText (str "AXIS " i ": "
                                     (fmt2 (+ 0.0 (cpp/GetGamepadAxisMovement (cpp/int gp) (cpp/int i)))))
                                20 (+ 70 (* 20 i)) 10 cpp/DARKGRAY)
                  (recur (inc i))))

              (cpp/DrawRectangleRec (cpp/Rectangle (cpp/float 10.0) (cpp/float vib-y)
                                                   (cpp/float 75.0) (cpp/float 24.0))
                                    cpp/SKYBLUE)
              (cpp/DrawText "VIBRATE" 24 (int (+ vib-y 1)) 10 cpp/DARKGRAY)

              (let [pressed (int (cpp/GetGamepadButtonPressed))]
                ;; jank's int does not accept a C enum value; cast first
                (if (not= pressed (+ 0 (cpp/cast cpp/int cpp/GAMEPAD_BUTTON_UNKNOWN)))
                  (cpp/DrawText (str "DETECTED BUTTON: " pressed) 10 430 10 cpp/RED)
                  (cpp/DrawText "DETECTED BUTTON: NONE" 10 430 10 cpp/GRAY))))

            (do
              (cpp/DrawText (str "GP" gp ": NOT DETECTED") 10 10 10 cpp/GRAY)
              (cpp/DrawTexture xbox 0 0 cpp/LIGHTGRAY)))

          (cpp/EndDrawing)
          (recur gp))))

    (cpp/UnloadTexture ps3)
    (cpp/UnloadTexture xbox))

  (cpp/CloseWindow))
