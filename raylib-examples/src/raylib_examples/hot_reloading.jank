(ns raylib-examples.hot-reloading
  "raylib [shaders] example - hot reloading, ported to jank.

  A full-screen fractal drawn by reload.fs; edit + save that shader
  file while the example runs and it hot-swaps in. A toggles auto
  reloading (polls the file every frame), otherwise LEFT CLICK checks
  once. ESC quits.
  Based on raylib/examples/shaders/shaders_hot_reloading.c

  jank-native notes:
  - The C reassigns its Shader when the file changes - a native value
    that must persist across frames but cannot thread through
    loop/recur (rule 2). It lives as an opaque box in a jank atom (the
    viewport-scaling render-target pattern), so the box can be swapped
    when the file changes. The reload keeps the old shader when the new
    one failed to compile (id == rlGetShaderIdDefault), matching the C.
  - Uniform locations DO thread through the loop as jank ints,
    re-queried after a successful swap.
  - GetFileModTime's time_t boxes to a jank int; the timestamp is
    formatted in jank rather than through asctime.
  - Native bools that feed and/or logic are boxed first via
    (if native true false) to keep both if-branch types jank."
  (:include "raylib.h" "rlgl.h" "time.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/shaders/resources/")

(defn- try-reload!
  "Load path; if it compiled (its id differs from the default shader's),
  unload the old one and swap the new box in. Returns true if swapped.

  The shader is hot-swapped at runtime, so it can neither be a create-once
  let-local nor ride loop/recur. A box in an atom carries it; cpp/new keeps
  it alive past the scope that made it.

  The unbox+deref is inlined at every use site rather than factored into a
  helper: a fn returning it would return a Shader&, which cannot cross a
  jank fn boundary."
  [box-atom path]
  (let [updated (cpp/LoadShader cpp/nullptr path)]
    (if (not= (int (+ 0.0 (.-id updated))) (int (+ 0.0 (cpp/rlGetShaderIdDefault))))
      (do (cpp/UnloadShader (cpp/* (cpp/unbox (:* cpp/Shader) @box-atom)))
          (reset! box-atom (cpp/box (cpp/new cpp/Shader updated)))
          true)
      false)))

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [shaders] example - hot reloading (jank)")

  (let [frag-path (str RES "shaders/glsl330/reload.fs")
        shader-box (atom (cpp/box (cpp/new cpp/Shader
                                           (cpp/LoadShader cpp/nullptr frag-path))))
        resolution-loc (int (cpp/GetShaderLocation (cpp/* (cpp/unbox (:* cpp/Shader) @shader-box)) "resolution"))
        mouse-loc0 (int (cpp/GetShaderLocation (cpp/* (cpp/unbox (:* cpp/Shader) @shader-box)) "mouse"))
        time-loc0 (int (cpp/GetShaderLocation (cpp/* (cpp/unbox (:* cpp/Shader) @shader-box)) "time"))]

    (cpp/SetShaderValue (cpp/* (cpp/unbox (:* cpp/Shader) @shader-box)) (int resolution-loc)
                        (cpp/new cpp/Vector2 (cpp/float 800.0) (cpp/float 450.0))
                        cpp/SHADER_UNIFORM_VEC2)

    (cpp/SetTargetFPS 60)

    ;; Thread [elapsed-seconds auto-reload? file-mod-time time-loc mouse-loc].
    (loop [total-time 0.0
           auto? false
           mod-time (int (cpp/GetFileModTime frag-path))
           time-loc time-loc0
           mouse-loc mouse-loc0]
      (when (cpp/! (cpp/WindowShouldClose))
        (let [total-time (+ total-time (+ 0.0 (cpp/GetFrameTime)))
              mouse (cpp/GetMousePosition)]

          (cpp/SetShaderValue (cpp/* (cpp/unbox (:* cpp/Shader) @shader-box)) (int time-loc)
                              (cpp/new cpp/float (cpp/float total-time)) cpp/SHADER_UNIFORM_FLOAT)
          (cpp/SetShaderValue (cpp/* (cpp/unbox (:* cpp/Shader) @shader-box)) (int mouse-loc)
                              (cpp/new cpp/Vector2 (cpp/float (+ 0.0 (.-x mouse)))
                                                   (cpp/float (+ 0.0 (.-y mouse))))
                              cpp/SHADER_UNIFORM_VEC2)

          ;; hot shader reloading (auto every frame, or once per click)
          (let [clicked? (if (cpp/IsMouseButtonPressed cpp/MOUSE_BUTTON_LEFT) true false)
                current-mod (if (or auto? clicked?)
                              (int (cpp/GetFileModTime frag-path))
                              mod-time)
                swapped? (if (not= current-mod mod-time)
                           (try-reload! shader-box frag-path)
                           false)
                time-loc (if swapped?
                           (int (cpp/GetShaderLocation (cpp/* (cpp/unbox (:* cpp/Shader) @shader-box)) "time"))
                           time-loc)
                mouse-loc (if swapped?
                            (int (cpp/GetShaderLocation (cpp/* (cpp/unbox (:* cpp/Shader) @shader-box)) "mouse"))
                            mouse-loc)
                auto? (if (cpp/IsKeyPressed cpp/KEY_A) (not auto?) auto?)]
            (when swapped?
              (cpp/SetShaderValue (cpp/* (cpp/unbox (:* cpp/Shader) @shader-box))
                                  (int (cpp/GetShaderLocation (cpp/* (cpp/unbox (:* cpp/Shader) @shader-box)) "resolution"))
                                  (cpp/new cpp/Vector2 (cpp/float 800.0) (cpp/float 450.0))
                                  cpp/SHADER_UNIFORM_VEC2))

            (cpp/BeginDrawing)
            (cpp/ClearBackground cpp/RAYWHITE)

            ;; only a white rectangle - the frame is generated in the shader
            (cpp/BeginShaderMode (cpp/* (cpp/unbox (:* cpp/Shader) @shader-box)))
            (cpp/DrawRectangle 0 0 WIDTH HEIGHT cpp/WHITE)
            (cpp/EndShaderMode)

            (cpp/DrawText (str "PRESS [A] to TOGGLE SHADER AUTOLOADING: "
                               (if auto? "AUTO" "MANUAL"))
                          10 10 10 (if auto? cpp/RED cpp/BLACK))
            (when (not auto?)
              (cpp/DrawText "MOUSE CLICK to SHADER RE-LOADING" 10 30 10 cpp/BLACK))
            (cpp/DrawText (str "Shader last modification: "
                               (let [tt (cpp/cast cpp/time_t (int current-mod))]
                                 (str (cpp/asctime (cpp/localtime (cpp/& tt))))))
                          10 430 10 cpp/BLACK)

            (cpp/EndDrawing)
            (recur total-time auto? current-mod time-loc mouse-loc)))))

    (cpp/UnloadShader (cpp/* (cpp/unbox (:* cpp/Shader) @shader-box))))

  (cpp/CloseWindow))
