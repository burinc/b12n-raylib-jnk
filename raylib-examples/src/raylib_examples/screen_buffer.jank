(ns raylib-examples.screen-buffer
  "raylib [textures] example - screen buffer, ported to jank.

  The classic DOS fire effect as a software screen buffer: a 400x225
  palette-indexed byte buffer is simulated every frame (embers grow
  at the bottom row, rise with random drift and decay) and blitted
  through a 256-color flame palette into a texture drawn at 2x. ESC
  quits.
  Based on raylib/examples/textures/textures_screen_buffer.c

  jank-native notes:
  - The per-frame simulation touches ~90k cells twice, which is far past
    the point where ordinary jank arithmetic can keep a frame budget: a
    `loop`/`recur` iteration costs ~810 ns boxed. The hot loops here use
    `cpp/` operators on `cpp/int` values instead, which costs ~65 ns an
    iteration, and that is the whole difference between this example
    running and not.
  - Measured, 400x225 = 90000 cells, ms per pass:
    C full step 0.390, jank rise 1.968, jank blit 1.880. Roughly 3.7 ms
    against a 16.7 ms budget at 60 FPS.
  - The index buffer, the ember roots and the palette are plain native
    allocations reached through boxes. They are byte and Color arrays,
    not values with identity, so `cpp/MemAlloc` plus `cpp/aget` is all
    they need.
  - The palette build and the two 400-wide row loops stay in ordinary
    jank: 256 and 400 iterations do not need the ceremony."
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)

(def ^:private MAX-COLORS 256)

(defn- make-palette
  "The C's flame ramp: hue eased by t*t so the low indices stay dark."
  []
  (let [pal (cpp/unsafe-cast (:* cpp/Color)
                             (cpp/MemAlloc (cpp/cast cpp/uint (* MAX-COLORS 4))))]
    (loop [i 0]
      (when (< i MAX-COLORS)
        (let [t (/ (+ 0.0 i) (- MAX-COLORS 1.0))
              hue (* t t)]
          (cpp/= (cpp/aget pal (cpp/int i))
                 (cpp/ColorFromHSV (cpp/float (+ 250.0 (* 150.0 hue)))
                                   (cpp/float t) (cpp/float t))))
        (recur (inc i))))
    (cpp/box pal)))

(defn- byte-alloc [n]
  (cpp/box (cpp/unsafe-cast (:* (:unsigned cpp/char))
                            (cpp/MemAlloc (cpp/cast cpp/uint n)))))

(defn- zero-fill!
  [box n]
  (let [p (cpp/unbox (:* (:unsigned cpp/char)) box)]
    (loop [i (cpp/int 0)]
      (when (cpp/< i (cpp/int n))
        (cpp/= (cpp/aget p i) (cpp/cast (:unsigned cpp/char) (cpp/int 0)))
        (recur (cpp/+ i (cpp/int 1))))))
  nil)

(defn- grow-roots!
  "Embers at the bottom brighten over time, capped at 255."
  [root-box w]
  (let [root (cpp/unbox (:* (:unsigned cpp/char)) root-box)]
    (loop [x 2]
      (when (< x w)
        (let [f (+ (int (cpp/cast cpp/int (cpp/aget root (cpp/int x))))
                   (int (cpp/GetRandomValue 0 2)))]
          (cpp/= (cpp/aget root (cpp/int x))
                 (cpp/cast (:unsigned cpp/char) (cpp/int (if (> f 255) 255 f)))))
        (recur (inc x)))))
  nil)

(defn- seed-and-clear!
  "Copy the ember roots into the bottom row, and blank the top row so
  nothing can rise past it."
  [buf-box root-box w h]
  (let [buf (cpp/unbox (:* (:unsigned cpp/char)) buf-box)
        root (cpp/unbox (:* (:unsigned cpp/char)) root-box)
        base (* (dec h) w)]
    (loop [x 0]
      (when (< x w)
        (cpp/= (cpp/aget buf (cpp/int (+ x base))) (cpp/aget root (cpp/int x)))
        (cpp/= (cpp/aget buf (cpp/int x)) (cpp/cast (:unsigned cpp/char) (cpp/int 0)))
        (recur (inc x)))))
  nil)

(defn- rise!
  "Every lit cell moves up one row with a random sideways drift and a
  random decay, clearing the cell it came from. Native ops throughout:
  this is ~90k iterations a frame."
  [buf-box w h]
  (let [buf (cpp/unbox (:* (:unsigned cpp/char)) buf-box)
        w (cpp/int w) h (cpp/int h)]
    (loop [y (cpp/int 1)]
      (when (cpp/< y h)
        (loop [x (cpp/int 0)]
          (when (cpp/< x w)
            (let [i (cpp/+ x (cpp/* y w))
                  ci (cpp/cast cpp/int (cpp/aget buf i))]
              (when (cpp/!= ci (cpp/int 0))
                (cpp/= (cpp/aget buf i) (cpp/cast (:unsigned cpp/char) (cpp/int 0)))
                (let [mv (cpp/- (cpp/GetRandomValue (cpp/int 0) (cpp/int 2)) (cpp/int 1))
                      nx (cpp/+ x mv)]
                  (when (cpp/&& (cpp/> nx (cpp/int 0)) (cpp/< nx w))
                    (let [ia (cpp/+ (cpp/- i w) mv)
                          d (cpp/GetRandomValue (cpp/int 0) (cpp/int 3))
                          nc (cpp/- ci (if (cpp/< d ci) d ci))]
                      (cpp/= (cpp/aget buf ia) (cpp/cast (:unsigned cpp/char) nc)))))))
            (recur (cpp/+ x (cpp/int 1)))))
        (recur (cpp/+ y (cpp/int 1))))))
  nil)

(defn- blit!
  "Palette-index the buffer into the image. ImageDrawPixel costs ~21 ns
  a call here, so there is no reason to reach past it into the pixel
  data even at 90k calls a frame."
  [img-box pal-box buf-box w h]
  (let [img (cpp/unbox (:* cpp/Image) img-box)
        pal (cpp/unbox (:* cpp/Color) pal-box)
        buf (cpp/unbox (:* (:unsigned cpp/char)) buf-box)
        w (cpp/int w) h (cpp/int h)]
    (loop [y (cpp/int 1)]
      (when (cpp/< y h)
        (loop [x (cpp/int 0)]
          (when (cpp/< x w)
            (cpp/ImageDrawPixel img x y
                                (cpp/aget pal (cpp/cast cpp/int
                                                        (cpp/aget buf (cpp/+ x (cpp/* y w))))))
            (recur (cpp/+ x (cpp/int 1)))))
        (recur (cpp/+ y (cpp/int 1))))))
  nil)

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [textures] example - screen buffer (jank)")

  ;; the software buffer runs at half resolution, drawn at 2x
  (let [img-w (int (quot WIDTH 2))
        img-h (int (quot HEIGHT 2))
        screen-image (cpp/GenImageColor img-w img-h cpp/BLACK)
        screen-texture (cpp/LoadTextureFromImage screen-image)
        img-box (cpp/box (cpp/& screen-image))
        pal-box (make-palette)
        buf-box (byte-alloc (* img-w img-h))
        root-box (byte-alloc img-w)]

    ;; MemAlloc does not zero, unlike the C's RL_CALLOC
    (zero-fill! buf-box (* img-w img-h))
    (zero-fill! root-box img-w)

    (cpp/SetTargetFPS 60)

    (loop []
      (when (cpp/! (cpp/WindowShouldClose))
        (grow-roots! root-box img-w)
        (seed-and-clear! buf-box root-box img-w img-h)
        (rise! buf-box img-w img-h)
        (blit! img-box pal-box buf-box img-w img-h)
        (cpp/UpdateTexture screen-texture (.-data screen-image))

        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/RAYWHITE)
        (cpp/DrawTextureEx screen-texture
                           (cpp/Vector2 (cpp/float 0.0) (cpp/float 0.0))
                           (cpp/float 0.0) (cpp/float 2.0) cpp/WHITE)
        (cpp/EndDrawing)
        (recur)))

    (cpp/MemFree (cpp/unbox (:* cpp/Color) pal-box))
    (cpp/MemFree (cpp/unbox (:* (:unsigned cpp/char)) buf-box))
    (cpp/MemFree (cpp/unbox (:* (:unsigned cpp/char)) root-box))
    (cpp/UnloadTexture screen-texture)
    (cpp/UnloadImage screen-image))

  (cpp/CloseWindow))
