(ns raylib-examples.simple-mask
  "raylib [shaders] example - simple mask, ported to jank.

  A tumbling torus and a tilted cube whose plasma texture is eaten
  away by an animated mask texture (holes reveal the sphere behind);
  the mask rides the spare MATERIAL_MAP_EMISSION slot as a second
  sampler. First-person camera (WASD + mouse). ESC quits.
  Based on raylib/examples/shaders/shaders_simple_mask.c

  jank-native notes:
  - MATERIAL_MAP_EMISSION as a second texture slot: the map-slot
    parameterized texture-write shim (no mipmap setup here, unlike
    normalmap-rendering's).
  - model1.transform = MatrixRotateXYZ(rotation) is an absolute set
    from three jank-threaded angles (a 3-angle shim); DrawModelEx's
    axis/angle/scale args are all by-value and call directly.
  - The frame counter is a jank int re-sent as an INT uniform each
    frame through the rlights setter toolbox."
  (:require [raylib-examples.models :as md]
            [raylib-examples.shaders :as sh])
  (:include "raylib.h" "raymath.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/shaders/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [shaders] example - simple mask (jank)")

  (let [camera (cpp/Camera3D (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 2.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 45.0)
                             cpp/CAMERA_PERSPECTIVE)
        model1 (cpp/LoadModelFromMesh (cpp/GenMeshTorus (cpp/float 0.3) (cpp/float 1.0) 16 32))
        model2 (cpp/LoadModelFromMesh (cpp/GenMeshCube (cpp/float 0.8) (cpp/float 0.8) (cpp/float 0.8)))
        model3 (cpp/LoadModelFromMesh (cpp/GenMeshSphere (cpp/float 1.0) 16 16))
        shader (cpp/LoadShader cpp/nullptr (str RES "shaders/glsl330/mask.fs"))
        ;; boxed here, where the shader is still native (see rlights ns)
        sh-box (cpp/box (cpp/new cpp/Shader shader))
        tex-diffuse (cpp/LoadTexture (str RES "plasma.png"))
        tex-mask (cpp/LoadTexture (str RES "mask.png"))
        frame-loc (int (cpp/GetShaderLocation shader "frame"))]

    (md/set-map-texture! (cpp/box (cpp/new cpp/Model model1)) 0 (cpp/int cpp/MATERIAL_MAP_DIFFUSE)
                         (cpp/box (cpp/new cpp/Texture2D tex-diffuse)))
    (md/set-map-texture! (cpp/box (cpp/new cpp/Model model2)) 0 (cpp/int cpp/MATERIAL_MAP_DIFFUSE)
                         (cpp/box (cpp/new cpp/Texture2D tex-diffuse)))

    ;; the mask rides the spare EMISSION slot (cube-map slots won't do)
    (md/set-map-texture! (cpp/box (cpp/new cpp/Model model1)) 0 (cpp/int cpp/MATERIAL_MAP_EMISSION)
                         (cpp/box (cpp/new cpp/Texture2D tex-mask)))
    (md/set-map-texture! (cpp/box (cpp/new cpp/Model model2)) 0 (cpp/int cpp/MATERIAL_MAP_EMISSION)
                         (cpp/box (cpp/new cpp/Texture2D tex-mask)))
    (sh/set-shader-loc! sh-box cpp/SHADER_LOC_MAP_EMISSION
                                (int (cpp/GetShaderLocation shader "mask")))

    (md/set-shader! (cpp/box (cpp/new cpp/Model model1)) 0 (cpp/box (cpp/new cpp/Shader shader)))
    (md/set-shader! (cpp/box (cpp/new cpp/Model model2)) 0 (cpp/box (cpp/new cpp/Shader shader)))

    (cpp/DisableCursor)
    (cpp/SetTargetFPS 60)

    ;; Thread [frames-counter rot-x rot-y rot-z].
    (loop [frames 0
           rx 0.0
           ry 0.0
           rz 0.0]
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/UpdateCamera (cpp/& camera) cpp/CAMERA_FIRST_PERSON)

        (let [frames (inc frames)
              rx (+ rx 0.01)
              ry (+ ry 0.005)
              rz (- rz 0.0025)]

          (sh/set-int! sh-box frame-loc (int frames))
          (cpp/= (.-transform model1)
                 (cpp/MatrixRotateXYZ (cpp/Vector3 (cpp/float rx) (cpp/float ry) (cpp/float rz))))

          (cpp/BeginDrawing)
          (cpp/ClearBackground cpp/DARKBLUE)

          (cpp/BeginMode3D camera)
          (cpp/DrawModel model1
                         (cpp/Vector3 (cpp/float 0.5) (cpp/float 0.0) (cpp/float 0.0))
                         (cpp/float 1.0) cpp/WHITE)
          (cpp/DrawModelEx model2
                           (cpp/Vector3 (cpp/float -0.5) (cpp/float 0.0) (cpp/float 0.0))
                           (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 0.0))
                           (cpp/float 50.0)
                           (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                           cpp/WHITE)
          (cpp/DrawModel model3
                         (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float -1.5))
                         (cpp/float 1.0) cpp/WHITE)
          (cpp/DrawGrid 10 (cpp/float 1.0))
          (cpp/EndMode3D)

          ;; frame readout (kept at the window bottom, unlike the C's
          ;; off-screen y=700 on a 450-high window)
          (cpp/DrawRectangle 16 (- HEIGHT 52)
                             (+ (int (cpp/MeasureText (str "Frame: " frames) 20)) 8) 42 cpp/BLUE)
          (cpp/DrawText (str "Frame: " frames) 20 (- HEIGHT 50) 20 cpp/WHITE)
          (cpp/DrawFPS 10 10)

          (cpp/EndDrawing)
          (recur frames rx ry rz))))

    (cpp/UnloadModel model1)
    (cpp/UnloadModel model2)
    (cpp/UnloadModel model3)
    (cpp/UnloadTexture tex-diffuse)
    (cpp/UnloadTexture tex-mask)
    (cpp/UnloadShader shader))

  (cpp/CloseWindow))
