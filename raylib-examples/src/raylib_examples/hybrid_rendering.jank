(ns raylib-examples.hybrid-rendering
  "raylib [shaders] example - hybrid rendering, ported to jank.

  Raymarching and rasterization in ONE scene: a raymarch shader draws
  spheres and writes real gl_FragDepth, then ordinary rasterized
  cubes draw into the same depth-texture framebuffer - the two
  worlds occlude each other correctly. An orbital camera circles the
  mix. ESC quits.
  Based on raylib/examples/shaders/shaders_hybrid_rendering.c

  jank-native notes:
  - Same rendertex.jank depth target as depth-writing.
  - The per-frame camPos/camDir VEC3 push reads the camera fields with
    .-position / .-target and computes camDir = normalize(target -
    position) * camDist in jank.
  - rlEnableDepthTest is a direct rlgl call (depth testing must be
    on manually while mixing rendering methods inside the FBO)."
  (:require [raylib-examples.rendertex :as rt])
  (:include "raylib.h" "rlgl.h" "math.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/shaders/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [shaders] example - hybrid rendering (jank)")

  (let [shdr-raymarch (cpp/LoadShader cpp/nullptr (str RES "shaders/glsl330/hybrid_raymarch.fs"))
        shdr-raster (cpp/LoadShader cpp/nullptr (str RES "shaders/glsl330/hybrid_raster.fs"))
        cam-pos-loc (int (cpp/GetShaderLocation shdr-raymarch "camPos"))
        cam-dir-loc (int (cpp/GetShaderLocation shdr-raymarch "camDir"))
        screen-center-loc (int (cpp/GetShaderLocation shdr-raymarch "screenCenter"))
        target-box (rt/load-depth! WIDTH HEIGHT)
        target (cpp/* (cpp/unbox (:* cpp/RenderTexture2D) target-box))
        camera (cpp/Camera3D (cpp/Vector3 (cpp/float 0.5) (cpp/float 1.0) (cpp/float 1.5))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.5) (cpp/float 0.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 45.0)
                             cpp/CAMERA_PERSPECTIVE)
        ;; FOV pre-baked into the ray direction length: 1/tan(fovy/2)
        cam-dist (/ 1.0 (+ 0.0 (cpp/tan (* 45.0 0.5 (/ 3.141592653589793 180.0)))))]

    (cpp/SetShaderValue shdr-raymarch (int screen-center-loc)
                        (cpp/new cpp/Vector2 (cpp/float (/ WIDTH 2.0)) (cpp/float (/ HEIGHT 2.0)))
                        cpp/SHADER_UNIFORM_VEC2)

    (cpp/SetTargetFPS 60)

    (loop []
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/UpdateCamera (cpp/& camera) cpp/CAMERA_ORBITAL)
        ;; camera position, and a direction scaled to cam-dist, as VEC3s
        (let [px (+ 0.0 (.-x (.-position camera)))
              py (+ 0.0 (.-y (.-position camera)))
              pz (+ 0.0 (.-z (.-position camera)))
              dx (- (+ 0.0 (.-x (.-target camera))) px)
              dy (- (+ 0.0 (.-y (.-target camera))) py)
              dz (- (+ 0.0 (.-z (.-target camera))) pz)
              len (+ 0.0 (cpp/sqrt (+ (* dx dx) (* dy dy) (* dz dz))))
              k (if (> len 0.0) (/ cam-dist len) 0.0)]
          (cpp/SetShaderValue shdr-raymarch (int cam-pos-loc)
                              (cpp/new cpp/Vector3 (cpp/float px) (cpp/float py) (cpp/float pz))
                              cpp/SHADER_UNIFORM_VEC3)
          (cpp/SetShaderValue shdr-raymarch (int cam-dir-loc)
                              (cpp/new cpp/Vector3 (cpp/float (* dx k)) (cpp/float (* dy k))
                                                   (cpp/float (* dz k)))
                              cpp/SHADER_UNIFORM_VEC3))

        (cpp/BeginTextureMode target)
        (cpp/ClearBackground cpp/WHITE)

        ;; raymarched spheres (the shader writes real gl_FragDepth)
        (cpp/rlEnableDepthTest)
        (cpp/BeginShaderMode shdr-raymarch)
        (cpp/DrawRectangleRec (cpp/Rectangle (cpp/float 0.0) (cpp/float 0.0)
                                             (cpp/float 800.0) (cpp/float 450.0))
                              cpp/WHITE)
        (cpp/EndShaderMode)

        ;; rasterized cubes into the same depth buffer
        (cpp/BeginMode3D camera)
        (cpp/BeginShaderMode shdr-raster)
        (cpp/DrawCubeWiresV (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.5) (cpp/float 1.0))
                            (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                            cpp/RED)
        (cpp/DrawCubeV (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.5) (cpp/float 1.0))
                       (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                       cpp/PURPLE)
        (cpp/DrawCubeWiresV (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.5) (cpp/float -1.0))
                            (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                            cpp/DARKGREEN)
        (cpp/DrawCubeV (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.5) (cpp/float -1.0))
                       (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                       cpp/YELLOW)
        (cpp/DrawGrid 10 (cpp/float 1.0))
        (cpp/EndShaderMode)
        (cpp/EndMode3D)
        (cpp/EndTextureMode)

        ;; blit to screen (y-flipped)
        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/RAYWHITE)
        (cpp/DrawTextureRec (.-texture target)
                            (cpp/Rectangle (cpp/float 0.0) (cpp/float 0.0)
                                           (cpp/float 800.0) (cpp/float -450.0))
                            (cpp/Vector2 (cpp/float 0.0) (cpp/float 0.0))
                            cpp/WHITE)
        (cpp/DrawFPS 10 10)
        (cpp/EndDrawing)

        (recur)))

    (rt/unload-depth! target-box)
    (cpp/UnloadShader shdr-raymarch)
    (cpp/UnloadShader shdr-raster))

  (cpp/CloseWindow))
