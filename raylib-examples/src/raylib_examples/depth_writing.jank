(ns raylib-examples.depth-writing
  "raylib [shaders] example - depth writing, ported to jank.

  Two cubes on a grid, orbited by an auto camera, rendered into a
  custom RenderTexture whose depth buffer is a writable TEXTURE (not
  raylib's default renderbuffer). The depth_write shader inverts the
  depth of everything it draws (gl_FragDepth = 1 - gl_FragCoord.z),
  so nearer fragments LOSE the depth test - the scene renders
  inside-out. ESC quits.
  Based on raylib/examples/shaders/shaders_depth_writing.c

  jank-native notes:
  - The C builds its custom framebuffer with rlgl calls
    (rlLoadFramebuffer / rlLoadTexture / rlLoadTextureDepth /
    rlFramebufferAttach) and hand-fills the RenderTexture2D struct
    fields. That is rendertex.jank's load-depth! / unload-depth!, which
    returns the target boxed.
  - Everything else is proven ground: UpdateCamera((cpp/& camera)
    CAMERA_ORBITAL) on an outer-let Camera3D, inline cpp/Vector3 draw
    args, and the y-flipped DrawTextureRec blit."
  (:require [raylib-examples.rendertex :as rt])
  (:include "raylib.h" "rlgl.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/shaders/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [shaders] example - depth writing (jank)")

  (let [camera (cpp/Camera3D (cpp/Vector3 (cpp/float 2.0) (cpp/float 2.0) (cpp/float 3.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.5) (cpp/float 0.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 45.0)
                             cpp/CAMERA_PERSPECTIVE)
        target-box (rt/load-depth! WIDTH HEIGHT)
        target (cpp/* (cpp/unbox (:* cpp/RenderTexture2D) target-box))
        shader (cpp/LoadShader cpp/nullptr (str RES "shaders/glsl330/depth_write.fs"))]

    (cpp/SetTargetFPS 60)

    (loop []
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/UpdateCamera (cpp/& camera) cpp/CAMERA_ORBITAL)

        ;; scene into the depth-texture framebuffer, depths inverted
        (cpp/BeginTextureMode target)
        (cpp/ClearBackground cpp/WHITE)
        (cpp/BeginMode3D camera)
        (cpp/BeginShaderMode shader)
        (cpp/DrawCubeWiresV (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.5) (cpp/float 1.0))
                            (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                            cpp/RED)
        (cpp/DrawCubeV (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.5) (cpp/float 1.0))
                       (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                       cpp/PURPLE)
        (cpp/DrawCubeWiresV (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.5) (cpp/float -1.0))
                            (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                            cpp/DARKGREEN)
        (cpp/DrawCubeV (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.5) (cpp/float -1.0))
                       (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                       cpp/YELLOW)
        (cpp/DrawGrid 10 (cpp/float 1.0))
        (cpp/EndShaderMode)
        (cpp/EndMode3D)
        (cpp/EndTextureMode)

        ;; blit the render texture to the screen (y-flipped)
        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/RAYWHITE)
        (cpp/DrawTextureRec (.-texture target)
                            (cpp/Rectangle (cpp/float 0.0) (cpp/float 0.0)
                                           (cpp/float 800.0) (cpp/float -450.0))
                            (cpp/Vector2 (cpp/float 0.0) (cpp/float 0.0))
                            cpp/WHITE)
        (cpp/DrawFPS 10 10)
        (cpp/EndDrawing)

        (recur)))

    (rt/unload-depth! target-box)
    (cpp/UnloadShader shader))

  (cpp/CloseWindow))
