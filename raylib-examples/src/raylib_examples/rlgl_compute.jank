(ns raylib-examples.rlgl-compute
  "raylib [shaders] example - rlgl compute, ported to jank.

  Conway's Game of Life run ENTIRELY on the GPU: a compute shader
  steps the world in two ping-ponged shader storage buffers, a second
  compute shader stamps mouse strokes into the grid, and a fragment
  shader renders the live cells. LEFT draws, RIGHT erases, WHEEL
  changes the brush. ESC quits.
  Based on raylib/examples/shaders/shaders_rlgl_compute.c

  jank-native notes:
  - FIRST COMPUTE SHADERS: requires jank-raylib-sys built with
    OPENGL_VERSION 4.3 (same GL 3.3 feature set + compute; flipped in
    the wrapper's jank-build.bb for this port).
  - Compute programs load with direct rlgl calls (LoadFileText ->
    rlLoadShader RL_COMPUTE_SHADER -> rlLoadShaderProgramCompute);
    the intermediate shader ids are not kept for unload - the GL
    context teardown reclaims them (simplification vs the C).
  - The mouse-command SSBO struct (count + 48 GolUpdateCmd) is a
    cpp/MemAlloc array behind a box; the grid
    SSBOs are plain unsigned-int ids held as JANK ints, so the
    classic ssboA<->ssboB ping-pong swap is just recur with the loop
    vars exchanged.
  - rlEnableShader / rlBindShaderBuffer / rlComputeShaderDispatch are
    direct rlgl calls with jank-int ids."
  (:require [raylib-examples.shaders :as sh])
  (:include "raylib.h" "rlgl.h"))

;; IMPORTANT: must match the gol*.glsl GOL_WIDTH constant (multiple of 16).
(def GOL-WIDTH 768)
(def RES "../jank-raylib-sys/raylib/examples/shaders/resources/")

(def ^:private MAX-CMDS 48)

;; The transfer SSBO the compute shader reads:
;;   struct { uint count; struct { uint x, y, w, enabled; } commands[48]; }
;; Every member is a uint, so the whole thing is a flat uint array:
;; slot 0 is the count, and command i occupies slots 1+i*4 .. 4+i*4.
(def ^:private SSBO-UINTS (inc (* MAX-CMDS 4)))

(defn- load-compute
  "Compile one .glsl compute program and return its id."
  [path]
  (let [code (cpp/LoadFileText path)
        sh (cpp/rlLoadShader code (cpp/int cpp/RL_COMPUTE_SHADER))
        prog (cpp/rlLoadShaderProgramCompute sh)]
    (cpp/UnloadFileText code)
    (int (+ 0.0 prog))))

(defn- cmd-buffer!
  "The transfer SSBO's CPU-side mirror, zeroed, boxed."
  []
  (let [p (cpp/unsafe-cast (:* cpp/uint)
                           (cpp/MemAlloc (cpp/cast cpp/uint (* SSBO-UINTS 4))))]
    (loop [i 0]
      (when (< i SSBO-UINTS)
        (cpp/= (cpp/aget p (cpp/int i)) (cpp/cast cpp/uint 0))
        (recur (inc i))))
    (cpp/box p)))

(defn- cmd-count [buf] (int (+ 0.0 (cpp/aget (cpp/unbox (:* cpp/uint) buf) (cpp/int 0)))))

(defn- buffer-cmd!
  "Append one brush stroke, if there is room."
  [buf x y w enabled]
  (let [p (cpp/unbox (:* cpp/uint) buf)
        n (cmd-count buf)]
    (when (< n MAX-CMDS)
      (let [base (inc (* n 4))]
        (cpp/= (cpp/aget p (cpp/int base)) (cpp/cast cpp/uint (int x)))
        (cpp/= (cpp/aget p (cpp/int (+ base 1))) (cpp/cast cpp/uint (int y)))
        (cpp/= (cpp/aget p (cpp/int (+ base 2))) (cpp/cast cpp/uint (int w)))
        (cpp/= (cpp/aget p (cpp/int (+ base 3))) (cpp/cast cpp/uint (int enabled)))
        (cpp/= (cpp/aget p (cpp/int 0)) (cpp/cast cpp/uint (inc n))))))
  nil)

(defn- flush-cmds!
  "Upload the buffered strokes, dispatch one thread per command, reset."
  [buf ssbo-transfert program ssbo-a]
  (let [p (cpp/unbox (:* cpp/uint) buf)
        n (cmd-count buf)]
    (cpp/rlUpdateShaderBuffer (cpp/cast cpp/uint ssbo-transfert)
                              (cpp/unsafe-cast (:* (:const cpp/void)) p)
                              (cpp/cast cpp/uint (* SSBO-UINTS 4)) (cpp/cast cpp/uint 0))
    (cpp/rlEnableShader (cpp/cast cpp/uint program))
    (cpp/rlBindShaderBuffer (cpp/cast cpp/uint ssbo-a) (cpp/cast cpp/uint 1))
    (cpp/rlBindShaderBuffer (cpp/cast cpp/uint ssbo-transfert) (cpp/cast cpp/uint 3))
    (cpp/rlComputeShaderDispatch (cpp/cast cpp/uint n) (cpp/cast cpp/uint 1) (cpp/cast cpp/uint 1))
    (cpp/rlDisableShader)
    (cpp/= (cpp/aget p (cpp/int 0)) (cpp/cast cpp/uint 0)))
  nil)

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow GOL-WIDTH GOL-WIDTH "raylib [shaders] example - rlgl compute (jank)")

  (let [gol-logic-prog (load-compute (str RES "shaders/glsl430/gol.glsl"))
        gol-render-shader (cpp/LoadShader cpp/nullptr (str RES "shaders/glsl430/gol_render.glsl"))
        ;; boxed here, where shader is still native (see rlights ns)
        render-box (cpp/box (cpp/new cpp/Shader gol-render-shader))
        res-loc (int (cpp/GetShaderLocation gol-render-shader "resolution"))
        gol-transfert-prog (load-compute (str RES "shaders/glsl430/gol_transfert.glsl"))
        ;; two ping-ponged world buffers (768*768 u32 cells) + the command buffer
        ssbo-bytes (* GOL-WIDTH GOL-WIDTH 4)
        ssbo-a0 (int (cpp/rlLoadShaderBuffer ssbo-bytes cpp/nullptr cpp/RL_DYNAMIC_COPY))
        ssbo-b0 (int (cpp/rlLoadShaderBuffer ssbo-bytes cpp/nullptr cpp/RL_DYNAMIC_COPY))
        ssbo-transfert (int (+ 0.0 (cpp/rlLoadShaderBuffer
                                     (cpp/cast cpp/uint (* SSBO-UINTS 4))
                                     cpp/nullptr cpp/RL_DYNAMIC_COPY)))
        cmds (cmd-buffer!)
        white-image (cpp/GenImageColor GOL-WIDTH GOL-WIDTH cpp/WHITE)
        white-tex (cpp/LoadTextureFromImage white-image)
        _ (cpp/UnloadImage white-image)]

    ;; Thread [brush-size ssbo-a ssbo-b] - the ping-pong swap is a recur.
    (loop [brush 8
           ssbo-a ssbo-a0
           ssbo-b ssbo-b0]
      (when (cpp/! (cpp/WindowShouldClose))
        (let [brush (int (+ brush (int (+ 0.0 (cpp/GetMouseWheelMove)))))
              mx (int (cpp/GetMouseX))
              my (int (cpp/GetMouseY))
              half (int (quot brush 2))
              drawing? (if (cpp/IsMouseButtonDown cpp/MOUSE_BUTTON_LEFT) true false)
              erasing? (if (cpp/IsMouseButtonDown cpp/MOUSE_BUTTON_RIGHT) true false)
              count-before (cmd-count cmds)
              buffering? (and (or drawing? erasing?) (< count-before 48))
              stepping? (and (not buffering?) (<= count-before 0))]

          (cond buffering?
                ;; stamp a brush square into the command buffer
                (buffer-cmd! cmds (- mx half) (- my half) brush
                             (if drawing? 1 0))

                (> count-before 0)
                ;; upload + apply the buffered strokes on the GPU
                (flush-cmds! cmds ssbo-transfert gol-transfert-prog ssbo-a)

                :else
                ;; step the world: one compute thread per 16x16 tile
                (do (cpp/rlEnableShader gol-logic-prog)
                    (cpp/rlBindShaderBuffer ssbo-a 1)
                    (cpp/rlBindShaderBuffer ssbo-b 2)
                    (cpp/rlComputeShaderDispatch (int (quot GOL-WIDTH 16))
                                                 (int (quot GOL-WIDTH 16)) 1)
                    (cpp/rlDisableShader)))

          ;; after a step the fresh world is in B: ping-pong the ids
          (let [ssbo-a' (if stepping? ssbo-b ssbo-a)
                ssbo-b' (if stepping? ssbo-a ssbo-b)]

            (cpp/rlBindShaderBuffer ssbo-a' 1)
            (sh/set-vec2! render-box res-loc
                                  (+ 0.0 GOL-WIDTH) (+ 0.0 GOL-WIDTH))

            (cpp/BeginDrawing)
            (cpp/ClearBackground cpp/BLANK)

            (cpp/BeginShaderMode gol-render-shader)
            (cpp/DrawTexture white-tex 0 0 cpp/WHITE)
            (cpp/EndShaderMode)

            (cpp/DrawRectangleLines (- mx half) (- my half) brush brush cpp/RED)
            (cpp/DrawText "Use Mouse wheel to increase/decrease brush size" 10 10 20 cpp/WHITE)
            (cpp/DrawFPS (- GOL-WIDTH 100) 10)

            (cpp/EndDrawing)
            (recur brush ssbo-a' ssbo-b')))))

    (cpp/rlUnloadShaderBuffer ssbo-a0)
    (cpp/rlUnloadShaderBuffer ssbo-b0)
    (cpp/rlUnloadShaderBuffer ssbo-transfert)
    (cpp/UnloadTexture white-tex)
    (cpp/UnloadShader gol-render-shader))

  (cpp/CloseWindow))
