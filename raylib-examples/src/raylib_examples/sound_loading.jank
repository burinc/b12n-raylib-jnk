(ns raylib-examples.sound-loading
  "raylib [audio] example - sound loading, ported to jank.

  The first example of the audio category: a WAV and an OGG loaded as
  Sounds; SPACE plays the WAV, ENTER plays the OGG, Q quits.
  Based on raylib/examples/audio/audio_sound_loading.c
  (jank-native: InitAudioDevice / LoadSound / PlaySound are plain
  raylib.h functions - no wrapper changes; the two Sound structs are
  outer-let locals captured by the frame loop, like textures.)"
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/audio/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [audio] example - sound loading (jank)")
  (cpp/InitAudioDevice)
  (cpp/SetTargetFPS 60)

  (let [fx-wav (cpp/LoadSound (str RES "sound.wav"))
        fx-ogg (cpp/LoadSound (str RES "target.ogg"))]

    (loop []
      (when (cpp/! (cpp/WindowShouldClose))
        (when (cpp/IsKeyPressed cpp/KEY_SPACE)
          (cpp/PlaySound fx-wav))
        (when (cpp/IsKeyPressed cpp/KEY_ENTER)
          (cpp/PlaySound fx-ogg))

        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/RAYWHITE)
        (cpp/DrawText "Press SPACE to PLAY the WAV sound!" 200 180 20 cpp/LIGHTGRAY)
        (cpp/DrawText "Press ENTER to PLAY the OGG sound!" 200 220 20 cpp/LIGHTGRAY)
        (cpp/DrawText "Q to quit" 10 10 10 cpp/GRAY)
        (cpp/EndDrawing)

        (when-not (cpp/IsKeyDown cpp/KEY_Q)
          (recur))))

    (cpp/UnloadSound fx-wav)
    (cpp/UnloadSound fx-ogg))

  (cpp/CloseAudioDevice)
  (cpp/CloseWindow))
