(ns raylib-examples.texture-rendering
  "raylib [shaders] example - texture rendering, ported to jank.

  A 1024x1024 BLANK texture drawn through the cubes_panning fragment
  shader: every visible pixel is painted and animated by the shader
  (two layers of panning cube grids), the texture itself is empty.
  ESC quits.
  Based on raylib/examples/shaders/shaders_texture_rendering.c

  jank-native notes:
  - The simplest animated-uniform shader port: one FLOAT uniform
    (uTime) re-sent every frame as a plain SetShaderValue over a
    cpp/new float, fed from GetTime rather than an accumulated frame delta."
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/shaders/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [shaders] example - texture rendering (jank)")

  (let [im-blank (cpp/GenImageColor 1024 1024 cpp/BLANK)
        texture (cpp/LoadTextureFromImage im-blank)
        _ (cpp/UnloadImage im-blank)
        shader (cpp/LoadShader cpp/nullptr (str RES "shaders/glsl330/cubes_panning.fs"))
        time-loc (int (cpp/GetShaderLocation shader "uTime"))]

    (cpp/SetTargetFPS 60)

    (loop []
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/SetShaderValue shader (int time-loc)
                            (cpp/new cpp/float (cpp/float (+ 0.0 (cpp/GetTime)))) cpp/SHADER_UNIFORM_FLOAT)

        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/RAYWHITE)

        (cpp/BeginShaderMode shader)
        ;; the texture is BLANK - all rendering happens in the shader
        (cpp/DrawTexture texture 0 0 cpp/WHITE)
        (cpp/EndShaderMode)

        (cpp/DrawText "BACKGROUND is PAINTED and ANIMATED on SHADER!" 10 10 20 cpp/MAROON)

        (cpp/EndDrawing)
        (recur)))

    (cpp/UnloadShader shader)
    (cpp/UnloadTexture texture))

  (cpp/CloseWindow))
