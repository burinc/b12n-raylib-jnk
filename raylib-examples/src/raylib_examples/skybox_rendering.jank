(ns raylib-examples.skybox-rendering
  "raylib [models] example - skybox rendering, ported to jank.

  A cubemap skybox wrapped around the world: a unit cube drawn from
  the INSIDE (backface culling + depth writes off) through the skybox
  shader, its texture a TextureCubemap loaded from a six-face layout
  image. First-person camera (WASD + mouse). ESC quits.
  Based on raylib/examples/models/models_skybox_rendering.c

  jank-native notes:
  - First LoadTextureCubemap: Image in by value + the layout enum,
    a Texture back - bound to MATERIAL_MAP_CUBEMAP via the map-slot
    shim. rlDisableBackfaceCulling / rlDisableDepthMask around the
    draw are direct rlgl calls.
  - Simplifications vs the C (both off by default there): the HDR
    panorama->cubemap path (GenTextureCubemap render-to-cubemap) and
    the drag&drop skybox swap are dropped."
  (:require [raylib-examples.rlights :as rl])
  (:include "raylib.h" "rlgl.h"))

(cpp/raw "static void jank_model_set_shader(Model* m, Shader s) {
  m->materials[0].shader = s;
}
static void jank_model_set_map_texture(Model* m, int map, Texture2D tex) {
  m->materials[0].maps[map].texture = tex;
}")

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/models/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [models] example - skybox rendering (jank)")

  (let [camera (cpp/Camera3D (cpp/Vector3 (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0))
                             (cpp/Vector3 (cpp/float 4.0) (cpp/float 1.0) (cpp/float 4.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 45.0)
                             cpp/CAMERA_PERSPECTIVE)
        skybox (cpp/LoadModelFromMesh (cpp/GenMeshCube (cpp/float 1.0) (cpp/float 1.0) (cpp/float 1.0)))
        shader (cpp/LoadShader (str RES "shaders/glsl330/skybox.vs")
                               (str RES "shaders/glsl330/skybox.fs"))
        ;; boxed here, where shader is still native (see rlights ns)
        sh-box (cpp/box (cpp/new cpp/Shader shader))]

    ;; the skybox samples its cubemap from the CUBEMAP material slot
    (rl/set-int! sh-box (int (cpp/GetShaderLocation shader "environmentMap"))
                         (cpp/int cpp/MATERIAL_MAP_CUBEMAP))
    (rl/set-int! sh-box (int (cpp/GetShaderLocation shader "doGamma")) 0)
    (rl/set-int! sh-box (int (cpp/GetShaderLocation shader "vflipped")) 0)
    (cpp/jank_model_set_shader (cpp/& skybox) shader)

    ;; six-face layout image -> cubemap texture
    (let [image (cpp/LoadImage (str RES "skybox.png"))]
      (cpp/jank_model_set_map_texture (cpp/& skybox) (cpp/int cpp/MATERIAL_MAP_CUBEMAP)
                                      (cpp/LoadTextureCubemap image cpp/CUBEMAP_LAYOUT_AUTO_DETECT))
      (cpp/UnloadImage image))

    (cpp/DisableCursor)
    (cpp/SetTargetFPS 60)

    (loop []
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/UpdateCamera (cpp/& camera) cpp/CAMERA_FIRST_PERSON)

        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/RAYWHITE)

        (cpp/BeginMode3D camera)

        ;; we are INSIDE the cube: no culling, no depth writes
        (cpp/rlDisableBackfaceCulling)
        (cpp/rlDisableDepthMask)
        (cpp/DrawModel skybox
                       (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                       (cpp/float 1.0) cpp/WHITE)
        (cpp/rlEnableBackfaceCulling)
        (cpp/rlEnableDepthMask)

        (cpp/DrawGrid 10 (cpp/float 1.0))

        (cpp/EndMode3D)

        (cpp/DrawText ": skybox.png" 10 (- HEIGHT 20) 10 cpp/BLACK)
        (cpp/DrawFPS 10 10)

        (cpp/EndDrawing)
        (recur)))

    (cpp/UnloadShader shader)
    (cpp/UnloadModel skybox))

  (cpp/CloseWindow))
