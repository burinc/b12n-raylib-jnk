(ns raylib-examples.vr-simulator
  "raylib [core] example - vr simulator, ported to jank.

  Renders a simple 3D scene (a red cube on a grid) in stereo through a
  simulated Oculus Rift CV1: the scene is drawn twice into an HMD-sized
  RenderTexture inside BeginVrStereoMode, then a lens-distortion +
  chromatic-aberration fragment shader warps that texture onto the
  window. No headset required - it is a *simulator*. Move with the mouse
  (first-person camera). ESC quits.
  Based on raylib/examples/core/core_vr_simulator.c (3/4 complexity).

  jank-native notes:
  - The whole VR pipeline is native values jank can't build or carry: a
    VrDeviceInfo filled with designated-initializer scalar + float[]
    fields, the VrStereoConfig from LoadVrStereoConfig, the distortion
    Shader (fed config.leftLensCenter / device.lensDistortionValues
    float-array pointers straight into SetShaderValue's void*), the
    HMD-sized RenderTexture and the first-person Camera. So init, the
    stereo scene render, the distortion blit and cleanup live in one
    cpp/raw shim over static state; jank owns the window lifecycle, the
    frame loop, the frame boundaries and DrawFPS."
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/core/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [core] example - vr simulator (jank)")

  ;; Every one of these is created once and used for the whole run, so they
  ;; are plain outer-let locals captured by the frame loop. No cpp/raw
  ;; statics and no boxes: nothing here is ever recreated or has to cross a
  ;; fn boundary.
  (let [dev (cpp/new cpp/VrDeviceInfo)
        _ (do
            ;; Oculus Rift CV1 parameters for the simulator
            (cpp/= (.-hResolution (cpp/* dev)) (cpp/int 2160))
            (cpp/= (.-vResolution (cpp/* dev)) (cpp/int 1200))
            (cpp/= (.-hScreenSize (cpp/* dev)) (cpp/float 0.133793))
            (cpp/= (.-vScreenSize (cpp/* dev)) (cpp/float 0.0669))
            (cpp/= (.-eyeToScreenDistance (cpp/* dev)) (cpp/float 0.041))
            (cpp/= (.-lensSeparationDistance (cpp/* dev)) (cpp/float 0.07))
            (cpp/= (.-interpupillaryDistance (cpp/* dev)) (cpp/float 0.07))
            ;; CV1 lens distortion / chroma approximation
            (doseq [[i v] (map-indexed vector [1.0 0.22 0.24 0.0])]
              (cpp/= (cpp/aget (.-lensDistortionValues (cpp/* dev)) (cpp/int i)) (cpp/float v)))
            (doseq [[i v] (map-indexed vector [0.996 -0.004 1.014 0.0])]
              (cpp/= (cpp/aget (.-chromaAbCorrection (cpp/* dev)) (cpp/int i)) (cpp/float v)))
            nil)
        config (cpp/LoadVrStereoConfig (cpp/* dev))
        distortion (cpp/LoadShader cpp/nullptr (str RES "shaders/glsl330/distortion.fs"))
        ;; the lens/scale params are already float[2] and float[4] members,
        ;; so they pass straight to SetShaderValue's const void*
        _ (do
            (cpp/SetShaderValue distortion
                                (cpp/GetShaderLocation distortion "leftLensCenter")
                                (.-leftLensCenter config) cpp/SHADER_UNIFORM_VEC2)
            (cpp/SetShaderValue distortion
                                (cpp/GetShaderLocation distortion "rightLensCenter")
                                (.-rightLensCenter config) cpp/SHADER_UNIFORM_VEC2)
            (cpp/SetShaderValue distortion
                                (cpp/GetShaderLocation distortion "leftScreenCenter")
                                (.-leftScreenCenter config) cpp/SHADER_UNIFORM_VEC2)
            (cpp/SetShaderValue distortion
                                (cpp/GetShaderLocation distortion "rightScreenCenter")
                                (.-rightScreenCenter config) cpp/SHADER_UNIFORM_VEC2)
            (cpp/SetShaderValue distortion
                                (cpp/GetShaderLocation distortion "scale")
                                (.-scale config) cpp/SHADER_UNIFORM_VEC2)
            (cpp/SetShaderValue distortion
                                (cpp/GetShaderLocation distortion "scaleIn")
                                (.-scaleIn config) cpp/SHADER_UNIFORM_VEC2)
            (cpp/SetShaderValue distortion
                                (cpp/GetShaderLocation distortion "deviceWarpParam")
                                (.-lensDistortionValues (cpp/* dev)) cpp/SHADER_UNIFORM_VEC4)
            (cpp/SetShaderValue distortion
                                (cpp/GetShaderLocation distortion "chromaAbParam")
                                (.-chromaAbCorrection (cpp/* dev)) cpp/SHADER_UNIFORM_VEC4)
            nil)
        ;; HMD-sized framebuffer for the stereo render
        target (cpp/LoadRenderTexture (.-hResolution (cpp/* dev)) (.-vResolution (cpp/* dev)))
        camera (cpp/Camera3D (cpp/Vector3 (cpp/float 5.0) (cpp/float 2.0) (cpp/float 5.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 2.0) (cpp/float 0.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 60.0)
                             cpp/CAMERA_PERSPECTIVE)]

    (cpp/DisableCursor)
    (cpp/SetTargetFPS 60)

    (loop []
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/UpdateCamera (cpp/& camera) cpp/CAMERA_FIRST_PERSON)

        ;; render the scene twice, one eye each, into the HMD framebuffer
        (cpp/BeginTextureMode target)
        (cpp/ClearBackground cpp/RAYWHITE)
        (cpp/BeginVrStereoMode config)
        (cpp/BeginMode3D camera)
        (cpp/DrawCube (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                      (cpp/float 2.0) (cpp/float 2.0) (cpp/float 2.0) cpp/RED)
        (cpp/DrawCubeWires (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                           (cpp/float 2.0) (cpp/float 2.0) (cpp/float 2.0) cpp/MAROON)
        (cpp/DrawGrid 40 (cpp/float 1.0))
        (cpp/EndMode3D)
        (cpp/EndVrStereoMode)
        (cpp/EndTextureMode)

        (cpp/BeginDrawing)
        (cpp/ClearBackground cpp/RAYWHITE)
        ;; warp the stereo framebuffer onto the window; source height is
        ;; negative because render textures are stored upside down
        (cpp/BeginShaderMode distortion)
        (cpp/DrawTexturePro (.-texture target)
                            (cpp/Rectangle (cpp/float 0.0) (cpp/float 0.0)
                                           (cpp/float (+ 0.0 (.-width (.-texture target))))
                                           (cpp/float (- 0.0 (+ 0.0 (.-height (.-texture target))))))
                            (cpp/Rectangle (cpp/float 0.0) (cpp/float 0.0)
                                           (cpp/float (+ 0.0 (cpp/GetScreenWidth)))
                                           (cpp/float (+ 0.0 (cpp/GetScreenHeight))))
                            (cpp/Vector2 (cpp/float 0.0) (cpp/float 0.0))
                            (cpp/float 0.0) cpp/WHITE)
        (cpp/EndShaderMode)
        (cpp/DrawFPS 10 10)
        (cpp/EndDrawing)
        (recur)))

    (cpp/UnloadVrStereoConfig config)
    (cpp/UnloadRenderTexture target)
    (cpp/UnloadShader distortion))

  (cpp/CloseWindow))
