(ns raylib-examples.bone-socket
  "raylib [models] example - bone socket, ported to jank.

  The greenman character with equipment attached to skeleton BONES:
  a hat, sword and shield ride named socket bones through every
  animation frame. T/G switch animations, F/H rotate the character,
  1/2/3 toggle the hat/sword/shield. Third-person camera. ESC quits.
  Based on raylib/examples/models/models_bone_socket.c

  jank-native notes:
  - Bone lookup by name walks skeleton.bones[] with cpp/TextIsEqual and
    returns an int. The per-socket quaternion math (animation-frame bone
    rotation against bind pose, then translate plus the character
    transform) is jank, with the Model, equipment and animation array
    all passed boxed.
  - Equip visibility is three jank bools threaded through recur.
  - The C updates the animation twice per frame (once in update, once
    after setting the transform) - kept."
  (:include "raylib.h" "raymath.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/models/resources/")

(defn- find-bone
  "Index of the named bone, or -1. Takes the model BOXED, since a Model
  cannot arrive as a bare jank fn argument."
  [m-box name]
  (let [m (cpp/unbox (:* cpp/Model) m-box)
        n (int (+ 0.0 (.-boneCount (.-skeleton (cpp/* m)))))]
    (loop [i 0]
      (if (>= i n)
        -1
        (if (cpp/TextIsEqual (.-name (cpp/aget (.-bones (.-skeleton (cpp/* m))) (cpp/int i)))
                             name)
          i
          (recur (inc i)))))))

(defn- draw-socket-equip!
  "The C's socket math: the bone's rotation delta against the bind pose,
  translated to its animated position, then into character space.

  Everything native arrives boxed. Called once per attachment, which is
  why this is a fn rather than three inlined copies."
  [char-box equip-box anims-box anim-idx frame bone-idx]
  (let [ch (cpp/* (cpp/unbox (:* cpp/Model) char-box))
        eq (cpp/* (cpp/unbox (:* cpp/Model) equip-box))
        anims (cpp/unbox (:* cpp/ModelAnimation) anims-box)
        pose (cpp/aget (.-keyframePoses (cpp/aget anims (cpp/int (int anim-idx))))
                       (cpp/int (int frame)))
        tr (cpp/aget pose (cpp/int (int bone-idx)))
        in-rot (.-rotation (cpp/aget (.-bindPose (.-skeleton ch)) (cpp/int (int bone-idx))))
        rotate (cpp/QuaternionMultiply (.-rotation tr) (cpp/QuaternionInvert in-rot))
        mt (cpp/MatrixMultiply
            (cpp/MatrixMultiply (cpp/QuaternionToMatrix rotate)
                                (cpp/MatrixTranslate (.-x (.-translation tr))
                                                     (.-y (.-translation tr))
                                                     (.-z (.-translation tr))))
            (.-transform ch))]
    (cpp/DrawMesh (cpp/aget (.-meshes eq) (cpp/int 0))
                  (cpp/aget (.-materials eq) (cpp/int 1))
                  mt))
  nil)

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [models] example - bone socket (jank)")

  (let [camera (cpp/Camera3D (cpp/Vector3 (cpp/float 5.0) (cpp/float 5.0) (cpp/float 5.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 2.0) (cpp/float 0.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 45.0)
                             cpp/CAMERA_PERSPECTIVE)
        character (cpp/LoadModel (str RES "models/gltf/greenman.glb"))
        hat (cpp/LoadModel (str RES "models/gltf/greenman_hat.glb"))
        sword (cpp/LoadModel (str RES "models/gltf/greenman_sword.glb"))
        shield (cpp/LoadModel (str RES "models/gltf/greenman_shield.glb"))
        ;; count via an int* out-param; the array lives in this let
        anim-n (cpp/int 0)
        anims (cpp/LoadModelAnimations (str RES "models/gltf/greenman.glb") (cpp/& anim-n))
        anims-box (cpp/box anims)
        anim-count (int (+ 0.0 anim-n))
        char-box (cpp/box (cpp/new cpp/Model character))
        bone-hat (find-bone char-box "socket_hat")
        bone-hand-r (find-bone char-box "socket_hand_R")
        bone-hand-l (find-bone char-box "socket_hand_L")]

    (cpp/DisableCursor)
    (cpp/SetTargetFPS 60)

    ;; Thread [anim-index frame angle-degrees hat? sword? shield?].
    (loop [anim-index 0
           frame 0
           angle 0
           hat? true
           sword? true
           shield? true]
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/UpdateCamera (cpp/& camera) cpp/CAMERA_THIRD_PERSON)

        (let [angle (cond (cpp/IsKeyDown cpp/KEY_F) (int (mod (inc angle) 360))
                          (cpp/IsKeyDown cpp/KEY_H) (int (mod (+ 360 (dec angle)) 360))
                          :else angle)
              anim-index (cond (cpp/IsKeyPressed cpp/KEY_T)
                               (int (mod (inc anim-index) anim-count))
                               (cpp/IsKeyPressed cpp/KEY_G)
                               (int (mod (+ anim-index (dec anim-count)) anim-count))
                               :else anim-index)
              hat? (if (cpp/IsKeyPressed cpp/KEY_ONE) (not hat?) hat?)
              sword? (if (cpp/IsKeyPressed cpp/KEY_TWO) (not sword?) sword?)
              shield? (if (cpp/IsKeyPressed cpp/KEY_THREE) (not shield?) shield?)
              frame (int (mod (inc frame)
                              (int (+ 0.0 (.-keyframeCount (cpp/aget anims (cpp/int (int anim-index))))))))]

          (cpp/UpdateModelAnimation character (cpp/aget anims (cpp/int (int anim-index)))
                                    (cpp/float (+ 0.0 (int frame))))

          (cpp/BeginDrawing)
          (cpp/ClearBackground cpp/RAYWHITE)

          (cpp/BeginMode3D camera)

          ;; the character, rotated then re-animated (the C's double update)
          (cpp/= (.-transform character)
                 (cpp/MatrixMultiply
                  (cpp/QuaternionToMatrix
                   (cpp/QuaternionFromAxisAngle
                    (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                    (cpp/float (* (+ 0.0 angle) cpp/DEG2RAD))))
                  (cpp/MatrixTranslate (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))))
          (cpp/UpdateModelAnimation character (cpp/aget anims (cpp/int (int anim-index)))
                                    (cpp/float (+ 0.0 (int frame))))
          (cpp/DrawMesh (cpp/aget (.-meshes character) (cpp/int 0))
                        (cpp/aget (.-materials character) (cpp/int 1))
                        (.-transform character))

          ;; equipment riding the socket bones
          (when hat?
            (draw-socket-equip! char-box (cpp/box (cpp/new cpp/Model hat))
                                anims-box anim-index frame bone-hat))
          (when sword?
            (draw-socket-equip! char-box (cpp/box (cpp/new cpp/Model sword))
                                anims-box anim-index frame bone-hand-r))
          (when shield?
            (draw-socket-equip! char-box (cpp/box (cpp/new cpp/Model shield))
                                anims-box anim-index frame bone-hand-l))

          (cpp/DrawGrid 10 (cpp/float 1.0))
          (cpp/EndMode3D)

          (cpp/DrawText "Use the T/G to switch animation" 10 10 20 cpp/GRAY)
          (cpp/DrawText "Use the F/H to rotate character left/right" 10 35 20 cpp/GRAY)
          (cpp/DrawText "Use the 1,2,3 to toggle shown of hat, sword and shield" 10 60 20 cpp/GRAY)

          (cpp/EndDrawing)
          (recur anim-index frame angle hat? sword? shield?))))

    (cpp/UnloadModel character)
    (cpp/UnloadModel hat)
    (cpp/UnloadModel sword)
    (cpp/UnloadModel shield))

  (cpp/CloseWindow))
