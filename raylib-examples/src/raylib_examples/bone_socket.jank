(ns raylib-examples.bone-socket
  "raylib [models] example - bone socket, ported to jank.

  The greenman character with equipment attached to skeleton BONES:
  a hat, sword and shield ride named socket bones through every
  animation frame. T/G switch animations, F/H rotate the character,
  1/2/3 toggle the hat/sword/shield. Third-person camera. ESC quits.
  Based on raylib/examples/models/models_bone_socket.c

  jank-native notes:
  - Bone lookup by name (the TextIsEqual loop over skeleton.bones[])
    is an int-returning shim; the per-socket quaternion math
    (animation-frame bone rotation vs bind pose, then translate +
    character transform) stays a verbatim shim ending in DrawMesh.
  - The character's own rotate+translate transform set and its
    meshes[0]/materials[1] DrawMesh are small shims; equip visibility
    is three jank bools threaded through recur.
  - The C updates the animation twice per frame (once in update, once
    after setting the transform) - kept."
  (:include "raylib.h" "raymath.h"))

(cpp/raw "static ModelAnimation *jank_anims = NULL;
static int jank_anims_count = 0;
static int jank_load_anims(const char* path) {
  jank_anims = LoadModelAnimations(path, &jank_anims_count);
  return jank_anims_count;
}
static int jank_anim_keyframes(int i) { return jank_anims[i].keyframeCount; }
static void jank_update_anim(Model m, int i, int frame) {
  UpdateModelAnimation(m, jank_anims[i], (float)frame);
}
/* find a bone index by name (-1 when absent) */
static int jank_find_bone(Model* m, const char* name) {
  for (int i = 0; i < m->skeleton.boneCount; i++)
    if (TextIsEqual(m->skeleton.bones[i].name, name)) return i;
  return -1;
}
/* rotate the character around Y and park the matrix in its transform */
static void jank_set_character_transform(Model* m, double angleDeg) {
  Quaternion rotate = QuaternionFromAxisAngle((Vector3){ 0.0f, 1.0f, 0.0f },
                                              (float)angleDeg*DEG2RAD);
  m->transform = MatrixMultiply(QuaternionToMatrix(rotate), MatrixTranslate(0, 0, 0));
}
static void jank_draw_character(Model m) {
  DrawMesh(m.meshes[0], m.materials[1], m.transform);
}
/* the C's socket math, verbatim: bone rotation delta vs bind pose,
   translated to the bone's animated position, in character space */
static void jank_draw_socket_equip(Model character, Model equip,
                                   int animIdx, int frame, int boneIdx) {
  Transform *transform = &jank_anims[animIdx].keyframePoses[frame][boneIdx];
  Quaternion inRotation = character.skeleton.bindPose[boneIdx].rotation;
  Quaternion outRotation = transform->rotation;
  Quaternion rotate = QuaternionMultiply(outRotation, QuaternionInvert(inRotation));
  Matrix matrixTransform = QuaternionToMatrix(rotate);
  matrixTransform = MatrixMultiply(matrixTransform,
                                   MatrixTranslate(transform->translation.x,
                                                   transform->translation.y,
                                                   transform->translation.z));
  matrixTransform = MatrixMultiply(matrixTransform, character.transform);
  DrawMesh(equip.meshes[0], equip.materials[1], matrixTransform);
}")

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/models/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [models] example - bone socket (jank)")

  (let [camera (cpp/Camera3D (cpp/Vector3 (cpp/float 5.0) (cpp/float 5.0) (cpp/float 5.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 2.0) (cpp/float 0.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 45.0)
                             cpp/CAMERA_PERSPECTIVE)
        character (cpp/LoadModel (str RES "models/gltf/greenman.glb"))
        hat (cpp/LoadModel (str RES "models/gltf/greenman_hat.glb"))
        sword (cpp/LoadModel (str RES "models/gltf/greenman_sword.glb"))
        shield (cpp/LoadModel (str RES "models/gltf/greenman_shield.glb"))
        anim-count (int (cpp/jank_load_anims (str RES "models/gltf/greenman.glb")))
        bone-hat (int (cpp/jank_find_bone (cpp/& character) "socket_hat"))
        bone-hand-r (int (cpp/jank_find_bone (cpp/& character) "socket_hand_R"))
        bone-hand-l (int (cpp/jank_find_bone (cpp/& character) "socket_hand_L"))]

    (cpp/DisableCursor)
    (cpp/SetTargetFPS 60)

    ;; Thread [anim-index frame angle-degrees hat? sword? shield?].
    (loop [anim-index 0
           frame 0
           angle 0
           hat? true
           sword? true
           shield? true]
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/UpdateCamera (cpp/& camera) cpp/CAMERA_THIRD_PERSON)

        (let [angle (cond (cpp/IsKeyDown cpp/KEY_F) (int (mod (inc angle) 360))
                          (cpp/IsKeyDown cpp/KEY_H) (int (mod (+ 360 (dec angle)) 360))
                          :else angle)
              anim-index (cond (cpp/IsKeyPressed cpp/KEY_T)
                               (int (mod (inc anim-index) anim-count))
                               (cpp/IsKeyPressed cpp/KEY_G)
                               (int (mod (+ anim-index (dec anim-count)) anim-count))
                               :else anim-index)
              hat? (if (cpp/IsKeyPressed cpp/KEY_ONE) (not hat?) hat?)
              sword? (if (cpp/IsKeyPressed cpp/KEY_TWO) (not sword?) sword?)
              shield? (if (cpp/IsKeyPressed cpp/KEY_THREE) (not shield?) shield?)
              frame (int (mod (inc frame)
                              (int (cpp/jank_anim_keyframes (int anim-index)))))]

          (cpp/jank_update_anim character (int anim-index) (int frame))

          (cpp/BeginDrawing)
          (cpp/ClearBackground cpp/RAYWHITE)

          (cpp/BeginMode3D camera)

          ;; the character, rotated then re-animated (the C's double update)
          (cpp/jank_set_character_transform (cpp/& character) (+ 0.0 angle))
          (cpp/jank_update_anim character (int anim-index) (int frame))
          (cpp/jank_draw_character character)

          ;; equipment riding the socket bones
          (when hat?
            (cpp/jank_draw_socket_equip character hat (int anim-index) (int frame) bone-hat))
          (when sword?
            (cpp/jank_draw_socket_equip character sword (int anim-index) (int frame) bone-hand-r))
          (when shield?
            (cpp/jank_draw_socket_equip character shield (int anim-index) (int frame) bone-hand-l))

          (cpp/DrawGrid 10 (cpp/float 1.0))
          (cpp/EndMode3D)

          (cpp/DrawText "Use the T/G to switch animation" 10 10 20 cpp/GRAY)
          (cpp/DrawText "Use the F/H to rotate character left/right" 10 35 20 cpp/GRAY)
          (cpp/DrawText "Use the 1,2,3 to toggle shown of hat, sword and shield" 10 60 20 cpp/GRAY)

          (cpp/EndDrawing)
          (recur anim-index frame angle hat? sword? shield?))))

    (cpp/UnloadModel character)
    (cpp/UnloadModel hat)
    (cpp/UnloadModel sword)
    (cpp/UnloadModel shield))

  (cpp/CloseWindow))
