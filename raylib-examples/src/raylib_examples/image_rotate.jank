(ns raylib-examples.image-rotate
  "raylib [textures] example - image rotate, ported to jank.

  The raylib logo loaded three times and each copy rotated in CPU
  memory (+45, +90, -90 degrees) before becoming a texture. LEFT click
  or RIGHT arrow cycles between them. Q quits.
  Based on raylib/examples/textures/textures_image_rotate.c

  jank-native: ImageRotate takes an Image* - formed with (cpp/& img) on
  each mutable let-local. The three textures can't live in a jank
  collection (native values), so they are three outer-let locals and the
  current one is picked by index with nested `if` forms."
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/textures/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [textures] example - image rotate (jank)")
  (cpp/SetTargetFPS 60)

  (let [im45 (cpp/LoadImage (str RES "raylib_logo.png"))
        im90 (cpp/LoadImage (str RES "raylib_logo.png"))
        imN90 (cpp/LoadImage (str RES "raylib_logo.png"))]
    (cpp/ImageRotate (cpp/& im45) 45)
    (cpp/ImageRotate (cpp/& im90) 90)
    (cpp/ImageRotate (cpp/& imN90) -90)

    (let [t0 (cpp/LoadTextureFromImage im45)
          t1 (cpp/LoadTextureFromImage im90)
          t2 (cpp/LoadTextureFromImage imN90)]
      (cpp/UnloadImage im45)
      (cpp/UnloadImage im90)
      (cpp/UnloadImage imN90)

      ;; loop state: which texture is showing (0..2).
      (loop [cur 0]
        (when (cpp/! (cpp/WindowShouldClose))
          (let [cur (if (or (cpp/IsMouseButtonPressed cpp/MOUSE_BUTTON_LEFT)
                            (cpp/IsKeyPressed cpp/KEY_RIGHT))
                      (mod (+ cur 1) 3)
                      cur)]

            (cpp/BeginDrawing)
            (cpp/ClearBackground cpp/RAYWHITE)

            ;; draw the current texture centred (each is a different size)
            (if (= cur 0)
              (let [w (int (+ 0.0 (.-width t0))) h (int (+ 0.0 (.-height t0)))]
                (cpp/DrawTexture t0 (- (int (/ WIDTH 2)) (int (/ w 2))) (- (int (/ HEIGHT 2)) (int (/ h 2))) cpp/WHITE))
              (if (= cur 1)
                (let [w (int (+ 0.0 (.-width t1))) h (int (+ 0.0 (.-height t1)))]
                  (cpp/DrawTexture t1 (- (int (/ WIDTH 2)) (int (/ w 2))) (- (int (/ HEIGHT 2)) (int (/ h 2))) cpp/WHITE))
                (let [w (int (+ 0.0 (.-width t2))) h (int (+ 0.0 (.-height t2)))]
                  (cpp/DrawTexture t2 (- (int (/ WIDTH 2)) (int (/ w 2))) (- (int (/ HEIGHT 2)) (int (/ h 2))) cpp/WHITE))))

            (cpp/DrawText "Press LEFT MOUSE BUTTON or RIGHT to rotate the image (Q quits)" 220 420 10 cpp/DARKGRAY)

            (cpp/EndDrawing)

            (when-not (cpp/IsKeyDown cpp/KEY_Q)
              (recur cur)))))

      (cpp/UnloadTexture t0)
      (cpp/UnloadTexture t1)
      (cpp/UnloadTexture t2)))

  (cpp/CloseWindow))
