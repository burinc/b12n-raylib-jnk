(ns raylib-examples.loading-gltf
  "raylib [models] example - loading gltf, ported to jank.

  The animated glTF robot: LEFT/RIGHT switch between its animations
  (idle, walk, dance, ...) with the current one's name on screen,
  orbital camera. ESC quits.
  Based on raylib/examples/models/models_loading_gltf.c

  jank-native notes:
  - LoadModelAnimations returns the array and writes its count through
    an int* out-param; both bind in the outer let, so nothing has to
    live in a static. Plus one addition: the animation's char[32] name field folds to a jank
    string through a const-char*-returning accessor.
  - The animation index and frame counter thread as jank ints; the
    frame wraps by the CURRENT animation's keyframe count."
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/models/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [models] example - loading gltf (jank)")

  (let [camera (cpp/Camera3D (cpp/Vector3 (cpp/float 6.0) (cpp/float 6.0) (cpp/float 6.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 2.0) (cpp/float 0.0))
                             (cpp/Vector3 (cpp/float 0.0) (cpp/float 1.0) (cpp/float 0.0))
                             (cpp/float 45.0)
                             cpp/CAMERA_PERSPECTIVE)
        model (cpp/LoadModel (str RES "models/gltf/robot.glb"))
        ;; LoadModelAnimations writes the count through an int* out-param and
        ;; returns the array. Both live in this outer let and are captured by
        ;; the frame loop, so no cpp/raw static is needed to hold them.
        anim-n (cpp/int 0)
        anims (cpp/LoadModelAnimations (str RES "models/gltf/robot.glb") (cpp/& anim-n))
        anim-count (int (+ 0.0 anim-n))]

    (cpp/SetTargetFPS 60)

    ;; Thread [animation-index animation-frame].
    (loop [anim-index 0
           anim-frame 0]
      (when (cpp/! (cpp/WindowShouldClose))
        (cpp/UpdateCamera (cpp/& camera) cpp/CAMERA_ORBITAL)

        (let [anim-index (cond (cpp/IsKeyPressed cpp/KEY_RIGHT)
                               (int (mod (inc anim-index) anim-count))
                               (cpp/IsKeyPressed cpp/KEY_LEFT)
                               (int (mod (+ anim-index (dec anim-count)) anim-count))
                               :else anim-index)
              anim-frame (int (mod (inc anim-frame)
                                   (int (+ 0.0 (.-keyframeCount (cpp/aget anims (cpp/int (int anim-index))))))))]

          (cpp/UpdateModelAnimation model (cpp/aget anims (cpp/int (int anim-index)))
                                    (cpp/float (+ 0.0 (int anim-frame))))

          (cpp/BeginDrawing)
          (cpp/ClearBackground cpp/RAYWHITE)

          (cpp/BeginMode3D camera)
          (cpp/DrawModel model
                         (cpp/Vector3 (cpp/float 0.0) (cpp/float 0.0) (cpp/float 0.0))
                         (cpp/float 1.0) cpp/WHITE)
          (cpp/DrawGrid 10 (cpp/float 1.0))
          (cpp/EndMode3D)

          (cpp/DrawText (str "Current animation: " (str (.-name (cpp/aget anims (cpp/int (int anim-index))))))
                        10 40 20 cpp/MAROON)
          (cpp/DrawText "Use the LEFT/RIGHT keys to switch animation" 10 10 20 cpp/GRAY)

          (cpp/EndDrawing)
          (recur anim-index anim-frame))))

    (cpp/UnloadModel model))

  (cpp/CloseWindow))
