(ns raylib-examples.texture-waves
  "raylib [shaders] example - texture waves, ported to jank.

  A space texture rippled by a sine-wave fragment shader driven by a
  'seconds' uniform that advances with frame time - the waves animate
  continuously. ESC quits.
  Based on raylib/examples/shaders/shaders_texture_waves.c

  jank-native notes:
  - Third shader port: seven float uniforms plus a vec2, each a plain
    SetShaderValue over cpp/new. Nothing is shared between calls, so
    they are free to live anywhere rather than being confined to -main. The 'seconds' uniform updates every frame from
    a jank real accumulated with GetFrameTime."
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/shaders/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [shaders] example - texture waves (jank)")

  (let [texture (cpp/LoadTexture (str RES "space.png"))
        tw (int (+ 0.0 (.-width texture)))
        shader (cpp/LoadShader cpp/nullptr (str RES "shaders/glsl330/wave.fs"))
        seconds-loc (int (cpp/GetShaderLocation shader "seconds"))
        size-loc (int (cpp/GetShaderLocation shader "size"))
        freq-x-loc (int (cpp/GetShaderLocation shader "freqX"))
        freq-y-loc (int (cpp/GetShaderLocation shader "freqY"))
        amp-x-loc (int (cpp/GetShaderLocation shader "ampX"))
        amp-y-loc (int (cpp/GetShaderLocation shader "ampY"))
        speed-x-loc (int (cpp/GetShaderLocation shader "speedX"))
        speed-y-loc (int (cpp/GetShaderLocation shader "speedY"))]

    ;; constant uniforms (each staged then sent, one at a time)
    (cpp/SetShaderValue shader (int size-loc)
                        (cpp/new cpp/Vector2 (cpp/float 800.0) (cpp/float 450.0))
                        cpp/SHADER_UNIFORM_VEC2)
    (loop [i 0]
      (when (< i 6)
        (cpp/SetShaderValue shader
                            (int (nth [freq-x-loc freq-y-loc amp-x-loc amp-y-loc speed-x-loc speed-y-loc] i))
                            (cpp/new cpp/float (cpp/float (nth [25.0 25.0 5.0 5.0 8.0 8.0] i)))
                            cpp/SHADER_UNIFORM_FLOAT)
        (recur (inc i))))

    (cpp/SetTargetFPS 60)

    ;; Thread [elapsed-seconds].
    (loop [seconds 0.0]
      (when (cpp/! (cpp/WindowShouldClose))
        (let [seconds (+ seconds (+ 0.0 (cpp/GetFrameTime)))]

          (cpp/SetShaderValue shader (int seconds-loc)
                              (cpp/new cpp/float (cpp/float seconds)) cpp/SHADER_UNIFORM_FLOAT)

          (cpp/BeginDrawing)
          (cpp/ClearBackground cpp/RAYWHITE)

          (cpp/BeginShaderMode shader)
          (cpp/DrawTexture texture 0 0 cpp/WHITE)
          (cpp/DrawTexture texture tw 0 cpp/WHITE)
          (cpp/EndShaderMode)

          (cpp/EndDrawing)

          (recur seconds))))

    (cpp/UnloadShader shader)
    (cpp/UnloadTexture texture))

  (cpp/CloseWindow))
