(ns raylib-examples.raw-data
  "raylib [textures] example - raw data, ported to jank.

  Two textures built without a normal image file: the fudesumi sprite
  loaded from a headerless 384x512 RGBA .raw pixel dump with
  LoadImageRaw, and a checkerboard generated by code. Q quits. Fudesumi
  sprite by Eiden Marsal.
  Based on raylib/examples/textures/textures_raw_data.c

  jank-native note: the C original hand-fills a MemAlloc'd `Color*`
  buffer and wraps it in an Image struct literal (`.data = pixels`) for
  the checkerboard. That raw-buffer path (cpp/MemAlloc + cpp/cast + aset
  into a Color* + an Image struct ctor) is a deeper interop exercise not
  yet proven in this repo, so the checkerboard here is produced by
  GenImageChecked - visually identical (32x32 ORANGE/GOLD cells). The
  LoadImageRaw half - the actual 'raw data' headline - is faithful."
  (:include "raylib.h"))

(def WIDTH 800)
(def HEIGHT 450)
(def RES "../jank-raylib-sys/raylib/examples/textures/resources/")

(defn -main [& args]
  (cpp/SetConfigFlags cpp/FLAG_WINDOW_HIGHDPI) ;; scale on HiDPI monitors
  (cpp/InitWindow WIDTH HEIGHT "raylib [textures] example - raw data (jank)")
  (cpp/SetTargetFPS 60)

  (let [fud-raw (cpp/LoadImageRaw (str RES "fudesumi.raw") 384 512 cpp/PIXELFORMAT_UNCOMPRESSED_R8G8B8A8 0)
        fudesumi (cpp/LoadTextureFromImage fud-raw)]
    (cpp/UnloadImage fud-raw)

    (let [checked-im (cpp/GenImageChecked 960 480 32 32 cpp/ORANGE cpp/GOLD)
          checked (cpp/LoadTextureFromImage checked-im)
          cw (int (+ 0.0 (.-width checked)))
          ch (int (+ 0.0 (.-height checked)))]
      (cpp/UnloadImage checked-im)

      (loop []
        (when (cpp/! (cpp/WindowShouldClose))
          (cpp/BeginDrawing)
          (cpp/ClearBackground cpp/RAYWHITE)

          (cpp/DrawTexture checked (- (int (/ WIDTH 2)) (int (/ cw 2)))
                           (- (int (/ HEIGHT 2)) (int (/ ch 2))) (cpp/Fade cpp/WHITE (cpp/float 0.5)))
          (cpp/DrawTexture fudesumi 430 -30 cpp/WHITE)

          (cpp/DrawText "CHECKED TEXTURE " 84 85 30 cpp/BROWN)
          (cpp/DrawText "GENERATED by CODE" 72 148 30 cpp/BROWN)
          (cpp/DrawText "and RAW IMAGE LOADING" 46 210 30 cpp/BROWN)
          (cpp/DrawText "(c) Fudesumi sprite by Eiden Marsal - Q quits" 250 (- HEIGHT 20) 10 cpp/BROWN)

          (cpp/EndDrawing)

          (when-not (cpp/IsKeyDown cpp/KEY_Q)
            (recur))))

      (cpp/UnloadTexture checked)
      (cpp/UnloadTexture fudesumi)))

  (cpp/CloseWindow))
