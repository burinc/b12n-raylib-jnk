{:driver  :spawn
 :capture :cgevent-gif

 :examples-cmd "bb demos:examples"

 ;; lein must run from the examples project, not the repo root.
 :cwd "raylib-examples"

 :out-dir "docs/demos"
 :ledger  "docs/demos/ledger.edn"
 :readme  "docs/demos/README.md"
 :title   "Examples"
 :preamble "Animated GIF previews of every example. Recorded with a capture CLI that is not publicly released, so `bb record` is maintainer-only - every GIF here is committed."

 ;; Eight examples will not compile with a Homebrew raylib linked, so the
 ;; batch unlinks it and relinks afterward via :after-all, which runs on both
 ;; the normal and exception paths.
 ;;
 ;; Ctrl-C is NOT covered synchronously. Measured under babashka, neither a JVM
 ;; shutdown hook nor a signal handler reliably runs a subprocess on SIGINT.
 ;; screen-grab instead writes a pending-teardown marker before the batch and
 ;; repairs it on the NEXT invocation - so if you interrupt a run, raylib stays
 ;; unlinked until you either rerun screen-grab or run `brew link raylib`
 ;; yourself. `brew link` is idempotent, so both firing is harmless.
 ;;
 ;; --app jank targeting is ambiguous whenever more than one jank process
 ;; exists, and destroy-tree only reaches the lein/java parent this script
 ;; spawns, not the jank grandchild that owns the window. Hence the kill
 ;; before AND after every item.
 :hooks {:before-all  ["brew unlink raylib"]
         :after-all   ["brew link raylib"]
         :before-each ["pkill -9 -x jank || true"]
         :after-each  ["pkill -9 -x jank || true"]}

 ;; Read from bb/helpers.clj's cat-order on 2026-08-14, preserving its
 ;; order. The old write-readme! used the pair's title verbatim as the
 ;; heading, so these carry the full "name - blurb" form.
 :groups [{:key "core"     :title "core: window, input, cameras, files"}
          {:key "shapes"   :title "shapes: 2D drawing, easing, rlgl"}
          {:key "text"     :title "text: fonts, unicode, layout"}
          {:key "textures" :title "textures: images, sprites, render textures"}
          {:key "models"   :title "models: meshes, 3D, OBJ/GLB"}
          {:key "shaders"  :title "shaders: GLSL, uniforms, postprocess, lighting"}
          {:key "audio"    :title "audio: sounds, music streams"}]

 :defaults {:duration 6 :fps 10 :width 480 :warmup 10
            ;; Every example runs as a process named `jank`: lein spawns
            ;; java, which spawns the jank binary, so the pid we spawn owns
            ;; no window.
            :target {:app "jank"}
            ;; Poll by taking a real screenshot rather than by counting
            ;; windows. A jank process can own a window for seconds before it
            ;; renders - first-ever compile of an example is much slower than a
            ;; cached rebuild - and a count-based check returns true for a
            ;; window that is still blank, yielding a valid GIF of nothing.
            ;; This restores what the recorder replaced by screen-grab did.
            :ready-probe true}

 ;; Per-id overrides. These bump :warmup past the default 10s: the
 ;; examples listed here render correctly (confirmed via manual `lein
 ;; run` + cgevent screenshot) but wait-for-window's poll loop
 ;; intermittently loses the race against cgevent's window-capture
 ;; readiness under batch-run conditions - a longer warmup gives the
 ;; poll loop more attempts to land a good frame before giving up. This
 ;; is accurate again now that :defaults sets :ready-probe true: the poll
 ;; loop screenshots the window and checks for real pixel content, so
 ;; extra warmup time genuinely buys more chances at a non-blank frame.
 ;; Without :ready-probe, a longer :warmup buys nothing - a count-based
 ;; check returns true for a window that is still blank on its very
 ;; first poll - so :warmup and :ready-probe only do useful work
 ;; together; neither is sufficient on its own. One (waving-cubes) never
 ;; recovered even at :warmup 60 across 3 isolated retries and remains a
 ;; known recording gap - see the "record GIFs for 203/208 examples" and
 ;; "add preview column" commit messages for the full triage
 ;; (docs/demos/README.md itself is regenerated wholesale by
 ;; write-readme! on every run, so it can't carry hand-written notes).
 ;;
 ;; RESTORED. The screen-grab migration briefly dropped these to `{}` because
 ;; its brief wrongly claimed this manifest shipped an empty :overrides map -
 ;; a stale comment inside the old record_all.clj said so, written when the
 ;; script was first ported and never updated after these were added two
 ;; commits later. They are real triage output, not defaults: each was raised
 ;; from the 10s default after an example was observed failing to open its
 ;; window in time under batch-run load.
 :overrides
 {"collision-area"      {:warmup 25}
  "math-sine-cosine"    {:warmup 40}
  "pie-chart"           {:warmup 25}
  "rlgl-color-wheel"    {:warmup 25}
  "top-down-lights"     {:warmup 25}
  "rectangle-advanced"  {:warmup 25}
  "fog-of-war"          {:warmup 60}
  "billboard-rendering" {:warmup 25}
  "waving-cubes"        {:warmup 60}
  "tiled-drawing"       {:warmup 25}
  "cellular-automata"   {:warmup 60}
  "textured-curve"      {:warmup 25}
  "undo-redo"           {:warmup 25}
  "text-file-loading"   {:warmup 25}
  "spotlight-rendering" {:warmup 25}
  "game-of-life"        {:warmup 25}}}
