;; bb.edn — build and run the b12n-raylib-jnk raylib examples with Babashka.
;;
;;   bb info              grouped cheat-sheet of everything (start here)
;;   bb examples          list the runnable raylib examples
;;   bb <name>            run one example, e.g. `bb starfield`
;;   bb run <name>        same, by argument (e.g. `bb run starfield`)
;;   bb install           install jank-raylib-sys into ~/.m2
;;   bb clean             remove */target build dirs
;;
;; Library install is idempotent and happens automatically the first time
;; you run something that needs it. Override the leiningen binary with
;; the LEIN env var if the one on PATH can't bootstrap.
;;
;; EDN note: task bodies are parsed by babashka's EDN reader — no #"regex",
;; @deref, or #(...) reader macros here. Logic lives in bb/helpers.clj.
{:min-bb-version "1.3.0"
 :paths ["bb"]
 :tasks
 {:requires ([helpers :as h])

  ;; --- discovery ---
  info {:doc "Grouped cheat-sheet of all bb tasks (easier to scan than the flat `bb tasks`)"
        :task (h/print-info)}

  examples {:doc "List the runnable jank raylib examples"
            :task (h/print-examples)}

  run {:doc "Run an example by name: bb run <name>"
       :override-builtin true
       :task (if-let [name (first *command-line-args*)]
               (h/run-example! name)
               (h/print-examples))}

